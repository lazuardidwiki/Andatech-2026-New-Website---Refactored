f","button_jVhjTx"],"settings":{"text_position":"justify-center","text_align":"text-center","mob_center_text":true,"wide":true,"color_scheme":"none","full_width":true,"prevent_animation":false}},"featured_collection_BzKqqh":{"type":"featured-collection","settings":{"title":"See our Range","heading_align":"text-start","show_view_all":true,"collection":"drug-test-kits","layout":"carousel","card_size_mobile":"small","card_size":"small","products_to_show":8,"show_highlight_products":true,"show_promo_info":true,"image":"shopify:\/\/shop_images\/OraScan_3000_urine_drug_test_dock.webp","image_ratio":"fill","promo_title":"Error-free multi-drug analyser","content":"<p>Record, print & store up to 10,000 drug test results from urine, saliva & surface residue, along with photographic evidence. <\/p>","link_url":"shopify:\/\/products\/drugsense-orascan-3000-drug-test-analyser","button_label":"Learn more about the OraScan 3000","color_scheme":"3","button_style":"btn btn--primary"}},"faq_VHkndM":{"type":"faq","blocks":{"question_BfGdT8":{"type":"question","settings":{"icon":"none","heading":"Does Andatech work with police forces?","text":"<p>Yes, Andatech has more than a decade's experience supplying substance screening solutions to police forces around the world.<\/p><p>Our products are Australian Standards certified and verified, ensuring accuracy and reliability. We have solutions to meet all legislative requirements and operational preferences. <br\/><br\/><a href=\"\/pages\/talk-to-sales\" target=\"_blank\" title=\"Talk to Sales\">Contact us for more information<\/a>.<\/p>"}},"question_Yewe4E":{"type":"question","settings":{"icon":"none","heading":"Do Andatech solutions meet Australian Standards?","text":"<p>Andatech’s products are designed to meet rigorous Australian Standards, ensuring top-quality performance and safety. <\/p><p>Our devices undergo thorough testing and certification to comply with national best practices, giving you confidence in their reliability and adherence to local requirements. <\/p><p>For more details, please refer to the product specifications or <a href=\"\/pages\/talk-to-sales\" target=\"_blank\" title=\"Talk to Sales\">contact our team<\/a>.<\/p>"}},"question_nVyimA":{"type":"question","settings":{"icon":"none","heading":"How are Andatech breathalysers maintained?","text":"<p>Andatech's breathalysers should be calibrated regularly to ensure ongoing accuracy. <\/p><p>We recommend calibration at least every 6 or 12 months, or more regularly when units are used heavily. Our knowledgeable staff can help develop a calibration schedule that makes sense for your specific needs.<\/p><p>We offer calibration management plans and one-off service are available. <a href=\"\/pages\/calibration-and-servicing\" target=\"_blank\" title=\"Calibration and Servicing\">Learn more about calibrations here<\/a>.<\/p>"}},"question_89UkRB":{"type":"question","settings":{"icon":"none","heading":"Does Andatech offer bulk pricing?","text":"<p>For clients needing large volumes of breathalysers and drug testing solutions, Andatech may be able to offer bulk pricing.<\/p><p><a href=\"\/pages\/talk-to-sales\" target=\"_blank\" title=\"Talk to Sales\">To discuss your specific needs, connect with our knowledgeable staff<\/a>.<\/p>"}}},"block_order":["question_BfGdT8","question_Yewe4E","question_nVyimA","question_89UkRB"],"settings":{"heading":"Frequently Asked Questions","heading_align":"text-center","color_scheme":"1","full_width":true}},"featured_blog_qJKHaW":{"type":"featured-blog","settings":{"title":"Read the latest about Alcohol and Drug Safety","heading_align":"text-start","show_view_all":true,"blog":"resources","layout":"carousel","posts_to_show":4,"show_featured_image":true,"show_tags":false,"show_excerpt":true,"show_author":false,"show_date":true,"show_button":false,"color_scheme":"none","image_ratio":"shortest","button_style":"btn btn--primary"}}},"order":["main","media_with_text_kh4LYn","featured_product_Me8tcF","featured_product_