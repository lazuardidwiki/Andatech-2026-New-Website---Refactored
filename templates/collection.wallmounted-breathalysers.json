{"sections":{"collection-banner":{"type":"main-collection-banner","custom_css":["h2 {font-size: 25px; margin-bottom: 2%;}"],"settings":{"show_collection_title":true,"show_product_count":false,"show_collection_description":true,"text_align":"items-center text-center","collection_image":"none","use_product_image":false,"text_width":"wide","color_scheme":"default"}},"rich_text_JQ7daP":{"type":"rich-text","blocks":{"subheading_neUgXV":{"type":"subheading","disabled":true,"settings":{"text":"Subheading"}},"heading_y7ykcQ":{"type":"heading","settings":{"heading":"Wall Mounted Breathalysers","heading_size":"h2","heading_h1":false}},"text_iXBJpV":{"type":"text","disabled":true,"settings":{"text":"<p>Share information about your store with your customers. Describe a product, share announcements, or welcome customers to your store.<\/p>","enlarge_text":true}},"button_hrBV68":{"type":"button","disabled":true,"settings":{"button_1_label":"Optional button","button_1_link":"","button_1_style":"btn--primary","button_2_label":"Optional button","button_2_link":"","button_2_style":"btn btn--primary"}}},"block_order":["subheading_neUgXV","heading_y7ykcQ","text_iXBJpV","button_hrBV68"],"disabled":true,"settings":{"text_position":"justify-center","text_align":"text-center","mob_center_text":true,"color_scheme":"none","full_width":true,"prevent_animation":false}},"featured_product_Lr9njr":{"type":"featured-product","blocks":{"title_EHiMFn":{"type":"title","settings":{"show_weight":false}},"description_hzM6U8":{"type":"description","settings":{"show_as_collapsible_content":false,"text":"<p>Employee safety made easy.<br\/><br\/>Andatech's Soberlive FRX Wall-Mounted Breathalyser adapts to the unique needs of your business. With cloud-based data management and many software integrations available, our team caters the experience to support your precise needs:<\/p><ul><li><strong>Real-Time Safety Monitoring:<\/strong> Reduce the risk of alcohol-related incidents in the workplace.<\/li><li><strong>Customisable Software Integrations:<\/strong> Seamlessly integrates with your existing systems for streamlined data management.<\/li><li><strong>Cloud-Based Data Management:<\/strong> Conveniently and securely manage test results from anywhere.<\/li><li><strong>Tailored Support:<\/strong> Our dedicated team to ensure a smooth and effective implementation process for your business.<\/li><li><strong>Comprehensive Training:<\/strong> Be empowered by comprehensive training and ongoing support to maximise the benefits.<\/li><\/ul>","icon":"none","open":false}},"price_C86zgz":{"type":"price","disabled":true,"settings":{"show_tax_and_shipping":false}},"variant_picker_JK9L4W":{"type":"variant-picker","settings":{"selector_style":"buttons","enable_dynamic_availability":true,"show_backorder_text":true,"enable_size_chart":false,"size_chart_variant":"Size","size_chart_page":""}},"buy_buttons_WzfMwr":{"type":"buy-buttons","disabled":true,"settings":{"show_qty_selector":true,"enable_dynamic_checkout":true,"show_gift_card_recipient":false}},"view_more_button_CBmwxq":{"type":"view-more-button","settings":{"button_label":"Request a quote","text_align":"text-start"}}},"block_order":["title_EHiMFn","description_hzM6U8","price_C86zgz","variant_picker_JK9L4W","buy_buttons_WzfMwr","view_more_button_CBmwxq"],"settings":{"product":"andatech-soberlive-frx-breathalyser","media_ratio":"natural","media_crop":"none","media_width":50,"enable_video_looping":false,"hover_zoom":"large","color_scheme":"none","border_color":"rgba(0,0,0,0)","bg_color":"#f4f4f4"}},"icons_with_text_HiiPgV":{"type":"icons-with-text","blocks":{"item_XtwHwN":{"type":"item","settings":{"icon":"award","custom_icon":"shopify:\/\/shop_images\/Andatech-NATA-Accredited-Logo-_for-Caltrace.png","heading":"NATA accredited organisation","text":"","link":""}},"item_JxTRjM":{"type":"item","settings":{"icon":"truck","custom_icon":"shopify:\/\/shop_images\/certified-1637037846275.webp","heading":"Australian Standard AS3547 Certified","text":"","link":""}},"item_L3tfkb":{"type":"item","settings":{"icon":"price_tag","custom_icon":"shopify:\/\/shop_images\/stars-icon.webp","heading":"Extended Guarantee with regular calibrations","text":"","link":"shopify:\/\/pages\/guarantee"}},"item_fFjBVL":{"type":"item","settings":{"icon":"award","custom_icon":"shopify:\/\/shop_images\/fast-icon_7307c58b-7737-40c6-a10a-def3c34b8dd2.webp","heading":"Fast, accurate alcohol testing with advanced features","text":"","link":""}},"item_tAAWQp":{"type":"item","disabled":true,"settings":{"icon":"return","custom_icon":"shopify:\/\/shop_images\/truck-icon.webp","heading":"Ships the next business day","text":"","link":""}}},"block_order":["item_XtwHwN","item_JxTRjM","item_L3tfkb","item_fFjBVL","item_tAAWQp"],"custom_css":["div {padding-top: 1%; padding-bottom: 1%;}"],"settings":{"heading":"","heading_align":"text-start","icon_size":80,"title_type_scale":"medium","text_type_scale":"medium","icon_position":"beside","mobile_stack":false,"section_height":"medium","color_scheme":"1","full_width":true,"dividers":"none","prevent_animation":false}},"collection-products":{"type":"main-collection-products","blocks":{"wide_promotion_C9Dkt9":{"type":"wide-promotion","settings":{"position":"bottom","view":"grid_list","hide_on_filter":true,"min_height":250,"image":"shopify:\/\/shop_images\/Soberlive-FRX-Facial-Recognition-Breathalyser-web.jpg","link_url":"shopify:\/\/pages\/talk-to-sales","content":"<h3>Quick breathalyser screening for your employees<\/h3><p>Accurate & reliable wall-mounted breathalysers for breath alcohol screening at entrances, according to your company's alcohol & drug testing policy.<\/p><p><\/p>","text_type_scale":"--h6-font-size","text_width":700,"text_alignment":"justify-center items-center text-center","button_label":"Get corporate pricing","button_style":"btn btn--secondary","text_color":"#ffffff","tint_color":"#000000","tint_opacity":40}}},"block_order":["wide_promotion_C9Dkt9"],"custom_css":["h3 {font-size: 25px;}"],"settings":{"products_per_page":16,"card_size_mobile":"small","card_size":"medium","show_layout_toggle":true,"enable_filtering":true,"filters_open_lg":true,"stick_on_scroll":true,"show_filter_counts":true,"expand_filters":true,"max_filter_options":7,"enable_sorting":true,"sort_first":true}},"faq_frRfPW":{"type":"faq","blocks":{"question_pWBkPK":{"type":"question","settings":{"icon":"none","heading":"Are wall-mounted breathalysers better than portable ones?","text":"<p>Wall-mounted breathalysers have features that are unique to them and the same can be said about <a href=\"https:\/\/andatech.com.au\/collections\/portable-breathalysers\" target=\"_blank\" title=\"Andatech portable breathalysers\">portable breathalysers<\/a>.<\/p><p>Wall-mounted breathalysers from Andatech have advanced features including door access<br\/>control, temperature screening and a link to the <a href=\"https:\/\/andatech.com.au\/pages\/andalink\" target=\"_blank\" title=\"Andalink data management system\">Andalink<\/a> data management system.<\/p>"}},"question_BJMeeN":{"type":"question","settings":{"icon":"none","heading":"Does Andatech install wall-mounted breathalysers on-site?","text":"<p>Andatech wall-mounted breathalysers are easy to install and comes with detailed instructions. Andatech does not install wall-mounted breathalysers on-site.<\/p>"}},"question_zcqbgf":{"type":"question","settings":{"icon":"none","heading":"Do wall-mounted breathalysers need to be calibrated?","text":"<p>Wall-mounted breathalysers also require calibration like any<br\/>other breathalyser. Andatech offers <a href=\"https:\/\/andatech.com.au\/collections\/breathalyser-calibrations\" target=\"_blank\" title=\"Breathalyser calibration plans\">calibration plans<\/a> for users to save on calibration costs and avoid downtime (Gold calibration plan and above).<\/p><p>Check out Andatech’s <a href=\"https:\/\/andatech.com.au\/products\/calibration-plan-andatech-wallmounted\" target=\"_blank\" title=\"Andatech wall-mounted breathalyser calibrations\">wall-mounted breathalyser calibration plans<\/a> for more information.<\/p>"}},"question_H4K8TV":{"type":"question","settings":{"icon":"none","heading":"How often should I calibrate my breathalyser?","text":"<p>Your breathalyser should be calibrated every six months to ensure accurate readings at all times. This applies to both personal units and workplace units, as this level of frequency is also recommended by Australian Standards guidelines.<\/p>"}}},"block_order":["question_pWBkPK","question_BJMeeN","question_zcqbgf","question_H4K8TV"],"settings":{"heading":"Breathalyser FAQs","heading_align":"text-center","color_scheme":"1","full_width":false}}},"order":["collection-banner","rich_text_JQ7daP","featured_product_Lr9njr","icons_with_text_HiiPgV","collection-products","faq_frRfPW"]}