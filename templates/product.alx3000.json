disabled":true,"settings":{"heading":"Dual mode testing","text":"<p>Use specific mode testing with a mouthpiece to get readings up to 3 decimal places in g\/210L, or use passive mode testing with a sampling cup for fast \"Alcohol Detected\" or \"No Alcohol Detected\" results.<\/p>","content_align":"text-start","hotspot_x":34,"hotspot_y":23}},"feature_NXnH9N":{"type":"feature","settings":{"heading":"Discreet design","text":"<p>Compact and easily concealable.<\/p>","content_align":"text-start","hotspot_x":70,"hotspot_y":42}},"feature_DG7f9h":{"type":"feature","settings":{"heading":"Test again while driving","text":"<p>Optional feature of rolling retest, to ensure no alcohol is consumed after the first successful test, is available. <\/p>","content_align":"text-start","hotspot_x":85,"hotspot_y":66}},"feature_R3UFBT":{"type":"feature","disabled":true,"settings":{"heading":"Reduce errors","text":"<p>Clean air test ensures the mouthpiece and sensor are clear of alcohol from any previous tests.<\/p>","content_align":"text-start","hotspot_x":33,"hotspot_y":67}}},"block_order":["feature_aE3rjT","feature_mFH8GF","feature_NXnH9N","feature_DG7f9h","feature_R3UFBT"],"settings":{"product":"","show_content":false,"layout":"text_first","text_align":"text-center","mob_center_text":false,"heading_size":"h3","enlarge_text":false,"image":"shopify:\/\/shop_images\/andatech_alx3000_interlock_breathalyser_features.webp","title":"Record comprehensive details with every breath test","description":"<p> <\/p>","button_label":"","button_link":"","hotspot_color":"#f4f4f4","color_scheme":"none","button_style":"btn btn--primary"}},"icons_with_text_LLTkxK":{"type":"icons-with-text","blocks":{"item_EktGDf":{"type":"item","repeater":"{{ product.metafields.custom.image_description.value }}","settings":{"icon":"award","custom_icon":"{{ block.repeater.image_1.value }}","heading":"{{ block.repeater.heading_1.value }}","text":"{{ block.repeater.description_1 | metafield_tag }}","link":""}}},"block_order"