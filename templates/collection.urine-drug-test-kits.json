one","prevent_animation":false}},"collection-products":{"type":"main-collection-products","blocks":{"wide_promotion_C9Dkt9":{"type":"wide-promotion","settings":{"position":"bottom","view":"grid_list","hide_on_filter":true,"min_height":250,"image":"shopify:\/\/shop_images\/drug_test_kits.jpg","link_url":"shopify:\/\/pages\/talk-to-sales","content":"<h3>Comprehensive urine drug screening for your employees<\/h3><p>Accurate & reliable drug test kits for on-site urine drug screening. According to your company's alcohol & drug testing policy.<\/p><p><\/p>","text_type_scale":"--h6-font-size","text_width":740,"text_alignment":"justify-center items-center text-center","button_label":"Get corporate pricing","button_style":"btn btn--secondary","text_color":"#ffffff","tint_color":"#000000","tint_opacity":60}}},"block_order":["wide_promotion_C9Dkt9"],"custom_css":["h3 {font-size: 24px;}"],"settings":{"products_per_page":16,"card_size_mobile":"small","card_size":"medium","show_layout_toggle":true,"enable_filtering":true,"filters_open_lg":true,"stick_on_scroll":true,"show_filter_counts":true,"expand_filters":true,"max_filter_options":7,"enable_sorting":true,"sort_first":true}},"faq_PTwTeJ":{"type":"faq","blocks":{"question_LAMxgH":{"type":"question","settings":{"icon":"question_mark","heading":"What are urine drug test kits used for?","text":"<p>These tools are screening tools used to detect the presence of drugs and their metabolites in urine samples.<\/p>"}},"question_XwgQCe":{"type":"question","settings":{"icon":"question_mark","heading":"How accurate are DrugSense urine testing kits?","text":"<p>DrugSense drug test kits are a reliable solution for urine drug screening as they comply with cut-off limits specified by Australian Standards.<\/p><p>To understand more, read '<a href=\"https:\/\/andatech.com.au\/blogs\/resources\/cut-off-levels-for-drug-test-kits\" target=\"_blank\" title=\"Cut-off levels for drug test kits in Australia\">Cut-off levels for drug test kits in Australia<\/a>'<\/p>"}},"question_jn6PER":{"type":"question","settings":{"icon":"question_mark","heading":"How long do drugs stay detectable in urine?","text":"<p>Depending on the frequency of use, DrugSense urine testing kits can detect drug metabolites up to 30 days after use.<\/p><p>For a full breakdown and explanation of how long drugs stay in one's system, read '<a href=\"https:\/\/andatech.com.au\/blogs\/resources\/how-long-do-drugs-stay-in-your-system\" target=\"_blank\" title=\"How long do drugs stay in your system?\">How long do drugs stay in your system?<\/a>'<\/p>"}},"question_zFXpb3":{"type":"question","settings":{"icon":"question_mark","heading":"What drugs can these drug test kits detect?","text":"<p>Up to 15 major illegal drug groups can be detected through a single test including marijuana, MDMA, opiates, amphetamines, methamphetamines, cocaine, barbiturates, ketamine, and more.<\/p>"}},"question_gmRD43":{"type":"question","settings":{"icon":"question_mark","heading":"Can I use these testing kits at home?","text":"<p>Yes, our drug test kits can also be used as a home test kit for personal monitoring or for peace of mind prior to an upcoming scheduled test.<\/p>"}},"question_nQyijm":{"type":"question","settings":{"icon":"question_mark","heading":"How do I read the results of a urine drug test kit?","text":"<p>Urine drug screening kits from Andatech use a panel system where the presence or absence of lines indicate whether a specific drug is detected in a person's urine sample. This works similar to a pregnancy test.<\/p><p><\/p>"}},"question_L6UXEk":{"type":"question","settings":{"icon":"question_mark","heading":"How long does it take for results to become visible?","text":"<p>Our urine drug screening kits provide readings in as fast as <strong>5 minutes<\/strong> once the urine sample has been collected.<\/p>"}},"question_EJrewV":{"type":"question","settings":{"icon":"question_mark","heading":"Are urine drug test kits legal in Australia?","text":"<p>Yes, urine drug test kits are legal in Australia and are frequently used in workplace settings, medical settings, and government agencies to ensure safety and compliance.<\/p><p>However, in workplace settings, employees have a right to decline a test. Consult your organisation's <a href=\"https:\/\/andatech.com.au\/pages\/consultation\" target=\"_blank\" title=\"Free drug and alcohol testing policy consultation\">drug and alcohol testing policy<\/a> for more information.<\/p>"}}},"block_order":["question_LAMxgH","question_XwgQCe","question_jn6PER","question_zFXpb3","question_gmRD43","question_nQyijm","question_L6UXEk","question_EJrewV"],"settings":{"heading":"Urine drug screening kits FAQs","heading_align":"text-center","color_scheme":"none","full_width":true}}},"order":["collection-banner","rich_text_fPRGCW","featured_product_rmghRN","icons_with_text_HiiPgV","collection-products","faq_PTwTeJ"]}