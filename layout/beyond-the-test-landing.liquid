<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#F4F6F8">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%}
    A fallback is used rather than a bare `if`, because with only the `if` the
    entire meta description tag disappears whenever no SEO description is set
    on the page in Shopify admin — and an absent description is what SEO
    scanners report as "missing meta description". Google then invents a
    snippet from page text instead of using ours.

    Setting a proper description in admin (Online Store > Pages > Beyond The
    Test > Edit website SEO) still takes precedence and is the better fix;
    this only guarantees the tag can never be absent.
  {%- endcomment -%}
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- else -%}
    <meta name="description" content="Practical guidance, compliance tools and expert advice for Australian workplace drug and alcohol testing programs.">
  {%- endif -%}

  <title>{{ page_title }}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;600;700;900&display=swap" rel="stylesheet">

  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-P4WPHJP');</script>
  <!-- End Google Tag Manager -->

  <!-- HubSpot — deferred until the visitor actually interacts.

       The tag loads HubSpot's tracking script and chat widget, which then
       pull in a large amount of further JavaScript. Even with async+defer the
       browser still fetches, parses, compiles and executes all of it during
       the page's busiest period, competing with first render.

       Safe to delay here because NEITHER form on this page depends on it:
       the Resource Library gate and the Get Expert Help form both POST
       directly to api.hsforms.com/submissions/v3 via fetch(), which needs no
       HubSpot script present.

       Deliberate interactions only — pointerdown / touchstart / keydown.
       `scroll` and `mousemove` are intentionally NOT triggers: firing a heavy
       script load the instant someone starts scrolling is what we are trying
       to avoid. Visitors who never interact still get it via the idle
       fallback, so tracking is delayed but never lost. -->
  <script>
    (function(){
      var EVENTS = ['pointerdown', 'touchstart', 'keydown'];
      var loaded = false;

      function loadHubSpot(){
        if (loaded) return;
        loaded = true;
        for (var i = 0; i < EVENTS.length; i++){
          window.removeEventListener(EVENTS[i], loadHubSpot);
        }
        var s = document.createElement('script');
        s.type = 'text/javascript';
        s.id = 'hs-script-loader';
        s.async = true;
        s.defer = true;
        s.src = 'https://js-ap1.hs-scripts.com/7005767.js';
        document.head.appendChild(s);
      }

      for (var i = 0; i < EVENTS.length; i++){
        window.addEventListener(EVENTS[i], loadHubSpot, { passive: true });
      }

      // Fallback for a visitor who only ever scrolls. requestIdleCallback
      // lands the load in a gap between frames instead of mid-scroll.
      window.addEventListener('load', function(){
        setTimeout(function(){
          if (window.requestIdleCallback) requestIdleCallback(loadHubSpot, { timeout: 4000 });
          else loadHubSpot();
        }, 5000);
      });
    })();
  </script>

  {% render 'meta-tags' %}
  {%- render 'doc-head-core' -%}
  {%- render 'doc-head-social' -%}

  <link rel="preload" href="{{ 'main.css' | asset_url }}" as="style">
  <link rel="stylesheet" href="{{ 'main.css' | asset_url }}">
  <script src="{{ 'main.js' | asset_url }}" defer="defer"></script>

  {%- style %}
    {{- settings.body_font | font_face: font_display: 'swap' -}}
    {{- body_font_bold | font_face: font_display: 'swap' -}}
    {{- body_font_italic | font_face: font_display: 'swap' -}}
    {{- body_font_bold_italic | font_face: font_display: 'swap' -}}
    {{- settings.heading_font | font_face: font_display: 'swap' -}}
  {%- endstyle %}

  {%- unless settings.body_font.system? -%}
    <link rel="preload" href="{{ settings.body_font | font_url }}" as="font" type="font/woff2" crossorigin fetchpriority="high">
  {%- endunless -%}
  {%- unless settings.heading_font.system? -%}
    <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin fetchpriority="high">
  {%- endunless -%}

  {{ content_for_header }}

  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer" data-contact="{{ shop.email | escape }}"></script>
  {%- endif -%}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
  </script>

  {%- if settings.custom_html_head -%}
    {{- settings.custom_html_head -}}
  {%- endif -%}

  {{ 'beyond-the-test-preloader.css' | asset_url | stylesheet_tag }}
  {{ 'beyond-the-test-industries.css' | asset_url | stylesheet_tag }}
  {{ 'beyond-the-test-assessment.css' | asset_url | stylesheet_tag }}
  {{ 'beyond-the-test-guide03-assessment.css' | asset_url | stylesheet_tag }}
  {{ 'beyond-the-test-resources.css' | asset_url | stylesheet_tag }}
  {{ 'beyond-the-test-knowledge.css' | asset_url | stylesheet_tag }}
  {{ 'beyond-the-test-tools.css' | asset_url | stylesheet_tag }}
  {{ 'beyond-the-test-expert-help.css' | asset_url | stylesheet_tag }}
  {{ 'beyond-the-test-landing.css' | asset_url | stylesheet_tag }}
</head>
