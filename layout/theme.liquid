    document.addEventListener("DOMContentLoaded", () => {
      const dynamicBtn = document.querySelector(".product-info__dynamic-checkout-button button");
      if (!dynamicBtn) return;

      dynamicBtn.addEventListener("click", async (e) => {
        e.preventDefault();
        dynamicBtn.disabled = true;

        try {
          const productId = document.querySelector('[name="id"]').value; // Shopify variant ID
          const quantity = parseInt(document.querySelector('[name="quantity"]').value) || 1;

          // Add product to cart
          const addRes = await fetch("/cart/add.js", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: productId, quantity })
          });
          if (!addRes.ok) throw new Error("Failed to add product");

          // Fetch updated cart (no timeout needed)
          const cartRes = await fetch("/cart.js");
          if (!cartRes.ok) throw new Error("Failed to fetch cart");
          const cart = await cartRes.json();

          // Redirect based on total
          window.location.href = cart.total_price / 100 > 500 ? "/cart" : "/checkout";
        } catch (err) {
          console.error("Error adding product or redirecting:", err);
          window.location.href = "/checkout"; // fallback
        }
      });
    });
    </script> {% endcomment %}

