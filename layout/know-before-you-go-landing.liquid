  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#111820">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- else -%}
    <meta name="description" content="Australia's strict 0.00% BAC limit for P-platers means guesswork can cost a licence. Check your BAC before you drive — plus 10% off personal breathalysers.">
  {%- endif -%}

  <title>{{ page_title }}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600;700;900&display=swap" rel="stylesheet">

  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-P4WPHJP');</script>
  <!-- End Google Tag Manager -->

  <!-- HubSpot — deferred until the visitor interacts, same pattern as Beyond
       The Test. The giveaway form here will need to POST directly to
       api.hsforms.com/submissions/v3 via fetch() rather than depend on this
       script, for the same reason: paid traffic landing on this page
       shouldn't compete with HubSpot's tracking bundle for first render. -->
  <script>
    (function(){
      var EVENTS = ['pointerdown', 'touchstart', 'keydown'];
      var loaded = false;
      function loadHubSpot(){
        if (loaded) return;
        loaded = true;
        for (var i = 0; i < EVENTS.length; i++){ window.removeEventListener(EVENTS[i], loadHubSpot); }
        var s = document.createElement('script');
        s.type = 'text/javascript'; s.id = 'hs-script-loader'; s.async = true; s.defer = true;
        s.src = 'https://js-ap1.hs-scripts.com/7005767.js';
        document.head.appendChild(s);
      }
      for (var i = 0; i < EVENTS.length; i++){ window.addEventListener(EVENTS[i], loadHubSpot, { passive: true }); }
      window.addEventListener('load', function(){
        setTimeout(function(){
          if (window.requestIdleCallback) requestIdleCallback(loadHubSpot, { timeout: 4000 });
          else loadHubSpot();
        }, 5000);
      });
    })();
  </script>

  {% render 'meta-tags' %}
  {%- render 'doc-head-core' -%}
  {%- render 'doc-head-social' -%}

  {{ content_for_header }}

  {{ 'know-before-you-go-base.css' | asset_url | stylesheet_tag }}
