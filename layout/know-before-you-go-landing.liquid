  <script src="{{ 'know-before-you-go-base.js' | asset_url }}" defer="defer"></script>
  <!-- Dot-field temporarily disabled for a loading-feel comparison — uncomment to re-enable.
  <script src="{{ 'know-before-you-go-dotfield.js' | asset_url }}" defer="defer"></script>
