{{ 'andatech-site.css' | asset_url | stylesheet_tag }}
{{ 'andatech-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'andatech-about.js' | asset_url }}" defer="defer"></script>

<section class="at-about-story at-about-section" data-at-about-story{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %}>
  <div class="at-shell at-about-story__intro">
    <div class="at-about-story__copy">
      <header class="at-about-section__header">
        {%- if section.settings.eyebrow != blank -%}<p class="at-about-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="at-about-section__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.description != blank -%}<div class="at-about-section__body">{{ section.settings.description }}</div>{%- endif -%}
      </header>
    </div>

    <div class="at-about-timeline" data-at-about-timeline>
      {%- for block in section.blocks -%}
        <article class="at-about-timeline__item" data-at-about-milestone {{ block.shopify_attributes }}>
          <span class="at-about-timeline__date">{{ block.settings.date | escape }}</span>
          <span class="at-about-timeline__marker" aria-hidden="true"></span>
          <div class="at-about-timeline__card">
            <span class="at-about-timeline__mobile-date">{{ block.settings.date | escape }}</span>
            <h3 class="at-about-timeline__title">{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.body != blank -%}<div class="at-about-timeline__body">{{ block.settings.body }}</div>{%- endif -%}

            {%- if block.settings.media_mode == 'logos' -%}
              {%- assign has_any_logo = false -%}
              {%- if block.settings.logo_1 != blank -%}{%- assign has_any_logo = true -%}{%- endif -%}
              {%- if block.settings.logo_2 != blank -%}{%- assign has_any_logo = true -%}{%- endif -%}
              {%- if block.settings.logo_3 != blank -%}{%- assign has_any_logo = true -%}{%- endif -%}
              {%- if block.settings.logo_4 != blank -%}{%- assign has_any_logo = true -%}{%- endif -%}
              {%- if block.settings.logo_5 != blank -%}{%- assign has_any_logo = true -%}{%- endif -%}

              {%- if has_any_logo -%}
                {%- assign logo_count = 0 -%}
                {%- if block.settings.logo_1 != blank -%}{%- assign logo_count = logo_count | plus: 1 -%}{%- endif -%}
                {%- if block.settings.logo_2 != blank -%}{%- assign logo_count = logo_count | plus: 1 -%}{%- endif -%}
                {%- if block.settings.logo_3 != blank -%}{%- assign logo_count = logo_count | plus: 1 -%}{%- endif -%}
                {%- if block.settings.logo_4 != blank -%}{%- assign logo_count = logo_count | plus: 1 -%}{%- endif -%}
                {%- if block.settings.logo_5 != blank -%}{%- assign logo_count = logo_count | plus: 1 -%}{%- endif -%}
                <div class="at-about-timeline__logos" data-logo-count="{{ logo_count }}">
                  {%- if block.settings.logo_1 != blank -%}
                    {{ block.settings.logo_1 | image_url: width: 400 | image_tag: class: 'at-about-timeline__logo', widths: '120, 200, 400', sizes: '(min-width: 768px) 140px, 100px', loading: 'lazy', alt: block.settings.logo_1_alt | default: block.settings.heading }}
                  {%- endif -%}
                  {%- if block.settings.logo_2 != blank -%}
                    {{ block.settings.logo_2 | image_url: width: 400 | image_tag: class: 'at-about-timeline__logo', widths: '120, 200, 400', sizes: '(min-width: 768px) 140px, 100px', loading: 'lazy', alt: block.settings.logo_2_alt | default: block.settings.heading }}
                  {%- endif -%}
                  {%- if block.settings.logo_3 != blank -%}
                    {{ block.settings.logo_3 | image_url: width: 400 | image_tag: class: 'at-about-timeline__logo', widths: '120, 200, 400', sizes: '(min-width: 768px) 140px, 100px', loading: 'lazy', alt: block.settings.logo_3_alt | default: block.settings.heading }}
                  {%- endif -%}
                  {%- if block.settings.logo_4 != blank -%}
                    {{ block.settings.logo_4 | image_url: width: 400 | image_tag: class: 'at-about-timeline__logo', widths: '120, 200, 400', sizes: '(min-width: 768px) 140px, 100px', loading: 'lazy', alt: block.settings.logo_4_alt | default: block.settings.heading }}
                  {%- endif -%}
                  {%- if block.settings.logo_5 != blank -%}
                    {{ block.settings.logo_5 | image_url: width: 400 | image_tag: class: 'at-about-timeline__logo', widths: '120, 200, 400', sizes: '(min-width: 768px) 140px, 100px', loading: 'lazy', alt: block.settings.logo_5_alt | default: block.settings.heading }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- else -%}
              {%- if block.settings.image != blank -%}
                {%- assign milestone_alt = block.settings.image_alt | default: block.settings.heading -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'at-about-timeline__image', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 1280px) 30vw, (min-width: 768px) 32vw, calc(100vw - 92px)', loading: 'lazy', alt: milestone_alt }}
              {%- endif -%}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About — Story timeline",
  "tag": "section",
  "class": "at-section",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor", "default": "about-story" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "html", "id": "heading", "label": "H2 — Heading", "default": "Story of <strong>Andatech</strong>" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>From a Melbourne garage in 2003 to Australia's leading workplace drug and alcohol testing specialist. Two decades of building safer workplaces, one milestone at a time.</p>" }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        { "type": "text", "id": "date", "label": "Year or date", "default": "2003" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Milestone heading" },
        { "type": "richtext", "id": "body", "label": "Body copy", "default": "<p>Describe what happened and why it mattered.</p>" },
        {
          "type": "select",
          "id": "media_mode",
          "label": "Media type",
          "options": [
            { "value": "photo", "label": "Photo" },
            { "value": "logos", "label": "Logos" }
          ],
          "default": "photo"
        },
        { "type": "header", "content": "Photo mode" },
        { "type": "image_picker", "id": "image", "label": "Supporting image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "header", "content": "Logo mode" },
        { "type": "image_picker", "id": "logo_1", "label": "Logo 1" },
        { "type": "text", "id": "logo_1_alt", "label": "Logo 1 alt text" },
        { "type": "image_picker", "id": "logo_2", "label": "Logo 2" },
        { "type": "text", "id": "logo_2_alt", "label": "Logo 2 alt text" },
        { "type": "image_picker", "id": "logo_3", "label": "Logo 3" },
        { "type": "text", "id": "logo_3_alt", "label": "Logo 3 alt text" },
        { "type": "image_picker", "id": "logo_4", "label": "Logo 4" },
        { "type": "text", "id": "logo_4_alt", "label": "Logo 4 alt text" },
        { "type": "image_picker", "id": "logo_5", "label": "Logo 5" },
        { "type": "text", "id": "logo_5_alt", "label": "Logo 5 alt text" }
      ]
    }
  ],
  "presets": [
    { "name": "About — Story timeline", "blocks": [
      { "type": "milestone", "settings": { "date": "2003 & 2004", "heading": "First retail experience" } },
      { "type": "milestone", "settings": { "date": "2006", "heading": "First expo in Melbourne" } },
      { "type": "milestone", "settings": { "date": "2007", "heading": "First office and warehouse" } }
    ] }
  ]
}
{% endschema %}
