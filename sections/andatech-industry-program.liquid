{%- comment -%} Andatech — Industry testing program. {%- endcomment -%}
{{ 'andatech-site.css' | asset_url | stylesheet_tag }}
{{ 'andatech-industry.css' | asset_url | stylesheet_tag }}

<section class="at-industry at-industry-program" id="{{ section.settings.anchor_id | default: 'industry-solutions' | handleize }}">
  {%- assign eyebrow_tag = section.settings.eyebrow_tag | default: 'h2' -%}
  {%- assign heading_tag = section.settings.heading_tag | default: 'h3' -%}
  <div class="at-shell">
    {%- if section.settings.eyebrow != blank -%}<{{ eyebrow_tag }} class="at-industry__eyebrow" data-at-rise>{{ section.settings.eyebrow | escape }}</{{ eyebrow_tag }}>{%- endif -%}
    <{{ heading_tag }} class="at-industry__title" data-at-rise>{{ section.settings.heading | escape }}{% if section.settings.heading_bold != blank %}<br><strong>{{ section.settings.heading_bold | escape }}</strong>{% endif %}</{{ heading_tag }}>
    <div class="at-industry__control-row">
      {%- if section.settings.desc != blank -%}<div class="at-industry__desc" data-at-rise>{{ section.settings.desc }}</div>{%- endif -%}
      <div class="at-industry-tabs at-industry-tabs--two" role="tablist" aria-label="Testing program categories">
        <button class="at-industry-tabs__button is-active" type="button" role="tab" aria-selected="true" aria-controls="AtProgramSolutions-{{ section.id }}" data-at-tab="solutions">{{ section.settings.tab_1_label | escape }}</button>
        <button class="at-industry-tabs__button" type="button" role="tab" aria-selected="false" aria-controls="AtProgramHelp-{{ section.id }}" data-at-tab="help">{{ section.settings.tab_2_label | escape }}</button>
      </div>
    </div>
    {%- assign panel_names = 'solutions,help' | split: ',' -%}
    {%- for panel_name in panel_names -%}
      {%- assign panel_card_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.tab == panel_name -%}{%- assign panel_card_count = panel_card_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      <div class="at-industry-tabs__panel{% if forloop.first %} is-active{% endif %}" id="AtProgram{% if panel_name == 'solutions' %}Solutions{% else %}Help{% endif %}-{{ section.id }}" role="tabpanel" {% unless forloop.first %}hidden{% endunless %} data-at-panel="{{ panel_name }}">
        <div class="at-program-grid{% if panel_card_count == 3 %} at-program-grid--3{% endif %}">
          {%- for block in section.blocks -%}{%- if block.settings.tab == panel_name -%}
            <article class="at-program-card" data-at-rise {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy">{%- endif -%}
              <div class="at-program-card__overlay" aria-hidden="true"></div>
              <div class="at-program-card__content">
                {%- assign block_title_tag = block.settings.title_tag | default: 'h4' -%}
                {%- if block.settings.kicker != blank -%}<span>{{ block.settings.kicker | escape }}</span>{%- endif -%}
                <{{ block_title_tag }}>{{ block.settings.title | escape }}</{{ block_title_tag }}>
                {%- if block.settings.desc != blank -%}<div>{{ block.settings.desc }}</div>{%- endif -%}
                {%- if block.settings.link_label != blank -%}<a href="{{ block.settings.link_url | default: '#' }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{%- endif -%}
              </div>
            </article>
          {%- endif -%}{%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('{{ section.settings.anchor_id | default: 'industry-solutions' | handleize }}');
  if (!root || root.dataset.tabsReady) return;
  root.dataset.tabsReady = 'true';
  var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-at-tab]'));
  var panels = Array.prototype.slice.call(root.querySelectorAll('[data-at-panel]'));
  tabs.forEach(function (tab) { tab.addEventListener('click', function () {
    tabs.forEach(function (item) { var active = item === tab; item.classList.toggle('is-active', active); item.setAttribute('aria-selected', String(active)); });
    panels.forEach(function (panel) { var active = panel.dataset.atPanel === tab.dataset.atTab; panel.hidden = !active; panel.classList.toggle('is-active', active); });
  }); });
})();
</script>

{% schema %}
{
  "name": "Industry Testing Program",
  "tag": "section",
  "class": "at-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor", "default": "industry-solutions" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Solutions & Testing" },
    {
      "type": "select",
      "id": "eyebrow_tag",
      "label": "Eyebrow HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ],
      "default": "h2"
    },
    { "type": "text", "id": "heading", "label": "Heading (light)", "default": "The Industry" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ],
      "default": "h3"
    },
    { "type": "text", "id": "heading_bold", "label": "Heading (bold)", "default": "Testing Program" },
    { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Bring recommended solutions and testing programs together around the way your workforce and sites operate.</p>" },
    { "type": "text", "id": "tab_1_label", "label": "Tab 1 label", "default": "Industry Testing Programs" },
    { "type": "text", "id": "tab_2_label", "label": "Tab 2 label", "default": "How Andatech Helps" }
  ],
  "blocks": [{ "type": "card", "name": "Program card", "limit": 18, "settings": [
    { "type": "select", "id": "tab", "label": "Tab", "options": [{ "value": "solutions", "label": "Industry Testing Programs" }, { "value": "help", "label": "How Andatech Helps" }], "default": "solutions" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Small label" },
    { "type": "text", "id": "title", "label": "Title", "default": "Prodigy S" },
    {
      "type": "select",
      "id": "title_tag",
      "label": "Title HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ],
      "default": "h4"
    },
    { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Combine workplace breath alcohol and drug testing equipment in one site-ready starter pack.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ] }],
  "presets": [{ "name": "Industry Testing Program", "blocks": [
    { "type": "card", "settings": { "title": "Prodigy S", "desc": "<p>Combine workplace breath alcohol and drug testing equipment in one site-ready starter pack.</p>" } },
    { "type": "card", "settings": { "title": "Remote Monitoring", "desc": "<p>Support alcohol testing for workers who begin shifts away from a central location.</p>" } },
    { "type": "card", "settings": { "title": "Drug Testing Kits", "desc": "<p>Select workplace screening kits for the required sample type and testing procedure.</p>" } },
    { "type": "card", "settings": { "tab": "help", "title": "Policy Development", "desc": "<p>Define scope, testing triggers, responsibilities and outcomes before implementation.</p>" } },
    { "type": "card", "settings": { "tab": "help", "title": "Supervisor Training", "desc": "<p>Prepare supervisors to identify concerns and follow the approved response process.</p>" } },
    { "type": "card", "settings": { "tab": "help", "title": "Calibration & Compliance Software", "desc": "<p>Maintain device readiness and keep testing records visible across sites.</p>" } }
  ] }]
}
{% endschema %}
