{%- comment -%}
  Andatech — Hero
  Ported from the Phase 1 prototype. All classes are `at-` prefixed and styled by
  andatech-site.css, which is generated by Nexus/scripts/to-theme.mjs.

  Images come from Content → Files via the image_picker settings below —
  merchant-managed content, not theme-bundled art. Nothing renders for an image
  until one is picked, which is the expected Shopify behaviour.
{%- endcomment -%}

{{ 'andatech-site.css' | asset_url | stylesheet_tag }}
{{ 'andatech-hero.css' | asset_url | stylesheet_tag }}
{%- if section.settings.visual_asset != blank -%}{{ 'andatech-solutions-pages.css' | asset_url | stylesheet_tag }}{%- endif -%}
<script src="{{ 'andatech-site.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign desktop_visual = section.settings.visual_desktop
  assign mobile_visual  = section.settings.visual_mobile
  assign certs          = section.settings.certs_image
  assign heading_tag    = section.settings.heading_tag | default: 'h1'
  assign heading_markup = section.settings.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>'
-%}

<section class="at-hero{% if section.settings.visual_asset != blank %} at-hero--bundled-visual{% endif %}" id="{{ section.settings.anchor_id | default: section.id | handleize }}">
  <div class="at-hero__visual">
    {%- if desktop_visual != blank -%}
      <picture>
        {%- if mobile_visual != blank -%}
          <source media="(max-width: 1279px) and (orientation: portrait)" srcset="{{ mobile_visual | image_url: width: 1400 }}">
        {%- endif -%}
        <img src="{{ desktop_visual | image_url: width: 3456 }}"
             alt="{{ desktop_visual.alt | default: section.settings.visual_alt | escape }}"
             width="{{ desktop_visual.width }}" height="{{ desktop_visual.height }}"
             loading="eager" fetchpriority="high">
      </picture>
    {%- elsif section.settings.visual_asset != blank -%}
      <img src="{{ section.settings.visual_asset | asset_img_url: '1920x' }}"
           srcset="{{ section.settings.visual_asset | asset_img_url: '960x' }} 960w, {{ section.settings.visual_asset | asset_img_url: '1440x' }} 1440w, {{ section.settings.visual_asset | asset_img_url: '1920x' }} 1920w"
           sizes="100vw"
           alt="{{ section.settings.visual_alt | escape }}"
           width="1920" height="1080" loading="eager" fetchpriority="high">
    {%- endif -%}
  </div>

  <div class="at-shell at-hero__inner">
    <div class="at-hero__content">

      {%- if section.settings.eyebrow != blank -%}
        {%- assign eyebrow_tag = section.settings.eyebrow_tag | default: 'p' -%}
        <{{ eyebrow_tag }} class="at-label-tag" data-at-rise>{{ section.settings.eyebrow | escape }}</{{ eyebrow_tag }}>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="at-hero__subheading" data-at-rise>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="at-hero__title"><span data-at-rise>{{ heading_markup }}</span></{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="at-hero__body" data-at-rise>{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.cta1_label != blank or section.settings.cta2_label != blank -%}
        <div class="at-hero__cta" data-at-rise>
          {%- if section.settings.cta1_label != blank -%}
            <a class="at-btn at-btn--green" href="{{ section.settings.cta1_link | default: '#' }}">
              {{ section.settings.cta1_label | escape }}
              <i class="at-btn__arrow" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="m10 5.5 6.5 6.5-6.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </i>
            </a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="at-btn at-btn--outline-dark" href="{{ section.settings.cta2_link | default: '#' }}"{% if section.settings.cta2_label contains 'Find Your Device' %} data-at-device-open{% endif %}>
              {{ section.settings.cta2_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.trust_line != blank -%}
        <p class="at-hero__trust" data-at-rise>{{ section.settings.trust_line | escape }}</p>
      {%- endif -%}

      {%- if certs != blank -%}
        <img class="at-hero__certs" src="{{ certs | image_url: width: 678 }}"
             alt="{{ certs.alt | default: section.settings.certs_alt | escape }}"
             width="{{ certs.width }}" height="{{ certs.height }}" loading="lazy" data-at-rise>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Andatech Hero",
  "tag": "section",
  "class": "at-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor",
      "info": "Used by the industry topic navigation. Leave unchanged unless the matching navigation link is updated."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Managed Compliance Programs"
    },
    {
      "type": "select",
      "id": "eyebrow_tag",
      "label": "Eyebrow HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ],
      "default": "p"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading below eyebrow",
      "info": "Optional. Useful for industry or service categories; leave blank to preserve the homepage layout."
    },
    {
      "type": "header",
      "content": "Page title"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Title",
      "info": "Use Bold to apply Andatech green. Add line breaks where needed; otherwise the title wraps naturally within the hero width.",
      "default": "<p>We run your workplace<br>compliance program.<br><strong>Devices included.</strong></p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Testing devices, NATA-accredited calibration, reporting, training and audit readiness. Delivered as one managed program, or buy the equipment outright and run it yourself.</p>"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line",
      "default": "Andatech is Australia's leading drug and alcohol testing specialist since 2003."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Primary button label",
      "default": "Explore Managed Programs"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label",
      "default": "Find Your Device",
      "info": "🔒 Keep this exactly as \"Find Your Device\" to open the Device Finder overlay. Change the label only if you want this button to become a normal link."
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary button link",
      "info": "⚠ Ignored while the label above is \"Find Your Device\" — the button opens the Device Finder overlay instead. Fill this in only if you rename the button."
    },
    {
      "type": "header",
      "content": "Imagery"
    },
    {
      "type": "image_picker",
      "id": "visual_desktop",
      "label": "Hero visual — desktop",
      "info": "Full-bleed cutout anchored to the bottom of the section."
    },
    {
      "type": "image_picker",
      "id": "visual_mobile",
      "label": "Hero visual — mobile",
      "info": "Tighter crop of the crew, shown below 768px. Above that the desktop image is used."
    },
    {
      "type": "text",
      "id": "visual_asset",
      "label": "Bundled visual fallback",
      "info": "Optional theme asset filename. Used only when no desktop Shopify image is selected."
    },
    {
      "type": "text",
      "id": "visual_alt",
      "label": "Hero visual alt text",
      "default": "Two workers in hi-vis conducting an on-site compliance check"
    },
    {
      "type": "image_picker",
      "id": "certs_image",
      "label": "Accreditation strip",
      "info": "The accreditation logo strip shown under the trust line."
    },
    {
      "type": "text",
      "id": "certs_alt",
      "label": "Accreditation strip alt text",
      "default": "ISO 27001, ILAC-MRA, NATA, ISO 9001 and AS 3547 accreditations"
    }
  ],
  "presets": [
    {
      "name": "Andatech Hero"
    }
  ]
}
{% endschema %}
