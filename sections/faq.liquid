{{ 'andatech-site.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign bg_color = false

  if color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg
  endif

  if bg_color and bg_color != settings.bg_color
    assign bg_alpha = bg_color | color_extract: 'alpha'
    if bg_alpha == 0
      assign bg_color = false
    endif
  else
    assign bg_color = false
  endif

  assign all_headings_empty = true

  for block in section.blocks
    if block.settings.heading != blank
      assign all_headings_empty = false
    endif
  endfor

  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
  assign image_position = section.settings.image_position | default: 'left'

  assign has_editorial_header = false
  if section.settings.eyebrow != blank or section.settings.heading_bold != blank or section.settings.description != blank
    assign has_editorial_header = true
  endif
-%}

{%- unless all_headings_empty -%}
  {%- unless section.settings.full_width -%}
    <div class="container">
  {%- endunless -%}

  {%- if has_image -%}
    <style>
      #cc-faq-{{ section.id }} .cc-faq-split { display: flex; gap: clamp(32px, 4vw, 64px); align-items: flex-start; }
      #cc-faq-{{ section.id }} .cc-faq-split--image-right { flex-direction: row-reverse; }
      #cc-faq-{{ section.id }} .cc-faq-split__image { flex: 0 0 42%; max-width: 42%; border-radius: 12px; overflow: hidden; position: sticky; top: 120px; }
      #cc-faq-{{ section.id }} .cc-faq-split__image img { display: block; width: 100%; height: auto; }
      #cc-faq-{{ section.id }} .cc-faq-split__content { flex: 1; min-width: 0; }
      @media (max-width: 767px) {
        #cc-faq-{{ section.id }} .cc-faq-split { flex-direction: column; }
        #cc-faq-{{ section.id }} .cc-faq-split__image { flex: none; max-width: 100%; position: static; }
      }
    </style>
  {%- endif -%}

  <div class="section{% unless bg_color == false %} section--padded{% if section.settings.full_width %} section--full-width{% endif %}{% endunless %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}" id="{{ section.settings.anchor_id | default: section.id | handleize }}">
    <div class="container at-global-faq" id="cc-faq-{{ section.id }}">
      {%- if has_image -%}
        <div class="cc-faq-split{% if image_position == 'right' %} cc-faq-split--image-right{% endif %}">
          <div class="cc-faq-split__image">
            <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
          </div>
          <div class="cc-faq-split__content">
      {%- endif -%}

      <div class="reading-width at-global-faq__inner"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
        {%- if has_editorial_header -%}
          <header class="at-global-faq__header">
            {%- if section.settings.eyebrow != blank -%}<p class="at-stepper__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
            {%- if section.settings.heading != blank or section.settings.heading_bold != blank -%}
              <h2 class="at-stepper__title">
                {{ section.settings.heading | escape }}{% if section.settings.heading_bold != blank %}{% if section.settings.heading != blank %}<br>{% endif %}<strong>{{ section.settings.heading_bold | escape }}</strong>{% endif %}
              </h2>
            {%- endif -%}
            {%- if section.settings.description != blank -%}<div class="at-stepper__desc">{{ section.settings.description }}</div>{%- endif -%}
          </header>
        {%- elsif section.settings.heading != blank -%}
          <h2 class="h4 section__heading mb-12 at-global-faq__heading {{ section.settings.heading_align }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            <h3 class="text-h5 xs:text-h6 font-body font-bold{% unless forloop.first %} mt-16{% endunless %} mb-6" {{ block.shopify_attributes }}>{{ block.settings.text }}</h3>
          {%- elsif block.type == 'button' -%}
            <div class="{% unless forloop.first %} mt-6{% endunless %} mb-6" {{ block.shopify_attributes }}>
              <a class="{{ block.settings.button_style }}" {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                {{- block.settings.button_label | escape -}}
              </a>
            </div>
          {%- elsif block.settings.heading != blank -%}
            <details-disclosure>
              <details class="disclosure disclosure--row at-global-faq__item">
                <summary class="at-global-faq__trigger">
                  <div class="flex justify-between items-center">
                    <h4 class="disclosure__title xs:regular-text h6 font-body flex flex-auto items-center mb-0 text-current at-global-faq__title">
                      {%- if block.settings.icon != 'none' -%}
                        {% render 'icon', icon: block.settings.icon, width: '1.2em', height: '1.2em' %}
                      {%- endif -%}
                      {{- block.settings.heading -}}
                    </h4>
                    <span class="disclosure__toggle at-global-faq__icon">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 9 7 7 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </div>
                </summary>
                <div class="disclosure__panel has-motion at-global-faq__panel">
                  <div class="disclosure__content rte at-global-faq__answer">
                    {{ block.settings.text }}
                  </div>
                </div>
              </details>
            </details-disclosure>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if has_image -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}
{%- endunless -%}

<script type="application/ld+json">
  {%- capture faq_json -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.heading != blank and block.settings.text != blank -%}
        {
          "@type": "Question",
          "name": {{ block.settings.heading | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.text | json }}
          }
        },
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if faq_json != blank -%}
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {{ faq_json | remove_last: ',' }}
    ]
  }
  {%- endif -%}
</script>

{% schema %}
