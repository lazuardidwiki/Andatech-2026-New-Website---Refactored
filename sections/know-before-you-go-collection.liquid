<section class="kby-collection" id="shop">
  <div class="kby-collection__head">
    <h2 class="kby-solve__title"><span class="kby-solve__title-line kby-solve__title-line--bold">{{ section.settings.heading | default: "Shop The Collection" }}</span></h2>
    {%- if section.settings.view_all_url != blank -%}
      <a href="{{ section.settings.view_all_url }}" class="kby-solve__cta">
        View all
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    {%- endif -%}
  </div>

  {%- assign kby_collection = collections[section.settings.collection] -%}
  {%- if kby_collection != blank -%}
    <div class="kby-collection__grid">
      {%- for product in kby_collection.products limit: section.settings.product_limit -%}
        <a href="{{ product.url }}" class="kby-product-card">
          <div class="kby-product-card__img-wrap">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 480 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">
            {%- endif -%}
          </div>
          <div class="kby-product-card__body">
            <p class="kby-product-card__title">{{ product.title }}</p>
            {%- if product.description != blank -%}
              <p class="kby-product-card__desc">{{ product.description | strip_html | truncate: 70 }}</p>
            {%- endif -%}
            <div class="kby-product-card__bottom">
              <p class="kby-product-card__price">
                {{ product.price | money }}
                {%- if product.compare_at_price > product.price -%}
                  <span class="kby-product-card__compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </p>
              <span class="kby-product-card__arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="kby-collection__empty">Select a collection in section settings to populate this grid.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "KBYG Shop Collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection", "id": "collection", "label": "Collection to display" },
    { "type": "range", "id": "product_limit", "label": "Number of products", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "url", "id": "view_all_url", "label": "\"View all\" link (optional)" }
  ]
}
{% endschema %}
