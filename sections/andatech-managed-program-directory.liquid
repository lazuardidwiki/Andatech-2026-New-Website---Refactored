{{ 'andatech-site.css' | asset_url | stylesheet_tag }}
{{ 'andatech-industry.css' | asset_url | stylesheet_tag }}
{{ 'andatech-managed-programs.css' | asset_url | stylesheet_tag }}

<section class="at-mp-directory"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %}>
  <div class="at-shell">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.heading_bold != blank or section.settings.description != blank -%}
      <div class="at-mp-section-head">
        {%- if section.settings.eyebrow != blank -%}<p class="at-industry__eyebrow" data-at-rise>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank or section.settings.heading_bold != blank -%}<h2 class="at-industry__title" data-at-rise>{{ section.settings.heading | escape }}{% if section.settings.heading_bold != blank %}<br><strong>{{ section.settings.heading_bold | escape }}</strong>{% endif %}</h2>{%- endif -%}
        {%- if section.settings.description != blank -%}<div class="at-industry__desc" data-at-rise>{{ section.settings.description }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="at-mp-directory__grid">
      {%- for block in section.blocks -%}
        {%- assign card_tag = 'div' -%}
        {%- if block.settings.link != blank -%}{%- assign card_tag = 'a' -%}{%- endif -%}
        <{{ card_tag }} class="at-mp-directory__card"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %} data-at-rise {{ block.shopify_attributes }}>
          {%- if block.settings.eyebrow != blank -%}<p class="at-mp-directory__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="at-mp-directory__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
          {%- if block.settings.description != blank -%}<div class="at-mp-directory__desc">{{ block.settings.description }}</div>{%- endif -%}
          {%- if block.settings.link != blank -%}
            <span class="at-mp-directory__arrow" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          {%- endif -%}
        </{{ card_tag }}>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Managed program directory",
  "tag": "section",
  "class": "at-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor", "default": "managed-program-directory" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "H2 — Heading (light)" },
    { "type": "text", "id": "heading_bold", "label": "H2 — Heading (bold)" },
    { "type": "richtext", "id": "description", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "destination",
      "name": "Destination",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 - Understand" },
        { "type": "text", "id": "title", "label": "Title", "default": "Compliance Lifecycle" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Follow the six stages of a controlled workplace testing program.</p>" },
        { "type": "url", "id": "link", "label": "Page link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Managed program directory",
      "blocks": [
        { "type": "destination" },
        { "type": "destination" },
        { "type": "destination" },
        { "type": "destination" }
      ]
    }
  ]
}
{% endschema %}
