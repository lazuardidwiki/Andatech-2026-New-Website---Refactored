{%- comment -%} Andatech — Reusable testing-method comparison for industry pages. {%- endcomment -%}
{{ 'andatech-site.css' | asset_url | stylesheet_tag }}
{{ 'andatech-industry.css' | asset_url | stylesheet_tag }}

<section class="at-industry at-testing-methods" id="{{ section.settings.anchor_id | default: 'testing-methods' | handleize }}">
  <div class="at-shell">
    <div class="at-testing-methods__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="at-industry__eyebrow" data-at-rise>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="at-industry__title" data-at-rise>{{ section.settings.heading | escape }}{% if section.settings.heading_bold != blank %}<br><strong>{{ section.settings.heading_bold | escape }}</strong>{% endif %}</h2>
      </div>
      {%- if section.settings.desc != blank -%}<div class="at-industry__desc" data-at-rise>{{ section.settings.desc }}</div>{%- endif -%}
    </div>
    <div class="at-testing-methods__grid{% if section.blocks.size == 3 %} at-testing-methods__grid--3{% endif %}">
      {%- for block in section.blocks -%}
        <article class="at-testing-method{% if block.settings.image != blank %} at-testing-method--has-image{% endif %}" data-at-rise {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="at-testing-method__media">
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy">
            </div>
          {%- endif -%}
          <div class="at-testing-method__body">
            <div class="at-testing-method__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'saliva' -%}<svg viewBox="0 0 48 48" fill="none"><path d="m13 35 22-22m-5-2 7 7M10 30l8 8m-6 1-3-3 5-5 3 3-5 5Z" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'urine' -%}<svg viewBox="0 0 48 48" fill="none"><path d="M13 15h22l-2 24H15l-2-24Zm-2-6h26v6H11V9Zm8 14h10" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/></svg>
                {%- when 'lab' -%}<svg viewBox="0 0 48 48" fill="none"><path d="M19 8h10m-8 0v12L11 37c-1 2 0 3 2 3h22c2 0 3-1 2-3L27 20V8M17 30h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- else -%}<svg viewBox="0 0 48 48" fill="none"><rect x="12" y="8" width="24" height="32" rx="5" stroke="currentColor" stroke-width="2.4"/><path d="M18 14h12v8H18v-8Zm14 14h8m-8 5h6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </div>
            {%- if block.settings.kicker != blank -%}<p class="at-testing-method__kicker">{{ block.settings.kicker | escape }}</p>{%- endif -%}
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.desc != blank -%}<div class="at-testing-method__desc">{{ block.settings.desc }}</div>{%- endif -%}
            {%- if block.settings.link_label != blank -%}<a href="{{ block.settings.link_url | default: '#' }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <div class="at-testing-methods__footnote" data-at-rise>{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Industry Testing Methods",
  "tag": "section",
  "class": "at-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor", "default": "testing-methods" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Testing Methods" },
    { "type": "text", "id": "heading", "label": "Heading (light)", "default": "Choose the method around" },
    { "type": "text", "id": "heading_bold", "label": "Heading (bold)", "default": "the testing scenario." },
    { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Sample type, detection window, speed and confirmation requirements should be selected around your policy, role risks and operating conditions.</p>" },
    { "type": "richtext", "id": "footnote", "label": "Footnote", "info": "Optional text below the cards, e.g. cross-links to training hubs." }
  ],
  "blocks": [{ "type": "method", "name": "Testing method", "limit": 8, "settings": [
    { "type": "image_picker", "id": "image", "label": "Card image", "info": "Optional. When selected, the image appears above the card content." },
    { "type": "select", "id": "icon", "label": "Icon", "options": [
      { "value": "breath", "label": "Breath" }, { "value": "saliva", "label": "Saliva" }, { "value": "urine", "label": "Urine" }, { "value": "lab", "label": "Laboratory" }
    ], "default": "breath" },
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Alcohol" },
    { "type": "text", "id": "title", "label": "Title", "default": "Breath Testing" },
    { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Rapid, non-invasive breath alcohol screening for site entry, random and for-cause programs.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ] }],
  "presets": [{ "name": "Industry Testing Methods", "blocks": [
    { "type": "method", "settings": { "icon": "breath", "kicker": "Alcohol", "title": "Breath Testing", "desc": "<p>Rapid, non-invasive breath alcohol screening for site entry, random and for-cause programs.</p>" } },
    { "type": "method", "settings": { "icon": "saliva", "kicker": "Oral fluid", "title": "Saliva Testing", "desc": "<p>On-site drug screening suited to recent-use detection and straightforward observed collection.</p>" } },
    { "type": "method", "settings": { "icon": "urine", "kicker": "Urine", "title": "Urine Testing", "desc": "<p>Established workplace screening with a broader detection window for many drug classes.</p>" } },
    { "type": "method", "settings": { "icon": "lab", "kicker": "Confirmation", "title": "Laboratory Analysis", "desc": "<p>Accredited laboratory analysis for non-negative screens and testing scenarios that require definitive confirmation.</p>" } }
  ] }]
}
{% endschema %}
