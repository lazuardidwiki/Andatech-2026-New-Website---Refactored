{{ 'andatech-site.css' | asset_url | stylesheet_tag }}
{{ 'andatech-about.css' | asset_url | stylesheet_tag }}

<section class="at-about-brands at-about-section"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %}>
  <div class="at-shell">
    {%- assign heading_tag = section.settings.heading_tag | default: 'h3' -%}
    {%- if section.settings.heading != blank -%}<{{ heading_tag }} class="at-about-brands__title">{{ section.settings.heading | escape }}</{{ heading_tag }}>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="at-about-brands__grid">
        {%- for block in section.blocks -%}
          <div class="at-about-brands__card" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              {%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}" class="at-about-brands__link">{%- endif -%}
              {{ block.settings.logo | image_url: width: 400 | image_tag: class: 'at-about-brands__logo', widths: '120, 200, 400', sizes: '(min-width: 768px) 200px, 140px', loading: 'lazy', alt: block.settings.alt | default: block.settings.name }}
              {%- if block.settings.url != blank -%}</a>{%- endif -%}
            {%- elsif block.settings.name != blank -%}
              <span class="at-about-brands__name">{{ block.settings.name | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About — Our brands",
  "tag": "section",
  "class": "at-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor", "default": "about-brands" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our brands" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ],
      "default": "h3"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "default": "Brand" },
        { "type": "image_picker", "id": "logo", "label": "Brand logo" },
        { "type": "text", "id": "alt", "label": "Logo alt text" },
        { "type": "url", "id": "url", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "About — Our brands", "blocks": [
      { "type": "brand", "settings": { "name": "AlcoSense" } },
      { "type": "brand", "settings": { "name": "DrugSense" } },
      { "type": "brand", "settings": { "name": "andalink" } },
      { "type": "brand", "settings": { "name": "ionmax" } }
    ] }
  ]
}
{% endschema %}