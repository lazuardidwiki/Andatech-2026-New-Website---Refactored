{% schema %}
{
  "name": "BAC Calculator Wheel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BAC Wheel Estimator"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8dc63f"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA Text",
      "default": "TOO COMPLICATED? SIMPLIFY."
    },
    {
      "type": "text",
      "id": "cta_btn_text",
      "label": "Button Label",
      "default": "GET AN ALCOSENSE BREATHALYZER"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "BAC Calculator Wheel"
    }
  ]
}
{% endschema %}

<div class="bac-wheel-section" id="bac-wheel-section-{{ section.id }}" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="wheel-container">
    <h2 class="wheel-title">{{ section.settings.heading }}</h2>

    <div class="dashboard-grid">
      
      <!-- DIAL 1: WEIGHT -->
      <div class="dial-wrapper">
        <div class="dial" id="dial-weight" data-min="40" data-max="150" data-value="75" data-step="1">
          <svg viewBox="0 0 200 200">
            <circle class="track" cx="100" cy="100" r="90" />
            <circle class="progress" cx="100" cy="100" r="90" />
            <circle class="handle" cx="100" cy="10" r="8" />
          </svg>
          <div class="dial-content">
            <span class="dial-value">75</span>
            <span class="dial-label">Weight (kg)</span>
          </div>
        </div>
      </div>

      <!-- CENTER: RESULT -->
      <div class="result-display">
        <div class="gender-toggle">
          <button class="g-btn active" data-val="0.68">Male</button>
          <button class="g-btn" data-val="0.55">Female</button>
        </div>
        
        <div class="bac-readout">
          <span class="percent" id="wheel-bac-result">0.000</span>
          <span class="unit">% BAC</span>
        </div>
        
        <div class="status-msg" id="wheel-status-msg">Safe to Drive</div>
      </div>

      <!-- DIAL 2: DRINKS -->
      <div class="dial-wrapper">
        <div class="dial" id="dial-drinks" data-min="0" data-max="20" data-value="2" data-step="1">
          <svg viewBox="0 0 200 200">
            <circle class="track" cx="100" cy="100" r="90" />
            <circle class="progress" cx="100" cy="100" r="90" />
            <circle class="handle" cx="100" cy="10" r="8" />
          </svg>
          <div class="dial-content">
            <span class="dial-value">2</span>
            <span class="dial-label">Std Drinks</span>
          </div>
        </div>
      </div>

      <!-- DIAL 3: HOURS (Full width on mobile, centered) -->
      <div class="dial-wrapper full-width">
        <div class="dial" id="dial-hours" data-min="0" data-max="12" data-value="1" data-step="0.5">
          <svg viewBox="0 0 200 200">
            <circle class="track" cx="100" cy="100" r="90" />
            <circle class="progress" cx="100" cy="100" r="90" />
            <circle class="handle" cx="100" cy="10" r="8" />
          </svg>
          <div class="dial-content">
            <span class="dial-value">1</span>
            <span class="dial-label">Hours Since</span>
          </div>
        </div>
      </div>

    </div>

    <!-- FLIP CARD EFFECTS -->
    <div class="card-container">
      <div class="card">
        <div class="front-content">
          <div class="front-inner">
            <small>ESTIMATED EFFECT</small>
            <p id="bac-effects-text">Mild change, may seem slightly elated.</p>
            <span class="hover-hint">(Hover for full guide)</span>
          </div>
        </div>
        <div class="content">
          <p class="heading">BAC Effects Guide</p>
          <ul class="effects-list">
            <li><strong>0.02%</strong> Mild relaxation</li>
            <li><strong>0.05%</strong> Lowered inhibition & judgment</li>
            <li><strong>0.08%</strong> Impaired steering & vision (Illegal)</li>
            <li><strong>0.10%</strong> Slurred speech, poor coordination</li>
            <li><strong>0.15%</strong> Major loss of balance</li>
            <li><strong>>0.30%</strong> Stupor / Unconscious</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- CTA SECTION -->
    <div class="cta-container">
      <h3>{{ section.settings.cta_heading | newline_to_br }}</h3>
      <a href="{{ section.settings.cta_link }}" class="cta-btn">{{ section.settings.cta_btn_text }}</a>
    </div>
    
    <p class="disclaimer">Estimate only. Do not use to assess ability to drive.</p>
  </div>
</div>

<style>
  .bac-wheel-section {
    padding: 4rem 1rem;
    font-family: 'Inter', system-ui, sans-serif;
    --w-accent: {{ section.settings.accent_color }};
    --w-danger: #ff4757;
    --w-track: #e5e7eb;
    --w-text: {{ section.settings.text_color }};
    
    /* Default State uses Accent */
    --current-color: var(--w-accent);
    transition: --current-color 0.3s;
  }

  /* Danger State Class */
  .bac-wheel-section.is-danger {
    --current-color: var(--w-danger);
  }

  .wheel-container {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .wheel-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 3rem;
  }

  /* Grid Layout */
  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    gap: 2rem;
    align-items: center;
    justify-content: center;
    margin-bottom: 3rem;
  }

  @media (max-width: 768px) {
    .dashboard-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .result-display {
      grid-column: 1 / -1;
      order: 2;
      margin: 1rem 0;
    }
    .dial-wrapper { order: 1; }
    .dial-wrapper.full-width {
      grid-column: 1 / -1;
      order: 3;
      display: flex;
      justify-content: center;
    }
  }

  /* Dial Component */
  .dial {
    width: 200px;
    height: 200px;
    position: relative;
    cursor: grab;
    touch-action: none;
    margin: 0 auto;
  }
  
  .dial:active { cursor: grabbing; }

  .dial svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .dial circle {
    fill: none;
    stroke-width: 12;
    stroke-linecap: round;
    transform-origin: center;
  }

  .dial .track,
  .dial .progress {
    transform: rotate(-90deg);
  }

  .dial .track {
    stroke: var(--w-track);
  }

  .dial .progress {
    stroke: var(--current-color); /* Dynamic Color */
    stroke-dasharray: 565;
    stroke-dashoffset: 565;
    transition: stroke-dashoffset 0.1s linear, stroke 0.3s;
  }

  .dial .handle {
    fill: #fff;
    stroke: var(--current-color); /* Dynamic Color */
    stroke-width: 4;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
    cursor: pointer;
    transition: stroke 0.3s;
  }

  .dial-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    pointer-events: none;
  }

  .dial-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--w-text);
  }

  .dial-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.6;
    color: var(--w-text);
  }

  /* Center Result */
  .result-display {
    text-align: center;
    padding: 2rem;
    background: rgba(0,0,0,0.02);
    border-radius: 50%;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border: 2px solid var(--w-track);
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);
    transition: border-color 0.3s;
  }
  
  .bac-wheel-section.is-danger .result-display {
    border-color: var(--w-danger);
    background: #fff1f2;
  }

  .gender-toggle {
    background: var(--w-track);
    padding: 4px;
    border-radius: 30px;
    display: flex;
    margin-bottom: 1rem;
  }

  .g-btn {
    border: none;
    background: none;
    padding: 6px 16px;
    border-radius: 24px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    color: #666;
    transition: all 0.2s;
  }

  .g-btn.active {
    background: #fff;
    color: var(--current-color);
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }

  .bac-readout .percent {
    display: block;
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--current-color);
    transition: color 0.3s;
  }

  .bac-readout .unit {
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0.6;
  }

  .status-msg {
    margin-top: 1rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 0.9rem;
    color: var(--current-color);
  }

  /* --- FLIP CARD STYLES --- */
  .card-container {
    width: 100%;
    max-width: 500px;
    height: 300px;
    position: relative;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    margin: 0 auto 3rem;
    background: white;
    border: 1px solid #eee;
  }

  .card {
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }

  /* Front State */
  .card .front-content {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
  }

  .front-inner {
    text-align: center;
  }

  .front-inner small {
    display: block;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    color: #999;
    font-size: 0.8rem;
  }

  .card .front-content p {
    font-size: 28px;
    font-weight: 700;
    opacity: 1;
    line-height: 1.3;
    /* Use current-color for text */
    color: var(--current-color);
    transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
    margin: 0;
  }
  
  .hover-hint {
    display: block;
    margin-top: 1rem;
    font-size: 0.8rem;
    opacity: 0.4;
  }

  /* Hover State */
  .card .content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 10px;
    /* Gradient Background using vars */
    background: linear-gradient(135deg, var(--current-color) 0%, #1a1a1a 150%);
    color: #fff;
    padding: 2rem;
    line-height: 1.5;
    border-radius: 5px;
    pointer-events: none;
    transform: translateY(-98%); /* Peek slightly or fully hide? Provided CSS was -96% */
    transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
  }

  .card .content .heading {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  
  .effects-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
    text-align: left;
    width: 100%;
  }
  
  .effects-list li {
    margin-bottom: 6px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 4px;
  }
  
  .effects-list strong {
    color: rgba(255,255,255,0.9);
    margin-right: 8px;
  }

  /* Hover Animations */
  .card:hover .content {
    transform: translateY(0);
    pointer-events: auto;
  }

  .card:hover .front-content {
    transform: translateY(30%);
    opacity: 0;
  }

  /* CTA Section */
  .cta-container {
    background: var(--current-color);
    color: white;
    padding: 3rem 2rem;
    border-radius: 16px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    transition: background 0.3s;
  }

  .cta-container h3 {
    margin: 0 0 1.5rem 0;
    font-size: 1.8rem;
    line-height: 1.2;
    font-weight: 800;
  }

  .cta-btn {
    display: inline-block;
    background: white;
    color: var(--current-color);
    padding: 1rem 2rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.2s, box-shadow 0.2s, color 0.3s;
  }

  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
  }

  .disclaimer {
    margin-top: 3rem;
    font-size: 0.75rem;
    opacity: 0.5;
  }
</style>

<script>
  (function() {
    // Math Constants
    const PI2 = Math.PI * 2;
    const CIRCLE_R = 90;
    const CIRCLE_LEN = 2 * Math.PI * CIRCLE_R;

    // State
    let state = {
      weight: 75,
      drinks: 2,
      hours: 1,
      genderConst: 0.68
    };

    function initDial(id, key) {
      const dial = document.getElementById(id);
      const progress = dial.querySelector('.progress');
      const handle = dial.querySelector('.handle');
      const valueText = dial.querySelector('.dial-value');
      
      const min = parseFloat(dial.dataset.min);
      const max = parseFloat(dial.dataset.max);
      const step = parseFloat(dial.dataset.step);
      
      function updateVisuals() {
        let val = state[key];
        let range = max - min;
        let pct = (val - min) / range;
        if(pct < 0) pct = 0;
        if(pct > 1) pct = 1;

        const offset = CIRCLE_LEN * (1 - pct);
        progress.style.strokeDashoffset = offset;

        const angle = pct * PI2;
        const hx = 100 + 90 * Math.sin(angle);
        const hy = 100 - 90 * Math.cos(angle);
        
        handle.setAttribute('cx', hx);
        handle.setAttribute('cy', hy);
        valueText.innerText = val;
        
        recalcBAC();
      }

      let isDragging = false;

      function handleMove(e) {
        if (!isDragging) return;
        e.preventDefault();
        
        const rect = dial.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        const dx = clientX - centerX;
        const dy = clientY - centerY;
        
        let angle = Math.atan2(dx, -dy);
        if (angle < 0) angle += PI2;
        
        const pct = angle / PI2;
        let rawVal = min + pct * (max - min);
        let val = Math.round(rawVal / step) * step;
        val = Math.round(val * 100) / 100;
        
        if (val < min) val = min;
        if (val > max) val = max;
        
        state[key] = val;
        updateVisuals();
      }

      dial.addEventListener('mousedown', (e) => { isDragging = true; handleMove(e); });
      window.addEventListener('mousemove', handleMove);
      window.addEventListener('mouseup', () => { isDragging = false; });
      dial.addEventListener('touchstart', (e) => { isDragging = true; handleMove(e); });
      window.addEventListener('touchmove', handleMove);
      window.addEventListener('touchend', () => { isDragging = false; });

      updateVisuals();
    }

    function recalcBAC() {
      const { weight, drinks, hours, genderConst } = state;
      const gramsAlcohol = drinks * 10;
      let bac = (gramsAlcohol / (weight * 1000 * genderConst)) * 100;
      bac = bac - (0.015 * hours);
      if (bac < 0) bac = 0;

      const resEl = document.getElementById('wheel-bac-result');
      const msgEl = document.getElementById('wheel-status-msg');
      const effectsEl = document.getElementById('bac-effects-text');
      const sectionEl = document.getElementById('bac-wheel-section-{{ section.id }}');
      
      resEl.innerText = bac.toFixed(3);
      
      // RED DANGER MODE logic
      if (bac >= 0.05) {
        sectionEl.classList.add('is-danger');
        msgEl.innerText = "Unsafe to Drive";
      } else {
        sectionEl.classList.remove('is-danger');
        msgEl.innerText = "Likely Safe";
      }

      // Effects Logic
      let effectText = "No significant effects detected.";
      if (bac >= 0.40) {
        effectText = "Unconscious. Possibly in coma and verge of death.";
      } else if (bac >= 0.30) {
        effectText = "Stuporous. Severe central nervous system depression.";
      } else if (bac >= 0.15) {
        effectText = "Unmistakably drunk. All faculties affected.";
      } else if (bac >= 0.10) {
        effectText = "Judgment seriously affected, coordination impaired. Legally under influence.";
      } else if (bac >= 0.08) {
        effectText = "Ability to accurately steer, brake, and judge distance impaired. Legally considered drunk.";
      } else if (bac >= 0.05) {
        effectText = "Drivers hesitant: alternate from 'who cares?' to impulsive aggression.";
      } else if (bac >= 0.02) {
        effectText = "Mild change, may seem slightly elated.";
      }
      
      effectsEl.innerText = effectText;
    }

    function initGender() {
      const btns = document.querySelectorAll('.g-btn');
      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          btns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          state.genderConst = parseFloat(btn.dataset.val);
          recalcBAC();
        });
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      initDial('dial-weight', 'weight');
      initDial('dial-drinks', 'drinks');
      initDial('dial-hours', 'hours');
      initGender();
    });
    
    document.addEventListener('shopify:section:load', () => {
      initDial('dial-weight', 'weight');
      initDial('dial-drinks', 'drinks');
      initDial('dial-hours', 'hours');
      initGender();
    });

  })();
</script>