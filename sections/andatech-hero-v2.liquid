{%- comment -%}
  Andatech — Hero V2
  Centre-aligned variant. Uses the same at-hero classes as V1 so all existing
  styles from andatech-site.css apply automatically. The .at-hero--v2 modifier
  adds only the gray background and desktop centre-alignment.
{%- endcomment -%}

{{ 'andatech-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'andatech-homepage.js' | asset_url }}" defer="defer"></script>
{{ 'andatech-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_visual = section.settings.visual_desktop
  assign mobile_visual  = section.settings.visual_mobile
  assign certs          = section.settings.certs_image
-%}

<style>
  /* ── V2 modifier: gray bg + centred desktop layout ── */
  .at-hero.at-hero--v2 {
    background: #FFFFFF;
  }

  /* Desktop: centre horizontally + vertically */
  .at-hero--v2 .at-hero__inner {
    text-align: center;
    align-self: center;
    padding-top: 24px;
    padding-bottom: 24px;
  }
  .at-hero--v2 .at-hero__content {
    max-width: 820px;
    margin-inline: auto;
  }
  .at-hero--v2 .at-hero__body {
    margin-inline: auto;
  }
  .at-hero--v2 .at-hero__cta {
    justify-content: center;
  }
  .at-hero--v2 .at-hero__trust {
    text-align: center;
  }
  .at-hero--v2 .at-hero__certs {
    margin-inline: auto;
  }

  /* V2 mobile image — shown below copy on small screens */
  .at-hero--v2 .at-hero-v2__mobile-visual {
    display: none;
  }

  /* ── Tablet portrait — show mobile image, hide desktop bg ── */
  @media (min-width: 768px) and (max-width: 1279px) and (orientation: portrait) {
    .at-hero--v2 .at-hero-v2__mobile-visual {
      display: block;
      order: 2;
      width: 100%;
    }
    .at-hero--v2 .at-hero-v2__mobile-visual img {
      width: 100%;
      height: auto;
      object-fit: contain;
      object-position: center bottom;
    }
    .at-hero--v2 .at-hero__visual { display: none; }
  }

  /* ── Mobile — show mobile image, hide desktop bg ── */
  @media (max-width: 767px) {
    .at-hero--v2 .at-hero__inner {
      padding-top: 8px;
    }
    .at-hero--v2 .at-hero-v2__mobile-visual {
      display: block;
      order: 2;
      width: 100%;
      margin: 4px 0 0;
    }
    .at-hero--v2 .at-hero-v2__mobile-visual img {
      width: 100%;
      height: auto;
      max-height: none;
      object-fit: contain;
    }
    .at-hero--v2 .at-hero__visual { display: none; }
  }
</style>

<section class="at-hero at-hero--v2" id="{{ section.settings.anchor_id | default: section.id | handleize }}">
  <div class="at-hero__visual">
    {%- if desktop_visual != blank -%}
      <picture>
        {%- if mobile_visual != blank -%}
          <source media="(max-width: 1279px) and (orientation: portrait)" srcset="{{ mobile_visual | image_url: width: 1400 }}">
        {%- endif -%}
        <img src="{{ desktop_visual | image_url: width: 3456 }}"
             alt="{{ desktop_visual.alt | default: section.settings.visual_alt | escape }}"
             width="{{ desktop_visual.width }}" height="{{ desktop_visual.height }}"
             loading="eager" fetchpriority="high">
      </picture>
    {%- endif -%}
  </div>

  <div class="at-shell at-hero__inner">
    <div class="at-hero__content">

      {%- if section.settings.eyebrow != blank -%}
        {%- assign eyebrow_tag = section.settings.eyebrow_tag | default: 'p' -%}
        <{{ eyebrow_tag }} class="at-label-tag" data-at-rise>{{ section.settings.eyebrow | escape }}</{{ eyebrow_tag }}>
      {%- endif -%}

      {%- assign heading_tag = section.settings.heading_tag | default: 'h1' -%}
      <{{ heading_tag }} class="at-hero__title">
        {%- if section.settings.heading_line_1 != blank -%}
          <span data-at-rise>{{ section.settings.heading_line_1 | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading_line_2 != blank -%}
          <span data-at-rise>{{ section.settings.heading_line_2 | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading_accent != blank -%}
          <span data-at-rise class="at-hero__accent">{{ section.settings.heading_accent | escape }}</span>
        {%- endif -%}
      </{{ heading_tag }}>

      {%- if section.settings.body != blank -%}
        <div class="at-hero__body" data-at-rise>{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.cta1_label != blank or section.settings.cta2_label != blank -%}
        <div class="at-hero__cta" data-at-rise>
          {%- if section.settings.cta1_label != blank -%}
            <a class="at-btn at-btn--green" href="{{ section.settings.cta1_link | default: '#' }}">
              {{ section.settings.cta1_label | escape }}
              <i class="at-btn__arrow" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="m10 5.5 6.5 6.5-6.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </i>
            </a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="at-btn at-btn--outline-dark" href="{{ section.settings.cta2_link | default: '#' }}"{% if section.settings.cta2_label contains 'Find Your Device' %} data-at-device-open{% endif %}>
              {{ section.settings.cta2_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.trust_line != blank -%}
        <p class="at-hero__trust" data-at-rise>{{ section.settings.trust_line | escape }}</p>
      {%- endif -%}

      {%- if certs != blank -%}
        <img class="at-hero__certs" src="{{ certs | image_url: width: 678 }}"
             alt="{{ certs.alt | default: section.settings.certs_alt | escape }}"
             width="{{ certs.width }}" height="{{ certs.height }}" loading="lazy" data-at-rise>
      {%- endif -%}

    </div>
  </div>

  {%- comment -%} Mobile image — shown below the copy on small screens {%- endcomment -%}
  {%- if mobile_visual != blank -%}
    <div class="at-hero-v2__mobile-visual">
      <img src="{{ mobile_visual | image_url: width: 1400 }}"
           alt="{{ mobile_visual.alt | default: section.settings.visual_alt | escape }}"
           width="{{ mobile_visual.width }}" height="{{ mobile_visual.height }}"
           loading="eager">
    </div>
  {%- elsif desktop_visual != blank -%}
    <div class="at-hero-v2__mobile-visual">
      <img src="{{ desktop_visual | image_url: width: 1400 }}"
           alt="{{ desktop_visual.alt | default: section.settings.visual_alt | escape }}"
           width="{{ desktop_visual.width }}" height="{{ desktop_visual.height }}"
           loading="eager">
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "Andatech Hero V2",
  "tag": "section",
  "class": "at-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor",
      "info": "Used for in-page navigation links."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Workplace Safety & Health Compliance"
    },
    {
      "type": "select",
      "id": "eyebrow_tag",
      "label": "Eyebrow HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ],
      "default": "p"
    },
    {
      "type": "header",
      "content": "Page title"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Line 1",
      "info": "Light weight. Each line sits on its own row.",
      "default": "Drug & Alcohol Testing"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Line 2",
      "default": "For Workplaces."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent line",
      "info": "Rendered bold in Andatech's animated green-to-teal gradient.",
      "default": "Devices included."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Testing devices, NATA-accredited calibration, reporting, training and audit readiness. Delivered as one managed program, or buy the equipment outright and run it yourself.</p>"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line",
      "default": "Andatech is Australia's leading drug and alcohol testing specialist since 2003."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Primary button label",
      "default": "Explore Managed Programs"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label",
      "default": "Find Your Device",
      "info": "🔒 Keep this exactly as \"Find Your Device\" to open the Device Finder overlay. Change the label only if you want this button to become a normal link."
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary button link",
      "info": "⚠ Ignored while the label above is \"Find Your Device\" — the button opens the Device Finder overlay instead. Fill this in only if you rename the button."
    },
    {
      "type": "header",
      "content": "Imagery"
    },
    {
      "type": "image_picker",
      "id": "visual_desktop",
      "label": "Hero visual — desktop",
      "info": "Background image behind the centred content. Use a transparent PNG for best results."
    },
    {
      "type": "image_picker",
      "id": "visual_mobile",
      "label": "Hero visual — mobile",
      "info": "Shown below the copy on small screens. Falls back to the desktop image if not set."
    },
    {
      "type": "text",
      "id": "visual_alt",
      "label": "Hero visual alt text",
      "default": "Two workers in hi-vis conducting an on-site compliance check"
    },
    {
      "type": "image_picker",
      "id": "certs_image",
      "label": "Accreditation strip",
      "info": "The accreditation logo strip shown under the trust line."
    },
    {
      "type": "text",
      "id": "certs_alt",
      "label": "Accreditation strip alt text",
      "default": "ISO 27001, ILAC-MRA, NATA, ISO 9001 and AS 3547 accreditations"
    }
  ],
  "presets": [
    {
      "name": "Andatech Hero V2"
    }
  ]
}
{% endschema %}
