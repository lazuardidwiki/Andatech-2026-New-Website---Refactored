{%- comment -%} Andatech — Industry risk landscape. Tabbed, editor-managed card grid. {%- endcomment -%}
{{ 'andatech-site.css' | asset_url | stylesheet_tag }}
{{ 'andatech-industry.css' | asset_url | stylesheet_tag }}

<section class="at-industry at-industry-risks" id="{{ section.settings.anchor_id | default: 'industry-risks' | handleize }}">
  <div class="at-shell">
    {%- if section.settings.eyebrow != blank -%}<p class="at-industry__eyebrow" data-at-rise>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="at-industry__title" data-at-rise>{{ section.settings.heading | escape }}{% if section.settings.heading_bold != blank %}<br><strong>{{ section.settings.heading_bold | escape }}</strong>{% endif %}</h2>
    <div class="at-industry__control-row">
      {%- if section.settings.desc != blank -%}<div class="at-industry__desc" data-at-rise>{{ section.settings.desc }}</div>{%- endif -%}
      <div class="at-industry-tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for i in (1..3) -%}
          {%- assign label_key = 'tab_' | append: i | append: '_label' -%}
          {%- assign tab_id = 'tab_' | append: i -%}
          {%- if section.settings[label_key] != blank -%}
            <button class="at-industry-tabs__button{% if forloop.first %} is-active{% endif %}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="AtRiskPanel-{{ section.id }}-{{ i }}" data-at-tab="{{ tab_id }}">{{ section.settings[label_key] | escape }}</button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- for i in (1..3) -%}
      {%- assign tab_id = 'tab_' | append: i -%}
      {%- assign card_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.tab == tab_id -%}{%- assign card_count = card_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      {%- if card_count <= 1 -%}{%- assign grid_count = 1 -%}
      {%- elsif card_count == 2 -%}{%- assign grid_count = 2 -%}
      {%- elsif card_count == 3 -%}{%- assign grid_count = 3 -%}
      {%- else -%}{%- assign grid_count = 4 -%}
      {%- endif -%}
      <div class="at-industry-tabs__panel{% if forloop.first %} is-active{% endif %}" id="AtRiskPanel-{{ section.id }}-{{ i }}" role="tabpanel" {% unless forloop.first %}hidden{% endunless %} data-at-panel="{{ tab_id }}">
        <div class="at-industry-card-grid at-industry-card-grid--{{ grid_count }}">
          {%- for block in section.blocks -%}
            {%- if block.settings.tab == tab_id -%}
              <article class="at-industry-card" data-at-rise {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}<img class="at-industry-card__image" src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy">{%- endif -%}
                <div class="at-industry-card__shade" aria-hidden="true"></div>
                <div class="at-industry-card__content">
                  {%- if block.settings.badge != blank -%}<span class="at-industry-card__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
                  <h3>{{ block.settings.title | escape }}</h3>
                  {%- if block.settings.desc != blank -%}<div>{{ block.settings.desc }}</div>{%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('{{ section.settings.anchor_id | default: 'industry-risks' | handleize }}');
  if (!root || root.dataset.tabsReady) return;
  root.dataset.tabsReady = 'true';
  var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-at-tab]'));
  var panels = Array.prototype.slice.call(root.querySelectorAll('[data-at-panel]'));
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (item) { var active = item === tab; item.classList.toggle('is-active', active); item.setAttribute('aria-selected', String(active)); });
      panels.forEach(function (panel) { var active = panel.dataset.atPanel === tab.dataset.atTab; panel.hidden = !active; panel.classList.toggle('is-active', active); });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Industry Risks",
  "tag": "section",
  "class": "at-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor", "default": "industry-risks" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Industry Challenges & Risks" },
    { "type": "text", "id": "heading", "label": "H2 — Heading (light)", "default": "The Industry" },
    { "type": "text", "id": "heading_bold", "label": "H2 — Heading (bold)", "default": "Risk Landscape" },
    { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Understand the workforce, operational and compliance pressures that shape drug and alcohol risk across heavy industry sites.</p>" },
    { "type": "text", "id": "tab_1_label", "label": "Tab 1 label", "default": "Industry Challenges" },
    { "type": "text", "id": "tab_2_label", "label": "Tab 2 label", "default": "Industry Risks & Costs" },
    { "type": "text", "id": "tab_3_label", "label": "Tab 3 label", "default": "Social & Economic Impact" }
  ],
  "blocks": [
    { "type": "card", "name": "Risk card", "limit": 24, "settings": [
      { "type": "select", "id": "tab", "label": "Tab", "options": [
        { "value": "tab_1", "label": "Industry Challenges" },
        { "value": "tab_2", "label": "Industry Risks & Costs" },
        { "value": "tab_3", "label": "Social & Economic Impact" }
      ], "default": "tab_1" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "badge", "label": "Small label" },
      { "type": "text", "id": "title", "label": "Title", "default": "Large mobile workforce" },
      { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Testing needs to remain consistent as workers move between projects, crews and sites.</p>" }
    ] }
  ],
  "presets": [{ "name": "Industry Risks", "blocks": [
    { "type": "card", "settings": { "title": "Large Mobile Workforce", "desc": "<p>Testing needs to remain consistent as workers move between projects, crews and sites.</p>" } },
    { "type": "card", "settings": { "title": "FIFO Workers", "desc": "<p>Roster changes and travel patterns can make impairment controls harder to apply consistently.</p>" } },
    { "type": "card", "settings": { "title": "Remote Locations", "desc": "<p>Limited access to services can delay testing, confirmation and escalation.</p>" } },
    { "type": "card", "settings": { "title": "Fatigue", "desc": "<p>Long shifts and demanding rosters can compound fitness-for-work risk.</p>" } },
    { "type": "card", "settings": { "title": "Heavy Machinery", "desc": "<p>Operators need reliable judgement, coordination and reaction time around high-consequence equipment.</p>" } },
    { "type": "card", "settings": { "title": "Subcontractors", "desc": "<p>Different employers and policies require one clearly communicated site standard.</p>" } },
    { "type": "card", "settings": { "title": "High Injury Potential", "desc": "<p>A single impaired decision can expose workers and surrounding teams to serious harm.</p>" } },
    { "type": "card", "settings": { "title": "Multiple Regulators", "desc": "<p>Programs may need to account for overlapping industry, safety and jurisdictional requirements.</p>" } }
  ] }]
}
{% endschema %}
