{% comment %}
  ANDATECH ADVANCED FILTER GRID (DROPDOWN EDITION) - FINAL
  - 3 Independent Filter Groups
  - "AND" Filtering Logic
  - Fully Editable Text Sizes (including Filters)
  - Colors: Andatech Green
{% endcomment %}

<style>
  /* --- SCOPED VARIABLES --- */
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.section_bg_color }};
    --card-bg: {{ section.settings.card_bg_color }};
    --text-color: {{ section.settings.card_text_color }};
    --accent-color: #76bc21; /* Andatech Green */
    
    /* Typography Variables */
    --header-size: {{ section.settings.header_size }}px;
    --date-size: {{ section.settings.date_size }}px;
    --title-size: {{ section.settings.title_size }}px;
    --desc-size: {{ section.settings.desc_size }}px;
    
    /* Filter Size Control */
    --filter-font-size: {{ section.settings.filter_size }}px;
    --filter-label-size: calc(var(--filter-font-size) * 0.85); /* Label is slightly smaller */
    --filter-height: calc(var(--filter-font-size) * 2.5);
  }

  /* --- SECTION WRAPPER --- */
  .adt-adv-section {
    background-color: var(--bg-color);
    padding: 80px 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .adt-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* --- HEADER AREA --- */
  .adt-header-wrap {
    text-align: center;
    margin-bottom: 60px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  .adt-header-wrap h2 {
    font-size: var(--header-size);
    font-weight: 800;
    margin-bottom: 20px;
    color: #111;
    line-height: 1.2;
  }
  .adt-header-wrap p {
    color: #666;
    line-height: 1.6;
    font-size: 1rem;
  }

  /* --- DROPDOWN FILTER BAR --- */
  .adt-filter-bar {
    display: flex;
    justify-content: center;
    gap: 50px; /* Increased gap for larger filters */
    margin-bottom: 60px;
    border-bottom: 1px solid #eee;
    padding-bottom: 30px;
    flex-wrap: wrap;
  }

  .adt-filter-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 220px; /* Wider to accommodate larger text */
  }

  .adt-filter-label {
    font-size: var(--filter-label-size);
    font-weight: 700;
    color: #111;
    text-transform: uppercase;
    margin-bottom: 10px;
    letter-spacing: 0.5px;
  }

  .adt-select-wrapper {
    position: relative;
    width: 100%;
  }

  .adt-select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    background: transparent;
    border: none;
    font-size: var(--filter-font-size);
    color: #555;
    padding: 5px 30px 5px 0; /* Right padding space for arrow */
    cursor: pointer;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
    height: var(--filter-height);
  }
  
  .adt-select:hover, .adt-select:focus {
    color: var(--accent-color);
    outline: none;
  }

  /* Scalable Arrow */
  .adt-select-arrow {
    position: absolute;
    right: 0; top: 50%; transform: translateY(-50%);
    pointer-events: none;
    width: 0; height: 0; 
    border-left: calc(var(--filter-font-size) / 3) solid transparent;
    border-right: calc(var(--filter-font-size) / 3) solid transparent;
    border-top: calc(var(--filter-font-size) / 3) solid var(--accent-color);
  }

  /* --- GRID LAYOUT --- */
  .adt-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    min-height: 300px;
  }

  .adt-block { display: block; }
  .adt-block.hidden { display: none; }

  /* --- CARD DESIGN --- */
  .adt-card {
    background: var(--card-bg);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    height: 100%;
    display: flex; flex-direction: column;
    transition: transform 0.3s ease;
  }
  .adt-card:hover { transform: translateY(-5px); }

  .adt-card-img-wrap {
    height: 220px; overflow: hidden; position: relative;
  }
  .adt-card-img {
    width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;
  }
  .adt-card:hover .adt-card-img { transform: scale(1.05); }

  .adt-card-body {
    padding: 25px; display: flex; flex-direction: column; flex-grow: 1; text-align: left;
  }

  .adt-date {
    font-size: var(--date-size);
    color: #999; margin-bottom: 10px; text-transform: uppercase;
  }

  .adt-title {
    font-size: var(--title-size);
    font-weight: 800; text-transform: uppercase; margin-bottom: 15px; line-height: 1.3; color: var(--text-color);
  }

  .adt-desc {
    font-size: var(--desc-size);
    color: #666; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;
  }

  .adt-read-more {
    color: var(--accent-color); font-weight: 700; text-decoration: none; font-size: 0.9rem;
    text-transform: uppercase; border-bottom: 2px solid rgba(118, 188, 33, 0.2);
    display: inline-block; padding-bottom: 2px; transition: all 0.2s; align-self: flex-start;
  }
  .adt-read-more:hover { border-bottom-color: var(--accent-color); }

  /* --- PAGINATION --- */
  .adt-pagination {
    display: flex; justify-content: center; gap: 10px; margin-top: 60px;
  }
  .adt-page-btn {
    width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;
    border: 1px solid #ddd; color: #555; font-weight: 600; cursor: pointer; background: #fff; transition: all 0.2s;
  }
  .adt-page-btn.active, .adt-page-btn:hover {
    background: var(--accent-color); color: #fff; border-color: var(--accent-color);
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .adt-grid { grid-template-columns: repeat(2, 1fr); }
    .adt-filter-bar { gap: 20px; justify-content: space-between; }
    .adt-filter-group { width: 48%; min-width: auto; }
  }
  @media (max-width: 600px) {
    .adt-grid { grid-template-columns: 1fr; }
    .adt-filter-group { width: 100%; }
  }
</style>

<div class="adt-adv-section" data-items-per-page="{{ section.settings.items_per_page }}">
  <div class="adt-container">
    
    <div class="adt-header-wrap">
      {% if section.settings.title != blank %}<h2>{{ section.settings.title }}</h2>{% endif %}
      {% if section.settings.subtitle != blank %}
        <div>{{ section.settings.subtitle }}</div>
      {% endif %}
    </div>

    <div class="adt-filter-bar" id="adt-filter-bar">
      
      {% if section.settings.filter_1_label != blank %}
        <div class="adt-filter-group">
          <label class="adt-filter-label">{{ section.settings.filter_1_label }}</label>
          <div class="adt-select-wrapper">
            <select class="adt-select" onchange="applyFilters('{{ section.id }}')" id="filter-1-{{ section.id }}">
              <option value="all">All {{ section.settings.filter_1_label }}</option>
            </select>
            <div class="adt-select-arrow"></div>
          </div>
        </div>
      {% endif %}

      {% if section.settings.filter_2_label != blank %}
        <div class="adt-filter-group">
          <label class="adt-filter-label">{{ section.settings.filter_2_label }}</label>
          <div class="adt-select-wrapper">
            <select class="adt-select" onchange="applyFilters('{{ section.id }}')" id="filter-2-{{ section.id }}">
              <option value="all">All {{ section.settings.filter_2_label }}</option>
            </select>
            <div class="adt-select-arrow"></div>
          </div>
        </div>
      {% endif %}

      {% if section.settings.filter_3_label != blank %}
        <div class="adt-filter-group">
          <label class="adt-filter-label">{{ section.settings.filter_3_label }}</label>
          <div class="adt-select-wrapper">
            <select class="adt-select" onchange="applyFilters('{{ section.id }}')" id="filter-3-{{ section.id }}">
              <option value="all">All {{ section.settings.filter_3_label }}</option>
            </select>
            <div class="adt-select-arrow"></div>
          </div>
        </div>
      {% endif %}

    </div>

    <div class="adt-grid" id="adt-grid-{{ section.id }}">
      {% for block in section.blocks %}
        {% assign f1 = block.settings.f1_val | downcase | strip %}
        {% assign f2 = block.settings.f2_val | downcase | strip %}
        {% assign f3 = block.settings.f3_val | downcase | strip %}
        
        <div class="adt-block" 
             data-f1="{{ f1 }}" 
             data-f2="{{ f2 }}" 
             data-f3="{{ f3 }}"
             {{ block.shopify_attributes }}>
          
          <article class="adt-card">
            <div class="adt-card-img-wrap">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: '600x400', crop: 'center' }}" class="adt-card-img" alt="Case Study">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'adt-card-img' }}
              {% endif %}
            </div>

            <div class="adt-card-body">
              {% if block.settings.date != blank %}
                <div class="adt-date">{{ block.settings.date }}</div>
              {% endif %}
              
              <h3 class="adt-title">{{ block.settings.title }}</h3>
              
              <div class="adt-desc">{{ block.settings.description | strip_html | truncatewords: 20 }}</div>

              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="adt-read-more">Read more</a>
              {% endif %}
            </div>
          </article>
        </div>
      {% endfor %}
    </div>

    <div class="adt-pagination" id="adt-pagination-{{ section.id }}"></div>

  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    initFilters('{{ section.id }}');
  });
  if (Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') initFilters('{{ section.id }}');
    });
  }

  function initFilters(id) {
    const blocks = document.querySelectorAll(`#adt-grid-${id} .adt-block`);
    const sets = [new Set(), new Set(), new Set()];

    blocks.forEach(block => {
      const v1 = block.getAttribute('data-f1');
      const v2 = block.getAttribute('data-f2');
      const v3 = block.getAttribute('data-f3');
      if(v1) sets[0].add(v1);
      if(v2) sets[1].add(v2);
      if(v3) sets[2].add(v3);
    });

    populateSelect(`filter-1-${id}`, sets[0]);
    populateSelect(`filter-2-${id}`, sets[1]);
    populateSelect(`filter-3-${id}`, sets[2]);

    applyFilters(id);
  }

  function populateSelect(selectId, set) {
    const sel = document.getElementById(selectId);
    if (!sel) return;
    sel.innerHTML = sel.options[0].outerHTML; 

    set.forEach(val => {
      const displayVal = val.charAt(0).toUpperCase() + val.slice(1);
      const opt = document.createElement('option');
      opt.value = val;
      opt.innerText = displayVal;
      sel.appendChild(opt);
    });
  }

  let currentPage = 1;
  const itemsPerPage = {{ section.settings.items_per_page }};

  window.applyFilters = function(id) {
    currentPage = 1;
    const blocks = Array.from(document.querySelectorAll(`#adt-grid-${id} .adt-block`));
    
    const v1 = document.getElementById(`filter-1-${id}`)?.value || 'all';
    const v2 = document.getElementById(`filter-2-${id}`)?.value || 'all';
    const v3 = document.getElementById(`filter-3-${id}`)?.value || 'all';

    let visible = [];

    blocks.forEach(block => {
      const b1 = block.getAttribute('data-f1');
      const b2 = block.getAttribute('data-f2');
      const b3 = block.getAttribute('data-f3');

      let match = true;
      if (v1 !== 'all' && b1 !== v1) match = false;
      if (v2 !== 'all' && b2 !== v2) match = false;
      if (v3 !== 'all' && b3 !== v3) match = false;

      if (match) {
        block.classList.remove('filtered-out');
        visible.push(block);
      } else {
        block.style.display = 'none';
        block.classList.add('filtered-out');
      }
    });

    renderPagination(visible, id);
  };

  function renderPagination(visibleItems, id) {
    const container = document.getElementById(`adt-pagination-${id}`);
    container.innerHTML = '';
    
    const totalPages = Math.ceil(visibleItems.length / itemsPerPage);

    visibleItems.forEach(item => item.style.display = 'none');

    const start = (currentPage - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    visibleItems.slice(start, end).forEach(item => item.style.display = 'block');

    if (totalPages <= 1) return;

    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement('div');
      btn.className = 'adt-page-btn' + (i === currentPage ? ' active' : '');
      btn.innerText = i;
      btn.onclick = () => {
        currentPage = i;
        renderPagination(visibleItems, id);
        document.getElementById(`adt-grid-${id}`).scrollIntoView({ behavior: 'smooth' });
      };
      container.appendChild(btn);
    }
  }
</script>

{% schema %}
{
  "name": "Advanced Filter Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Case Studies"
    },
    {
      "type": "range",
      "id": "header_size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Description",
      "default": "<p>We are a different kind of workplace technology business. Check out some of our amazing case studies.</p>"
    },
    {
      "type": "header",
      "content": "Filter Style"
    },
    {
      "type": "range",
      "id": "filter_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Filter Bar Size (Text & Box)",
      "default": 15
    },
    {
      "type": "header",
      "content": "Card Typography"
    },
    {
      "type": "range",
