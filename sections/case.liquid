      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Card Title Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "desc_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Filter Settings"
    },
    {
      "type": "text",
      "id": "filter_1_label",
      "label": "Filter 1 Name",
      "default": "Filter by Industry"
    },
    {
      "type": "text",
      "id": "filter_2_label",
      "label": "Filter 2 Name",
      "default": "Filter by Service"
    },
    {
      "type": "text",
      "id": "filter_3_label",
      "label": "Filter 3 Name",
      "default": "Filter by Space"
