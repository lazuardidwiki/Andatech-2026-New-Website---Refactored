{% style %}
/* --- FONTS & LAYOUT --- */
@import url("https://fonts.googleapis.com/css?family=DM+Sans:400,500,700&display=swap");

.calibration-wrapper-{{ section.id }} {
  font-family: 'DM Sans', sans-serif;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 40px 10px;
  text-align: center;
  box-sizing: border-box;
}

/* --- LOGIC (Shopify-Safe) --- */
input[name="calib-tabs-{{ section.id }}"] { display: none; }
.pricing-grid { display: none; width: 100%; animation: fadeIn 0.4s ease; }

#tab-1-{{ section.id }}:checked ~ #grid-1-{{ section.id }} { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
#tab-2-{{ section.id }}:checked ~ #grid-2-{{ section.id }} { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
#tab-3-{{ section.id }}:checked ~ #grid-3-{{ section.id }} { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
#tab-4-{{ section.id }}:checked ~ #grid-4-{{ section.id }} { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }

#tab-1-{{ section.id }}:checked ~ .calibration-tabs label[for="tab-1-{{ section.id }}"],
#tab-2-{{ section.id }}:checked ~ .calibration-tabs label[for="tab-2-{{ section.id }}"],
#tab-3-{{ section.id }}:checked ~ .calibration-tabs label[for="tab-3-{{ section.id }}"],
#tab-4-{{ section.id }}:checked ~ .calibration-tabs label[for="tab-4-{{ section.id }}"] {
  background: #fff;
  color: #000;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

.calibration-tabs {
  display: inline-flex;
  background: #f1f3f5;
  padding: 5px;
  border-radius: 30px;
  margin-bottom: 40px;
  flex-wrap: wrap;
  justify-content: center;
}
.tab-label {
  border: none;
  background: transparent;
  padding: 12px 25px;
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #666;
  cursor: pointer;
  border-radius: 25px;
  transition: all 0.2s ease;
  user-select: none;
}
.tab-label:hover { color: #333; }

@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

/* --- CARDS --- */
.calibration-card {
  flex: 1;
  min-width: 280px;
  max-width: 320px;
  background: white;
  border-radius: 12px;
  padding: 30px 20px;
  box-shadow: 0 5px 20px rgba(0,0,0,0.08);
  border: 1px solid #e1e1e1;
  display: flex;
  flex-direction: column;
  text-align: center;
  position: relative;
  transition: transform 0.2s ease;
  box-sizing: border-box;
  margin-bottom: 20px;
}
.calibration-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.12); }

/* --- COLOR OPTIONS --- */
.calibration-card.grey-plan { background-color: #f8f9fa; border-top: 5px solid #bdc3c7; }
.calibration-card.green-plan { background-color: #f1f8e9; border: 1px solid #c5e1a5; border-top: 5px solid #7cb342; }
.calibration-card.gold-plan { background-color: #fff8e1; border: 1px solid #ffe082; border-top: 5px solid #fbc02d; }
.calibration-card.blue-plan { background-color: #e3f2fd; border: 1px solid #bbdefb; border-top: 5px solid #1e88e5; }
.calibration-card.purple-plan { background-color: #f3e5f5; border: 1px solid #e1bee7; border-top: 5px solid #8e24aa; }

/* Dark Themes */
.calibration-card.dark-plan { background-color: #2b2b2b; color: white; border-top: 5px solid #000; }
.calibration-card.navy-plan { background-color: #0d1b2a; color: white; border-top: 5px solid #34ace0; }
.calibration-card.charcoal-plan { background-color: #333333; color: white; border-top: 5px solid #ff5252; }

/* --- BADGE COLORS --- */
.rec-badge { position: absolute; top: -12px; left: 0; right: 0; margin: auto; width: 120px; background: #f57f17; color: white; font-weight: bold; font-size: 10px; padding: 4px; border-radius: 12px; text-transform: uppercase; letter-spacing: 1px; }

.blue-plan .rec-badge { background: #1976d2; }
.purple-plan .rec-badge { background: #7b1fa2; }
.green-plan .rec-badge { background: #388e3c; }
.gold-plan .rec-badge { background: #fbc02d; color: #000; }
.dark-plan .rec-badge, .navy-plan .rec-badge, .charcoal-plan .rec-badge { background: #ffffff; color: #000; }

/* Typography */
.plan-header h3 { font-size: 20px; margin: 0 0 5px 0; font-weight: 700; color: inherit; }
.plan-header p { font-size: 13px; opacity: 0.7; margin: 0; font-style: italic; min-height: 20px;}
.plan-price { margin: 20px 0; padding-bottom: 20px; border-bottom: 1px solid rgba(0,0,0,0.05); }
.dark-plan .plan-price, .navy-plan .plan-price, .charcoal-plan .plan-price { border-bottom: 1px solid rgba(255,255,255,0.1); }
.plan-price .amount { font-size: 32px; font-weight: 700; display: block; }
.plan-price .unit { font-size: 12px; opacity: 0.8; }

/* Features & Addons */
.plan-features { text-align: left; margin-top: 10px; font-size: 13px; line-height: 1.5; color: inherit; }
.feature-item { margin-bottom: 10px; display: flex; align-items: flex-start; }
.check-icon { color: green; font-weight: bold; margin-right: 8px; min-width: 15px; }
.dark-plan .check-icon, .navy-plan .check-icon, .charcoal-plan .check-icon { color: #69f0ae; } 

.plan-addons { background: rgba(0,0,0,0.03); border-radius: 8px; padding: 15px; margin-top: auto; text-align: left; font-size: 12px; }
.dark-plan .plan-addons, .navy-plan .plan-addons, .charcoal-plan .plan-addons { background: rgba(255,255,255,0.1); }
.addon-title { font-weight: 700; margin-bottom: 8px; display:block; font-size: 11px; text-transform: uppercase; opacity: 0.8;}
.addon-row { display: flex; justify-content: space-between; margin-bottom: 4px; border-bottom: 1px dotted rgba(0,0,0,0.1); padding-bottom:2px;}
.addon-row:last-child { border: none; }

@media (max-width: 768px) {
  .pricing-grid { flex-direction: column; align-items: center; }
  .pricing-grid.active-section { flex-direction: column; align-items: center; }
  .calibration-card { width: 100%; max-width: 350px; margin-bottom: 20px; }
  .calibration-tabs { display: flex; flex-direction: column; width: 100%; border-radius: 15px; }
}
{% endstyle %}

<div class="calibration-wrapper-{{ section.id }}">
  <input type="radio" id="tab-1-{{ section.id }}" name="calib-tabs-{{ section.id }}" checked>
  <input type="radio" id="tab-2-{{ section.id }}" name="calib-tabs-{{ section.id }}">
  <input type="radio" id="tab-3-{{ section.id }}" name="calib-tabs-{{ section.id }}">
  <input type="radio" id="tab-4-{{ section.id }}" name="calib-tabs-{{ section.id }}">

  <div class="calibration-tabs">
    <label for="tab-1-{{ section.id }}" class="tab-label">{{ section.settings.tab1_label }}</label> 
    <label for="tab-2-{{ section.id }}" class="tab-label">{{ section.settings.tab2_label }}</label> 
    <label for="tab-3-{{ section.id }}" class="tab-label">{{ section.settings.tab3_label }}</label>
    <label for="tab-4-{{ section.id }}" class="tab-label">{{ section.settings.tab4_label }}</label>
  </div>

  {% for i in (1..4) %}
    {% capture grid_id %}tab{{ i }}{% endcapture %}
    <div id="grid-{{ i }}-{{ section.id }}" class="pricing-grid">
      {% for block in section.blocks %}
        {% if block.settings.tab_assign == grid_id %}
          <div class="calibration-card {{ block.settings.color }}">
            {% if block.settings.badge != blank %}<span class="rec-badge">{{ block.settings.badge }}</span>{% endif %}
            <div class="plan-header">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.subtitle }}</p>
            </div>
            <div class="plan-price">
              <span class="amount">{{ block.settings.price }}</span>
              <span class="unit">{{ block.settings.unit }}</span>
            </div>
            <div class="plan-features">
              {% assign feats = block.settings.features | newline_to_br | split: '<br />' %}
              {% for f in feats %}
                <div class="feature-item"><span class="check-icon">✓</span> {{ f }}</div>
              {% endfor %}
              {% if block.settings.bottom_note != blank %}
                <div style="font-size: 10px; margin-top: 5px; opacity: 0.7;">{{ block.settings.bottom_note }}</div>
              {% endif %}
            </div>
            {% if block.settings.show_addons %}
              <div class="plan-addons">
                <span class="addon-title">{{ block.settings.addon_title }}</span>
                {% assign adds = block.settings.addons | newline_to_br | split: '<br />' %}
                {% for a in adds %}
                  {% assign p = a | split: '|' %}
                  <div class="addon-row"><span>{{ p[0] }}</span><span>{{ p[1] }}</span></div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Dynamic Pricing Tabs",
  "settings": [
    { "type": "header", "content": "Tab Names" },
    { "type": "text", "id": "tab1_label", "label": "Tab 1 Label", "default": "Personal Users" },
    { "type": "text", "id": "tab2_label", "label": "Tab 2 Label", "default": "Workplace Handheld" },
    { "type": "text", "id": "tab3_label", "label": "Tab 3 Label", "default": "Wall-Mounted & Interlock" },
    { "type": "text", "id": "tab4_label", "label": "Tab 4 Label", "default": "Custom Category" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Pricing Card",
      "settings": [
        { "type": "select", "id": "tab_assign", "label": "Assign to Tab", "options": [
          { "value": "tab1", "label": "Tab 1" },
          { "value": "tab2", "label": "Tab 2" },
          { "value": "tab3", "label": "Tab 3" },
          { "value": "tab4", "label": "Tab 4" }
        ], "default": "tab1" },
        { "type": "header", "content": "Card Style" },
        { "type": "select", "id": "color", "label": "Color Theme", "options": [
          {"value": "grey-plan", "label": "Grey"}, 
          {"value": "green-plan", "label": "Green"}, 
          {"value": "gold-plan", "label": "Gold"}, 
          {"value": "blue-plan", "label": "Light Blue"},
          {"value": "purple-plan", "label": "Lavender"},
          {"value": "dark-plan", "label": "Black (Dark)"},
          {"value": "navy-plan", "label": "Navy (Dark)"},
          {"value": "charcoal-plan", "label": "Charcoal (Dark)"}
        ], "default": "grey-plan" },
        { "type": "text", "id": "badge", "label": "Badge (e.g. Recommended)", "info": "Leave blank to hide" },
        { "type": "header", "content": "Content" },
        { "type": "text", "id": "title", "label": "Plan Name", "default": "Basic Plan" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "for beginners" },
        { "type": "text", "id": "price", "label": "Price", "default": "$50" },
        { "type": "text", "id": "unit", "label": "Unit Text", "default": "per unit / year" },
        { "type": "header", "content": "Features" },
        { "type": "textarea", "id": "features", "label": "Feature List", "default": "Feature 1\nFeature 2\nFeature 3", "info": "One feature per line." },
        { "type": "text", "id": "bottom_note", "label": "Small Note at bottom", "info": "Optional" },
        { "type": "header", "content": "Add-Ons" },
        { "type": "checkbox", "id": "show_addons", "label": "Show Add-ons Section?", "default": true },
        { "type": "text", "id": "addon_title", "label": "Add-ons Title", "default": "Add-Ons" },
        { "type": "textarea", "id": "addons", "label": "Add-on List", "default": "Shipping|$10\nPriority|$25", "info": "Format: Name|Price (One per line)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dynamic Pricing Tabs",
      "blocks": [
        { "type": "card", "settings": { "tab_assign": "tab1", "title": "No Plan", "price": "$55", "color": "grey-plan" } },
        { "type": "card", "settings": { "tab_assign": "tab1", "title": "Starter Plan", "price": "$90", "color": "green-plan" } },
        { "type": "card", "settings": { "tab_assign": "tab1", "title": "SmartCare", "price": "$145", "color": "gold-plan", "badge": "Recommended" } }
      ]
    }
  ]
}
{% endschema %}