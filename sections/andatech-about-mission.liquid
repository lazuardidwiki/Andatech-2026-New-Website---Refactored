{{ 'andatech-site.css' | asset_url | stylesheet_tag }}
{{ 'andatech-about.css' | asset_url | stylesheet_tag }}

<section class="at-about-mission at-about-section"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %}>
  <div class="at-shell at-about-mission__grid">
    {%- if section.settings.image != blank -%}
      <div class="at-about-mission__media">
        {{ section.settings.image | image_url: width: 800 | image_tag: class: 'at-about-mission__image', widths: '200, 400, 600, 800', sizes: '(min-width: 1280px) 320px, (min-width: 768px) 28vw, 200px', loading: 'lazy', alt: section.settings.image_alt | default: section.settings.heading }}
      </div>
    {%- endif -%}
    <div class="at-about-mission__copy">
      {%- assign heading_tag = section.settings.heading_tag | default: 'h3' -%}
      {%- if section.settings.heading != blank -%}<{{ heading_tag }} class="at-about-mission__title">{{ section.settings.heading }}</{{ heading_tag }}>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="at-about-mission__body">{{ section.settings.body }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About — Mission",
  "tag": "section",
  "class": "at-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor", "default": "about-mission" },
    { "type": "image_picker", "id": "image", "label": "Logo / icon" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Innovations for life, since 2003" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ],
      "default": "h3"
    },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>For more than 20 years, we've been committed to creating safer workplaces, roads, and communities. The use of alcohol and drugs are significant issues for our society, and our solutions help you make informed decisions.</p><p>We offer a broad selection of alcohol and drug testing solutions to support the needs of all Australians.</p>" }
  ],
  "presets": [
    { "name": "About — Mission" }
  ]
}
{% endschema %}