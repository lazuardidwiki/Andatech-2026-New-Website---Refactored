{%- comment -%} Andatech — Why a Managed Program Matters.
  Two-column layout: left column has eyebrow, heading, body text + accordion;
  right column has a sticky image card.
  Accordion uses the same visual pattern as the homepage Solutions section.
{%- endcomment -%}

{{ 'andatech-site.css' | asset_url | stylesheet_tag }}
{{ 'andatech-industry.css' | asset_url | stylesheet_tag }}
{{ 'andatech-mcp.css' | asset_url | stylesheet_tag }}

<section class="at-mcp-why" id="{{ section.settings.anchor_id | default: section.id | handleize }}">
  <div class="at-shell">
    <div class="at-mcp-why__grid">
      <div class="at-mcp-why__left">
        {%- if section.settings.eyebrow != blank -%}<p class="at-industry__eyebrow" data-at-rise>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="at-industry__title" data-at-rise>{{ section.settings.heading | escape }}{% if section.settings.heading_bold != blank %}<br><strong>{{ section.settings.heading_bold | escape }}</strong>{% endif %}</h2>
        {%- if section.settings.desc != blank -%}<div class="at-mcp-why__desc" data-at-rise>{{ section.settings.desc }}</div>{%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="at-mcp-why__right" data-at-rise>
          <img src="{{ section.settings.image | image_url: width: 1200 }}"
               alt="{{ section.settings.image_alt | default: section.settings.image.alt | default: section.settings.heading_bold | escape }}"
               width="{{ section.settings.image.width }}"
               height="{{ section.settings.image.height }}"
               loading="lazy">
        </div>
      {%- endif -%}
    </div>

    <div class="at-mcp-why__accordion">
      {%- for block in section.blocks -%}
        {%- liquid
          assign answer_text = block.settings.text
          assign answer_text = answer_text | replace: '<p>Are appropriate people trained to undertake specimen collection and understand their responsibilities?</p>', '<p>Appropriate people are trained to undertake specimen collection and understand their responsibilities.</p>'
          assign answer_text = answer_text | replace: '<p>Are collection, documentation and chain-of-custody procedures consistently applied?</p>', '<p>Collection, documentation and chain-of-custody procedures are applied consistently.</p>'
          assign answer_text = answer_text | replace: '<p>Are privacy, dignity, informed consent and confidentiality understood throughout collection?</p>', '<p>Privacy, dignity, informed consent and confidentiality are understood and upheld throughout collection.</p>'
          assign answer_text = answer_text | replace: '<p>Are appropriate records maintained to support the integrity of the testing process?</p>', '<p>Appropriate records are maintained to support the integrity of the testing process.</p>'
          assign answer_text = answer_text | replace: '<p>Can the same procedures be applied across people, shifts, sites and locations?</p>', '<p>The same procedures are applied consistently across people, shifts, sites and locations.</p>'
        -%}
        <details class="at-mcp-why__item"{% if forloop.first %} open{% endif %} data-at-rise {{ block.shopify_attributes }}>
          <summary class="at-mcp-why__trigger">
            <span class="at-mcp-why__item-title">{{ block.settings.heading | escape }}</span>
            <svg class="at-mcp-why__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 9 7 7 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="at-mcp-why__answer">
            <div class="at-mcp-why__answer-text rte">{{ answer_text }}</div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MCP Why Managed",
  "tag": "section",
  "class": "at-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor", "default": "whos-behind" },
    { "type": "header", "content": "Left column" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why a Managed Program Matters" },
    { "type": "text", "id": "heading", "label": "H2 — Heading (light)", "default": "Workplace testing isn't just" },
    { "type": "text", "id": "heading_bold", "label": "H2 — Heading (bold)", "default": "about performing a test." },
    { "type": "richtext", "id": "desc", "label": "Body", "default": "<p>Organisations can invest in quality testing technology and still have weaknesses in their program if the people administering the process don't have appropriate skills, knowledge, procedures and support.</p>" },
    { "type": "header", "content": "Right card" },
    { "type": "image_picker", "id": "image", "label": "Card background image", "info": "Sticky image card alongside the accordion. Leave blank for a single-column layout." },
    { "type": "text", "id": "image_alt", "label": "Image alt text" }
  ],
  "blocks": [{ "type": "question", "name": "Question", "limit": 10, "settings": [
    { "type": "text", "id": "heading", "label": "Question", "default": "Do we have the right people?" },
    { "type": "richtext", "id": "text", "label": "Answer", "default": "<p>Appropriate people are trained, competent and confident in their role.</p>" }
  ] }],
  "presets": [{ "name": "MCP Why Managed", "blocks": [
    { "type": "question", "settings": { "heading": "Do we have the right people?", "text": "<p>Appropriate people are trained to undertake specimen collection and understand their responsibilities.</p>" } },
    { "type": "question", "settings": { "heading": "Are we following the right process?", "text": "<p>Collection, documentation and chain-of-custody procedures are applied consistently.</p>" } },
    { "type": "question", "settings": { "heading": "Are employees treated appropriately?", "text": "<p>Privacy, dignity, informed consent and confidentiality are understood and upheld throughout collection.</p>" } },
    { "type": "question", "settings": { "heading": "Can we demonstrate what happened?", "text": "<p>Appropriate records are maintained to support the integrity of the testing process.</p>" } },
    { "type": "question", "settings": { "heading": "Is our program consistent?", "text": "<p>The same procedures are applied consistently across people, shifts, sites and locations.</p>" } }
  ] }]
}
{% endschema %}
