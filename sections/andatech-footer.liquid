{%- comment -%}
  Andatech — Footer.

  Ported from the Phase 1 prototype. All classes are `at-` prefixed and styled by
  andatech-site.css, which is generated by Nexus/scripts/to-theme.mjs.

  The link column and the legal row are driven by menus (Content → Menus) so they
  stay merchant-managed. The contact column is plain settings because it is prose,
  not navigation. Social icons are blocks — one per platform.

  Schema `tag` is `div`, not `footer`: the markup below already emits the real
  <footer> landmark, and Shopify's section wrapper would otherwise nest a second
  one inside it.
{%- endcomment -%}

{%- comment -%}
  Split from andatech-site.css on 2026-09-05. This section now loads its own
  scoped footer stylesheet (3.8 KB) instead of the 336 KB monolith. It also
  no longer re-loads andatech-site.js — the header section already loads it
  on every page. The footer has no JS of its own.
{%- endcomment -%}
{{ 'andatech-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign link_menu  = linklists[section.settings.menu]
  assign legal_menu = linklists[section.settings.legal_menu]
-%}

<footer class="at-footer">
  <div class="at-shell">

     {%- if section.settings.logo != blank -%}
          <img class="at-footer__logo"
               src="{{ section.settings.logo | image_url: width: 420 }}"
               alt="{{ shop.name | escape }}"
               width="{{ section.settings.logo.width }}"
               height="{{ section.settings.logo.height }}"
               loading="lazy">
        {%- endif -%}

    <div class="at-footer__top">

      {%- comment -%} ── Contact column ──────────────────────────────── {%- endcomment -%}
      <div>
       

        {%- if section.settings.contact_heading != blank -%}
          {%- assign contact_heading_tag = section.settings.contact_heading_tag | default: 'h4' -%}
          <{{ contact_heading_tag }} class="at-footer__heading">{{ section.settings.contact_heading | escape }}</{{ contact_heading_tag }}>
        {%- endif -%}

        {%- if section.settings.address != blank -%}
          <p class="at-footer__block">{{ section.settings.address | escape | newline_to_br }}</p>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <p class="at-footer__block">{{ section.settings.hours | escape | newline_to_br }}</p>
        {%- endif -%}

        {%- if section.settings.link_1_label != blank -%}
          <a class="at-footer__strong" href="{{ section.settings.link_1_url | default: '#' }}">{{ section.settings.link_1_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.link_2_label != blank -%}
          <a class="at-footer__strong" href="{{ section.settings.link_2_url | default: '#' }}">{{ section.settings.link_2_label | escape }}</a>
        {%- endif -%}
      </div>

      {%- comment -%} ── Menu column ─────────────────────────────────── {%- endcomment -%}
      <div>
        {%- if section.settings.menu_heading != blank -%}
          {%- assign menu_heading_tag = section.settings.menu_heading_tag | default: 'h4' -%}
          <{{ menu_heading_tag }} class="at-footer__heading">{{ section.settings.menu_heading | escape }}</{{ menu_heading_tag }}>
        {%- endif -%}
        {%- if link_menu.links.size > 0 -%}
          <ul class="at-footer__list">
            {%- for link in link_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- elsif request.design_mode -%}
          <p class="at-footer__block">Pick a menu under <strong>Link column</strong> to fill this column.</p>
        {%- endif -%}
      </div>

      {%- comment -%} ── Accreditations + social ─────────────────────── {%- endcomment -%}
      <div class="at-footer__aside">
        {%- if section.settings.certs != blank -%}
          <img class="at-footer__certs"
               src="{{ section.settings.certs | image_url: width: 528 }}"
               alt="{{ section.settings.certs.alt | escape }}"
               loading="lazy">
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="at-footer__social">
            {%- for block in section.blocks -%}
              {%- if block.type == 'social' -%}
                <a href="{{ block.settings.url | default: '#' }}"
                   aria-label="{{ block.settings.platform | capitalize }}"
                   {{ block.shopify_attributes }}>
                  {%- case block.settings.platform -%}
                    {%- when 'facebook' -%}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 9h2.5V6H14c-2 0-3.4 1.4-3.4 3.4V11H8.5v3h2.1v7h3v-7h2.3l.4-3h-2.7V9.6c0-.4.2-.6.4-.6Z" fill="currentColor"/></svg>
                    {%- when 'youtube' -%}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21.6 8.2a2.5 2.5 0 0 0-1.8-1.8C18.2 6 12 6 12 6s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 8.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 3.8 2.5 2.5 0 0 0 1.8 1.8C5.8 18 12 18 12 18s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-3.8ZM10 15V9l5 3-5 3Z" fill="currentColor"/></svg>
                    {%- when 'instagram' -%}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3.4" fill="currentColor"/></svg>
                    {%- when 'tiktok' -%}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 4h2.6a5 5 0 0 0 4 4v2.7a7.6 7.6 0 0 1-4-1.2v5.9a5.4 5.4 0 1 1-5.4-5.4c.3 0 .6 0 .8.1v2.8a2.6 2.6 0 1 0 1.9 2.5V4Z" fill="currentColor"/></svg>
                    {%- when 'linkedin' -%}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.9 8.4H4.2V20h2.7V8.4ZM5.5 4a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2ZM20 13.6c0-3-1.6-4.4-3.8-4.4a3.3 3.3 0 0 0-3 1.6V8.4H10.6V20h2.7v-6c0-1.4.6-2.2 1.9-2.2s1.9.8 1.9 2.2v6H20v-6.4Z" fill="currentColor"/></svg>
                    {%- when 'x' -%}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h4.2l4 5.6L16.8 4H20l-6.3 7.7L20.4 20h-4.2l-4.3-6-5 6H4l6.6-8L4 4Z" fill="currentColor"/></svg>
                  {%- endcase -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

    </div>

    <div class="at-footer__bottom">
      {%- if section.settings.copyright != blank -%}
        <p class="at-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | escape }}</p>
      {%- endif -%}
      {%- if legal_menu.links.size > 0 -%}
        <div class="at-footer__legal">
          {%- for link in legal_menu.links -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</footer>

{% schema %}
{ "name": "Andatech Footer", "tag": "div", "class": "at-footer-section",
  "settings": [
    { "type": "header", "content": "Contact column" },
    { "type": "image_picker", "id": "logo", "label": "Logo",
      "info": "Dark-mode logo — the white wordmark. The navy one disappears on this background." },
    { "type": "text", "id": "contact_heading", "label": "Heading", "default": "Contact Us" },
    { "type": "select", "id": "contact_heading_tag", "label": "Contact Heading HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ], "default": "h4" },
    { "type": "textarea", "id": "address", "label": "Address", "info": "Line breaks are preserved.",
      "default": "Address:\n9 Trade Pl, Vermont VIC 3133" },
    { "type": "textarea", "id": "hours", "label": "Business hours", "info": "Line breaks are preserved.",
      "default": "Business Hours:\nMonday to Friday, 9AM to 5:30PM (AEST)" },
    { "type": "text", "id": "link_1_label", "label": "Emphasised link 1", "default": "Request information" },
    { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
    { "type": "text", "id": "link_2_label", "label": "Emphasised link 2", "default": "Service information" },
    { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
    { "type": "header", "content": "Link column" },
    { "type": "text", "id": "menu_heading", "label": "Heading", "default": "Solutions" },
    { "type": "select", "id": "menu_heading_tag", "label": "Menu Heading HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ], "default": "h4" },
    { "type": "link_list", "id": "menu", "label": "Menu",
      "info": "Top-level links only — this column does not nest.", "default": "footer" },
    { "type": "header", "content": "Accreditations" },
    { "type": "image_picker", "id": "certs", "label": "Accreditation strip",
      "info": "The ISO / NATA / ILAC-MRA lockup. Describe the logos in the image's alt text." },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright", "label": "Copyright holder",
      "info": "The year is added automatically.", "default": "Andatech. All rights reserved." },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "default": "footer" } ],
  "blocks": [
    { "type": "social", "name": "Social link", "limit": 8, "settings": [
      { "type": "select", "id": "platform", "label": "Platform", "default": "facebook",
        "options": [
          { "value": "facebook",  "label": "Facebook" },
          { "value": "youtube",   "label": "YouTube" },
          { "value": "instagram", "label": "Instagram" },
          { "value": "tiktok",    "label": "TikTok" },
          { "value": "linkedin",  "label": "LinkedIn" },
          { "value": "x",         "label": "X" } ] },
      { "type": "url", "id": "url", "label": "Profile URL" } ] } ],
  "presets": [ { "name": "Andatech Footer", "blocks": [
    { "type": "social", "settings": { "platform": "facebook" } },
    { "type": "social", "settings": { "platform": "youtube" } },
    { "type": "social", "settings": { "platform": "instagram" } },
    { "type": "social", "settings": { "platform": "tiktok" } },
    { "type": "social", "settings": { "platform": "linkedin" } } ] } ] }
{% endschema %}