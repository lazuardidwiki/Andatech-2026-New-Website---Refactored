{%- comment -%} Andatech — Trust / stats. Generated from the Phase 1 prototype.
  Classes are `at-` prefixed; styling lives in andatech-site.css. {%- endcomment -%}

{{ 'andatech-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'andatech-homepage.js' | asset_url }}" defer="defer"></script>
{{ 'andatech-industry.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign at_trust_stat_count = 0
  assign at_trust_logo_count = 0
  for block in section.blocks
    if block.type == 'stat'
      assign at_trust_stat_count = at_trust_stat_count | plus: 1
    endif
    if block.type == 'logo' and block.settings.image != blank
      assign at_trust_logo_count = at_trust_logo_count | plus: 1
    endif
  endfor
-%}

<section class="at-trust{% if section.settings.industry_layout or template.suffix == 'landing-heavy-industry' %} at-trust--industry{% endif %}{% if at_trust_logo_count == 0 %} at-trust--stats-only{% endif %}" id="{{ section.settings.anchor_id | default: section.id | handleize }}">
  <div class="at-shell at-trust__inner">
    {%- if section.settings.intro_line != blank or section.settings.certs != blank -%}
      <div class="at-trust__intro" data-at-rise>
        {%- if section.settings.intro_line != blank -%}<div class="at-trust__intro-line">{{ section.settings.intro_line }}</div>{%- endif -%}
        {%- if section.settings.certs != blank -%}<img class="at-trust__intro-certs" src="{{ section.settings.certs | image_url: width: 678 }}" alt="{{ section.settings.certs.alt | escape }}" loading="lazy">{%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="at-trust__industry-header">
        {%- if section.settings.eyebrow != blank -%}{%- assign eyebrow_tag = section.settings.eyebrow_tag | default: 'h2' -%}<{{ eyebrow_tag }} class="at-industry__eyebrow" data-at-rise>{{ section.settings.eyebrow | escape }}</{{ eyebrow_tag }}>{%- endif -%}
        {%- if section.settings.heading != blank -%}{%- assign heading_tag = section.settings.heading_tag | default: 'h3' -%}<{{ heading_tag }} class="at-industry__title" data-at-rise>{{ section.settings.heading | escape }}{% if section.settings.heading_bold != blank %}<br><strong>{{ section.settings.heading_bold | escape }}</strong>{% endif %}</{{ heading_tag }}>{%- endif -%}
        {%- if section.settings.description != blank -%}<div class="at-industry__desc" data-at-rise>{{ section.settings.description }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="at-trust__stats at-trust__stats--{{ at_trust_stat_count }}">
      {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}
        <div class="at-trust__stat" data-at-rise {{ block.shopify_attributes }}>
          {%- assign trustNumberRaw = block.settings.number | strip -%}
          {%- assign trustNumChars = trustNumberRaw | split: '' -%}
          {%- assign trustDigits = '' -%}
          {%- assign trustSuffix = '' -%}
          {%- assign trustSuffixStart = false -%}
          {%- for ch in trustNumChars -%}
            {%- if trustSuffixStart == false and ch != '0' and ch != '1' and ch != '2' and ch != '3' and ch != '4' and ch != '5' and ch != '6' and ch != '7' and ch != '8' and ch != '9' -%}
              {%- assign trustSuffixStart = true -%}
            {%- endif -%}
            {%- if trustSuffixStart -%}{%- assign trustSuffix = trustSuffix | append: ch -%}
            {%- else -%}{%- assign trustDigits = trustDigits | append: ch -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign trustNumberLength = trustNumberRaw | size -%}
          <span class="at-trust__number" style="min-width: {{ trustNumberLength }}ch">{%- if trustDigits != blank -%}<span class="at-trust__count" data-at-count-to="{{ trustDigits | escape }}">{{ trustDigits | escape }}</span>{%- endif -%}{{ trustSuffix | escape }}</span>
          <span class="at-trust__label">{{ block.settings.label | escape }}</span>
          <span class="at-trust__detail">{{ block.settings.detail | escape }}</span>
        </div>
      {%- endif -%}{%- endfor -%}
    </div>
    <div class="at-trust__logos" data-at-rise>
      {%- if section.settings.logos_label != blank -%}<p class="at-trust__logos-label">{{ section.settings.logos_label | escape }}</p>{%- endif -%}
      <div class="at-trust__logo-row">
        {%- for block in section.blocks -%}{%- if block.type == 'logo' and block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" style="--at-trust-logo-width: {{ block.settings.display_width | default: 160 }}px" {{ block.shopify_attributes }}>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- if section.settings.more_label != blank -%}<p class="at-trust__more">{{ section.settings.more_label | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Andatech Trust", "tag": "section", "class": "at-section",
  "settings": [
    { "type": "checkbox", "id": "industry_layout", "label": "Use industry-page layout", "default": false },
    { "type": "text", "id": "anchor_id", "label": "Section anchor" },
    { "type": "header", "content": "Industry-page introduction" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "select", "id": "eyebrow_tag", "label": "Eyebrow HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ], "default": "h2" },
    { "type": "text", "id": "heading", "label": "H2 — Heading (light)" },
    { "type": "select", "id": "heading_tag", "label": "Heading HTML Tag",
      "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ], "default": "h3" },
    { "type": "text", "id": "heading_bold", "label": "H2 — Heading (bold)" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "header", "content": "Mobile intro card" },
    { "type": "richtext", "id": "intro_line", "label": "Intro line", "info": "Shown on mobile only.", "default": "<p>Australia's NATA-accredited drug & alcohol specialist since 2003.</p>" },
    { "type": "image_picker", "id": "certs", "label": "Accreditation strip" },
    { "type": "header", "content": "Logos" },
    { "type": "text", "id": "logos_label", "label": "Logos heading", "default": "Trusted by organisations across Australia" },
    { "type": "text", "id": "more_label", "label": "Trailing note", "default": "and many more" } ],
  "blocks": [
    { "type": "stat", "name": "Stat", "limit": 6, "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "22+" },
      { "type": "text", "id": "label", "label": "Label", "default": "Years of expertise" },
      { "type": "text", "id": "detail", "label": "Detail", "default": "since 2003" } ] },
    { "type": "logo", "name": "Logo", "limit": 12, "settings": [
      { "type": "image_picker", "id": "image", "label": "Logo" },
      { "type": "range", "id": "display_width", "label": "Logo display width", "min": 40, "max": 240, "step": 4, "unit": "px", "default": 160 } ] } ],
  "presets": [ { "name": "Andatech Trust", "blocks": [ { "type": "stat" }, { "type": "stat" }, { "type": "stat" } ] } ] }
{% endschema %}
