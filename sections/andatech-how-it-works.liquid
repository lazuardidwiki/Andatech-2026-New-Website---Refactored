{%- comment -%} Andatech — How it works. Generated from the Phase 1 prototype.
  Classes are `at-` prefixed; styling lives in andatech-site.css. {%- endcomment -%}

{{ 'andatech-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'andatech-homepage.js' | asset_url }}" defer="defer"></script>

<section class="at-stepper"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %}>
  <div class="at-shell at-stepper__inner">
    <div class="at-stepper__left">
      {%- if section.settings.image != blank -%}
        <div class="at-stepper__media" data-at-rise><img src="{{ section.settings.image | image_url: width: 1440 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy"></div>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}<p class="at-stepper__eyebrow" data-at-rise>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="at-stepper__title" data-at-rise>{{ section.settings.heading | escape }}{% if section.settings.heading_bold != blank %}<br><strong>{{ section.settings.heading_bold | escape }}</strong>{% endif %}</h2>
      {%- if section.settings.desc != blank -%}<div class="at-stepper__desc" data-at-rise>{{ section.settings.desc }}</div>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}<a class="at-btn at-btn--green" href="{{ section.settings.cta_url | default: '#' }}" data-at-rise>{{ section.settings.cta_label | escape }} <i class="at-btn__arrow" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="m10 5.5 6.5 6.5-6.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></i></a>{%- endif -%}
    </div>

    <div class="at-stepper__right">
      {%- for block in section.blocks -%}
        <div class="at-stepper__step{% if forloop.first %} at-stepper__step--active{% endif %}" data-at-rise {{ block.shopify_attributes }}>
          {%- if block.settings.pill != blank -%}<span class="at-stepper__week"{% unless forloop.first %} hidden{% endunless %}>{{ block.settings.pill | escape }}</span>{%- endif -%}
          <button class="at-stepper__row" type="button" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
            <span class="at-stepper__num">{{ forloop.index }}</span>
            <div class="at-stepper__step-body">
              <h3 class="at-stepper__step-title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.desc != blank -%}<div class="at-stepper__step-desc">{{ block.settings.desc }}</div>{%- endif -%}
            </div>
          </button>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Andatech How It Works", "tag": "section", "class": "at-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor", "info": "Optional. Used by in-page navigation." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Works" },
    { "type": "text", "id": "heading", "label": "H2 — Heading (light)", "default": "A program that runs" },
    { "type": "text", "id": "heading_bold", "label": "H2 — Heading (bold)", "default": "without running you." },
    { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Most workplaces don't fail an audit because they lack equipment. They fail because nobody owned the process. Here's who owns what.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "See How It Works" },
    { "type": "url", "id": "cta_url", "label": "Button link" } ],
  "blocks": [ { "type": "step", "name": "Step", "limit": 8, "settings": [
      { "type": "paragraph", "content": "Steps are numbered automatically. The first step is open by default; visitors click a step to open it." },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "desc", "label": "Description" },
      { "type": "text", "id": "pill", "label": "Pill label", "info": "Small teal outline pill above the step, e.g. Week 1." } ] } ],
  "presets": [ { "name": "Andatech How It Works", "blocks": [
    { "type": "step", "settings": { "title": "We map your obligations.", "pill": "Week 1", "desc": "<p>Your industry, your standards, your roster patterns and sites. We write the testing policy around what you're actually accountable for.</p>" } },
    { "type": "step", "settings": { "title": "Devices arrive configured", "desc": "<p>Breathalysers, drug-testing kits, calibration gas and consumables arrive pre-configured, enrolled in Andalink and ready to use on day one.</p>" } },
    { "type": "step", "settings": { "title": "Testing runs, we keep it current", "desc": "<p>Calibration reminders, consumable top-ups, software updates and training refreshers are scheduled and tracked for you.</p>" } },
    { "type": "step", "settings": { "title": "Evidence is ready before you're asked", "desc": "<p>Audit logs, certificates and compliance reports sit in Andalink — downloadable the moment an auditor asks for them.</p>" } } ] } ] }
{% endschema %}
