<div class="andatech-card-container" style="
  --brand-color: {{ section.settings.brand_color }};
  --glow-intensity: {{ section.settings.glow_strength }}px;
">
  <div class="card">
    <div class="background"></div>
    <div class="logo">
      {%- if section.settings.main_logo != blank -%}
        {{ section.settings.main_logo | image_url: width: 200 | image_tag: class: 'logo-img' }}
      {%- else -%}
        <div class="placeholder-logo">A</div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" class="box box{{ forloop.index }}" style="--hover-bg: {{ block.settings.hover_color }}; transition-delay: {{ forloop.index0 | times: 0.1 }}s;">
        <span class="icon">
          {%- case block.settings.icon_type -%}
            {%- when 'instagram' -%}
              <svg viewBox="0 0 24 24" fill="white"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.266.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            {%- when 'linkedin' -%}
              <svg viewBox="0 0 24 24" fill="white"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/></svg>
            {%- when 'tiktok' -%}
              <svg viewBox="0 0 24 24" fill="white"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.9-.32-1.98-.23-2.81.33-.85.51-1.44 1.43-1.58 2.41-.14 1.01.23 2.08.94 2.79.69.72 1.74 1.07 2.74.9 1.05-.16 1.97-.93 2.27-1.93.02-3.06.01-6.13.01-9.2z"/></svg>
            {%- when 'facebook' -%}
              <svg viewBox="0 0 24 24" fill="white"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          {%- endcase -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Andatech Glow Card",
  "settings": [
    {
      "type": "color",
      "id": "brand_color",
      "label": "Card Brand Color",
      "default": "#8dc63f"
    },
    {
      "type": "range",
      "id": "glow_strength",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Icon Glow Intensity",
      "default": 10
    },
    {
      "type": "image_picker",
      "id": "main_logo",
      "label": "Main Logo (WebP recommended)"
    }
  ],
  "blocks": [
    {
      "type": "platform",
      "name": "Social Platform",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Select Icon",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "linkedin", "label": "LinkedIn" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "facebook", "label": "Facebook" }
          ],
          "default": "instagram"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Social Link"
        },
        {
          "type": "color",
          "id": "hover_color",
          "label": "Hover Background Color",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Andatech Glow Card",
      "blocks": [
        { "type": "platform", "settings": { "icon_type": "instagram", "hover_color": "#E1306C" } },
        { "type": "platform", "settings": { "icon_type": "linkedin", "hover_color": "#0077B5" } },
        { "type": "platform", "settings": { "icon_type": "tiktok", "hover_color": "#000000" } },
        { "type": "platform", "settings": { "icon_type": "facebook", "hover_color": "#1877F2" } }
      ]
    }
  ]
}
{% endschema %}

<style>
.andatech-card-container {
  display: flex;
  justify-content: center;
  padding: 50px 0;
}
.card {
  position: relative;
  width: 200px;
  height: 200px;
  background: #f4f4f4;
  border-radius: 30px;
  overflow: hidden;
  box-shadow: rgba(0, 0, 0, 0.1) 0px 7px 29px 0px;
  transition: all 0.8s ease-in-out;
}
.background {
  position: absolute;
  inset: 0;
  background: var(--brand-color);
  opacity: 0.95;
}
.logo {
  position: absolute;
  right: 50%;
  bottom: 50%;
  transform: translate(50%, 50%);
  transition: all 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.logo-img {
  width: 60px;
  height: 60px;
  object-fit: contain;
  filter: brightness(0) invert(1);
}
.box {
  position: absolute;
  padding: 10px;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(5px);
  border-top: 2px solid rgba(255, 255, 255, 0.5);
  border-radius: 10% 13% 42% 0% / 10% 12% 75% 0%;
  transform-origin: bottom left;
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
}
.box1 { width: 75%; height: 75%; bottom: -75%; left: -75%; }
.box2 { width: 55%; height: 55%; bottom: -55%; left: -55%; }
.box3 { width: 35%; height: 35%; bottom: -35%; left: -35%; }
.box4 { width: 18%; height: 18%; bottom: -18%; left: -18%; }

.card:hover .box { bottom: -1px; left: -1px; }
.card:hover .logo { transform: translate(0, 0); bottom: 15px; right: 15px; }

.icon svg {
  width: 22px;
  height: 22px;
  transition: all 0.4s ease;
}

/* THE GLOW EFFECT */
.box:hover {
  background: var(--hover-bg) !important;
}
.box:hover svg {
  filter: drop-shadow(0 0 var(--glow-intensity) white);
  transform: scale(1.1);
}
</style>