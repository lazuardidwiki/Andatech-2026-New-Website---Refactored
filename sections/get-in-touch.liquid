{% comment %}
  Get In Touch Section (With Country & Auto-Phone Code)
  - Layout: Text Left, Form Right.
  - Feature: Selecting a Country auto-fills the Phone country code.
{% endcomment %}

<style>
  @import url("https://fonts.googleapis.com/css?family=DM+Sans:400,500,700&display=swap");

  #shopify-section-{{ section.id }} .contact-section-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
    font-family: 'DM Sans', sans-serif;
    color: {{ section.settings.text_color }};
  }

  .contact-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 60px;
    justify-content: space-between;
    align-items: flex-start;
  }

  /* --- LEFT COLUMN (Text) --- */
  .contact-text-col {
    flex: 1 1 350px;
    max-width: 450px;
    text-align: left;
  }

  .contact-heading {
    font-size: 32px;
    font-weight: 700;
    color: inherit;
    margin-bottom: 20px;
    line-height: 1.2;
  }

  .contact-desc {
    font-size: 16px;
    line-height: 1.6;
    color: inherit;
    opacity: 0.8;
    margin-bottom: 40px;
  }

  .contact-details-box {
    font-size: 14px;
    line-height: 1.8;
    border-top: 1px solid rgba(0,0,0,0.1);
    padding-top: 30px;
  }

  .detail-line {
    display: block;
    margin-bottom: 5px;
  }
  
  .detail-line strong {
    font-weight: 700;
    margin-right: 5px;
  }

  /* --- RIGHT COLUMN (Form) --- */
  .contact-form-col {
    flex: 1 1 600px;
    width: 100%;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); 
    gap: 20px;
  }

  .span-1 { grid-column: span 1; }
  .span-2 { grid-column: span 2; }
  .span-3 { grid-column: span 3; }

  .field-group {
    display: flex;
    flex-direction: column;
  }

  .field-group label {
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 8px;
    color: inherit;
  }

  .field-group input, 
  .field-group select, 
  .field-group textarea {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #e1e1e1;
    border-radius: 4px;
    font-size: 14px;
    background: #fff;
    color: #333;
    font-family: inherit;
    outline: none;
    transition: border 0.3s;
  }

  .field-group input:focus, 
  .field-group select:focus, 
  .field-group textarea:focus {
    border-color: {{ section.settings.btn_bg_color }};
  }
  
  .field-group textarea {
    min-height: 120px;
    resize: vertical;
  }

  .contact-submit-btn {
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    border: none;
    padding: 12px 30px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    margin-top: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: opacity 0.3s;
    width: auto;
    justify-self: start;
  }

  .contact-submit-btn:hover {
    opacity: 0.9;
  }

  .form-status { margin-bottom: 20px; font-weight: bold; }
  .form-status-list { color: red; list-style: none; padding: 0; margin-bottom: 20px;}

  @media (max-width: 900px) {
    .form-grid {
      grid-template-columns: 1fr; 
    }
    .span-1, .span-2, .span-3 { grid-column: span 1; }
    
    .contact-container {
      flex-direction: column;
      gap: 40px;
    }
    .contact-text-col {
      max-width: 100%;
    }
  }
</style>

<div class="contact-section-wrapper">
  <div class="contact-container">
    
    <div class="contact-text-col">
      {% if section.settings.heading != blank %}
        <h2 class="contact-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      
      {% if section.settings.description != blank %}
        <div class="contact-desc">{{ section.settings.description | newline_to_br }}</div>
      {% endif %}

      <div class="contact-details-box">
        {% if section.settings.address != blank %}
          <span class="detail-line"><strong>Office Location:</strong> {{ section.settings.address }}</span>
        {% endif %}
        {% if section.settings.phone != blank %}
          <span class="detail-line"><strong>Toll-Free (Aus):</strong> {{ section.settings.phone }}</span>
        {% endif %}
        {% if section.settings.support_email != blank %}
          <span class="detail-line"><strong>Support:</strong> {{ section.settings.support_email }}</span>
        {% endif %}
        {% if section.settings.sales_phone != blank %}
          <span class="detail-line"><strong>Sales:</strong> {{ section.settings.sales_phone }}</span>
        {% endif %}
      </div>
    </div>

    <div class="contact-form-col">
      {% form 'contact' %}
        
        {% if form.posted_successfully? %}
          <p class="form-status" style="color: #7ab53d;">
            Thanks for contacting us! We'll get back to you shortly.
          </p>
        {% elsif form.errors %}
          <ul class="form-status-list">
            {{ form.errors | default_errors }}
          </ul>
        {% endif %}

        <div class="form-grid">
          
          <div class="field-group span-1">
            <label for="ContactFormFirstName">First name*</label>
            <input type="text" id="ContactFormFirstName" name="contact[first_name]" required>
          </div>

          <div class="field-group span-1">
            <label for="ContactFormLastName">Last name*</label>
            <input type="text" id="ContactFormLastName" name="contact[last_name]" required>
          </div>

          <div class="field-group span-1">
            <label for="ContactFormCompany">Company name*</label>
            <input type="text" id="ContactFormCompany" name="contact[company]" required>
          </div>

          <div class="field-group span-1">
            <label for="ContactFormCountry">Country*</label>
            <select id="ContactFormCountry" name="contact[Country]" required onchange="updatePhoneCode()">
              <option value="Australia" data-code="+61" selected>Australia</option>
              <option value="New Zealand" data-code="+64">New Zealand</option>
              <option value="United States" data-code="+1">United States</option>
              <option value="United Kingdom" data-code="+44">United Kingdom</option>
              <option value="Canada" data-code="+1">Canada</option>
              <option value="Singapore" data-code="+65">Singapore</option>
              <option value="Other" data-code="+">Other</option>
            </select>
          </div>

          <div class="field-group span-1">
            <label for="ContactFormState">State (AU)</label>
            <select id="ContactFormState" name="contact[State]">
              <option value="" selected>Select State</option>
              <option value="VIC">Victoria (VIC)</option>
              <option value="NSW">New South Wales (NSW)</option>
              <option value="QLD">Queensland (QLD)</option>
              <option value="WA">Western Australia (WA)</option>
              <option value="SA">South Australia (SA)</option>
              <option value="TAS">Tasmania (TAS)</option>
              <option value="ACT">ACT</option>
              <option value="NT">Northern Territory</option>
              <option value="N/A">Not Applicable (International)</option>
            </select>
          </div>

          <div class="field-group span-1">
            <label for="ContactFormEmail">Email*</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" required>
          </div>

          <div class="field-group span-1">
            <label for="ContactFormPhone">Phone number</label>
            <input type="tel" id="ContactFormPhone" name="contact[phone]" value="+61">
          </div>

           <div class="span-2"></div>

          <div class="field-group span-3">
            <label for="ContactFormMessage">Message*</label>
            <textarea rows="5" id="ContactFormMessage" name="contact[body]" placeholder="How can we help?" required></textarea>
          </div>

        </div>

        <button type="submit" class="contact-submit-btn">Submit</button>

      {% endform %}
    </div>

  </div>
</div>

<script>
  function updatePhoneCode() {
    // 1. Get the selected option from the Country dropdown
    var countrySelect = document.getElementById("ContactFormCountry");
    var selectedOption = countrySelect.options[countrySelect.selectedIndex];
    
    // 2. Get the phone code stored in the 'data-code' attribute
    var phoneCode = selectedOption.getAttribute("data-code");
    
    // 3. Update the Phone Input value
    var phoneInput = document.getElementById("ContactFormPhone");
    
    // Only update if the field is empty or starts with a '+' (to avoid overwriting user data if they already typed)
    if (phoneInput.value === "" || phoneInput.value.startsWith("+")) {
       phoneInput.value = phoneCode;
    }
  }
</script>

{% schema %}
{
  "name": "Get In Touch",
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get In Touch!"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Contact us today to learn more about our integrations."
    },
    {
      "type": "header",
      "content": "Contact Details"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Office Location",
      "default": "9 Trade Pl, Vermont VIC 3133"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Toll Free Number",
      "default": "1300 800 200"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support Email",
      "default": "+613 8899 6900"
    },
    {
      "type": "text",
      "id": "sales_phone",
      "label": "Sales Phone",
      "default": "+613 8899 4100"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Color",
      "default": "#7ab53d"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Get In Touch Form"
    }
  ]
}
{% endschema %}