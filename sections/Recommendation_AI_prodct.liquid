{% schema %}
{
  "name": "Product Match AI (Real)",
  "settings": [
    {
      "type": "header",
      "content": "AI Configuration"
    },
    {
      "type": "text",
      "id": "openai_key",
      "label": "OpenAI API Key",
      "info": "Required for AI generation. starts with sk-..."
    },
    {
      "type": "collection",
      "id": "ai_collection",
      "label": "Products to Analyze",
      "info": "The AI will read products from this collection."
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 5,
      "max": 50,
      "step": 5,
      "label": "Max Products to Analyze",
      "default": 10,
      "info": "Higher numbers use more AI tokens."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "AI Shopping Assistant"
    },
    {
      "type": "checkbox",
      "id": "use_tailwind",
      "label": "Load Tailwind CSS",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product Match AI (Real)"
    }
  ]
}
{% endschema %}

{% if section.settings.use_tailwind %}
  <script src="https://cdn.tailwindcss.com" async></script>
{% endif %}

<style>
  .pm-fade-in { animation: pmFadeIn 0.5s ease-out forwards; }
  @keyframes pmFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .pm-spin { animation: pmSpin 2s linear infinite; }
  @keyframes pmSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  .typing-dot { animation: typing 1.4s infinite ease-in-out both; }
  .typing-dot:nth-child(1) { animation-delay: -0.32s; }
  .typing-dot:nth-child(2) { animation-delay: -0.16s; }
  @keyframes typing { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }
</style>

{% comment %}
  -----------------------------------------------------------------------------
  DATA GATHERING
  Fetch products from the selected collection to feed the AI.
  -----------------------------------------------------------------------------
{% endcomment %}
{% assign target_collection = collections[section.settings.ai_collection] %}
{% if target_collection == blank %}
  {% assign target_collection = collections['all'] %}
{% endif %}

<script>
  // Build the product context for the AI
  window.shopProducts = [
    {% for product in target_collection.products limit: section.settings.product_limit %}
      {
        id: {{ product.id }},
        title: {{ product.title | json }},
        price: {{ product.price | money | json }},
        tags: {{ product.tags | json }},
        description: {{ product.description | strip_html | truncate: 150 | json }},
        image: {{ product.featured_image | img_url: '600x600' | json }},
        url: {{ product.url | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  
  window.aiConfig = {
    apiKey: "{{ section.settings.openai_key }}",
    storeName: "{{ shop.name }}"
  };
</script>

<div id="product-match-root" class="py-16 bg-white text-slate-800 relative overflow-hidden font-sans">
  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-4xl mx-auto bg-white border border-slate-200 rounded-3xl p-8 md:p-12 shadow-2xl transition-all duration-300 min-h-[400px]" id="quiz-container">
      
      <!-- Header -->
      <div class="flex items-center gap-3 mb-8 border-b border-slate-100 pb-6">
        <div class="p-2 bg-[#8dc63f] rounded-lg shadow-lg shadow-[#8dc63f]/30">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
        </div>
        <div>
          <h3 class="text-2xl font-bold text-slate-900">{{ section.settings.title }}</h3>
          <p class="text-slate-500 text-sm">Powered by OpenAI</p>
        </div>
        <button id="btn-restart" class="hidden ml-auto text-sm text-[#8dc63f] hover:text-[#7ab32e] flex items-center gap-1 transition">
          Restart
        </button>
      </div>

      <!-- Main Content Area -->
      <div id="quiz-content" class="flex flex-col justify-center">
        <!-- JS injects content here -->
      </div>

    </div>
  </div>
</div>

<script>
  (function() {
    // --- State ---
    let conversationHistory = [];
    const container = document.getElementById('quiz-content');
    const restartBtn = document.getElementById('btn-restart');

    // --- Core Logic ---

    function init() {
      if (!window.aiConfig.apiKey) {
        renderError("Missing API Key. Please add your OpenAI API Key in the Theme Editor section settings.");
        return;
      }
      if (window.shopProducts.length === 0) {
        renderError("No products found in the selected collection.");
        return;
      }

      startAIConversation();
    }

    async function startAIConversation() {
      renderLoading("AI is reading product details...");
      
      // Initial System Prompt
      const systemPrompt = `
        You are an expert sales assistant for a store called ${window.aiConfig.storeName}.
        Your goal is to recommend ONE product from the provided list based on user needs.
        
        HERE IS THE PRODUCT LIST:
        ${JSON.stringify(window.shopProducts.map(p => ({id: p.id, title: p.title, desc: p.description, price: p.price, tags: p.tags})))}

        RULES:
        1. Ask a question to narrow down the list.
        2. Provide 2-4 short options for the user to click.
        3. If you are confident in a recommendation (or only 1 product remains), return the recommendation.
        
        RESPONSE FORMAT (JSON ONLY):
        {
          "type": "question",
          "text": "The question text?",
          "options": ["Option 1", "Option 2"]
        }
        OR
        {
          "type": "recommendation",
          "product_id": 12345,
          "reason": "Why this is the best match."
        }
      `;

      conversationHistory = [
        { role: "system", content: systemPrompt },
        { role: "user", content: "Help me find a product." }
      ];

      await fetchAIResponse();
    }

    async function handleUserChoice(choice) {
      renderLoading("Analyzing your choice...");
      conversationHistory.push({ role: "user", content: `I choose: ${choice}` });
      await fetchAIResponse();
    }

    async function fetchAIResponse() {
      try {
        const response = await fetch("https://api.openai.com/v1/chat/completions", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${window.aiConfig.apiKey}`
          },
          body: JSON.stringify({
            model: "gpt-4o-mini", // Cost effective model
            messages: conversationHistory,
            temperature: 0.7,
            response_format: { type: "json_object" } 
          })
        });

        const data = await response.json();
        
        if (data.error) {
          throw new Error(data.error.message);
        }

        const aiContent = data.choices[0].message.content;
        conversationHistory.push({ role: "assistant", content: aiContent });
        
        const parsedArgs = JSON.parse(aiContent);
        
        if (parsedArgs.type === 'question') {
          renderQuestion(parsedArgs.text, parsedArgs.options);
        } else if (parsedArgs.type === 'recommendation') {
          const product = window.shopProducts.find(p => p.id === parsedArgs.product_id);
          if (product) {
            renderResult(product, parsedArgs.reason);
          } else {
            // Fallback if ID mismatch
            renderQuestion("I found a match but couldn't load it. Try again?", ["Restart"]);
          }
        }

      } catch (err) {
        console.error(err);
        renderError("AI Error: " + err.message);
      }
    }

    // --- Render Functions ---

    function renderQuestion(text, options) {
      container.innerHTML = '';
      restartBtn.classList.remove('hidden');

      const wrapper = document.createElement('div');
      wrapper.className = "space-y-8 pm-fade-in";
      
      const title = document.createElement('h2');
      title.className = "text-3xl md:text-4xl font-bold leading-tight text-center md:text-left text-slate-900";
      title.innerText = text;
      wrapper.appendChild(title);

      const grid = document.createElement('div');
      grid.className = "grid md:grid-cols-2 gap-4";

      options.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = "group text-left p-6 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-[#8dc63f] transition-all duration-300 w-full";
        
        btn.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-lg font-semibold block text-slate-800 group-hover:text-[#8dc63f] transition">${opt}</span>
            <svg class="w-5 h-5 text-slate-300 group-hover:text-[#8dc63f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        `;

        btn.onclick = () => handleUserChoice(opt);
        grid.appendChild(btn);
      });

      wrapper.appendChild(grid);
      container.appendChild(wrapper);
    }

    function renderResult(product, reason) {
      restartBtn.classList.remove('hidden');
      const html = `
        <div class="flex flex-col md:flex-row gap-8 items-center pm-fade-in">
            <div class="w-full md:w-1/2">
                <div class="relative group">
                    <div class="absolute -inset-1 bg-gradient-to-r from-[#8dc63f] to-green-600 rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-1000"></div>
                    <img src="${product.image}" alt="${product.title}" class="relative rounded-xl w-full shadow-xl" />
                </div>
            </div>
            <div class="w-full md:w-1/2 space-y-4">
                <div class="text-[#8dc63f] font-bold tracking-widest text-xs uppercase">AI Recommended</div>
                <h2 class="text-3xl font-bold text-slate-900">${product.title}</h2>
                <div class="bg-slate-50 p-4 rounded-lg border border-slate-100">
                  <p class="text-slate-700 italic">"${reason}"</p>
                </div>
                <p class="text-slate-500 text-sm line-clamp-3">${product.description}</p>
                
                <div class="pt-6 flex items-center gap-4">
                    <span class="text-3xl font-bold text-slate-900">${product.price}</span>
                    <a href="${product.url}" class="flex-1 bg-[#8dc63f] hover:bg-[#7ab32e] text-center text-white py-3 px-6 rounded-xl font-bold shadow-lg shadow-[#8dc63f]/20 transition flex items-center justify-center gap-2">
                        View Product
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    </a>
                </div>
            </div>
        </div>
      `;
      container.innerHTML = html;
    }

    function renderLoading(msg) {
      container.innerHTML = `
        <div class="flex flex-col items-center justify-center py-12 pm-fade-in">
           <div class="flex space-x-2 mb-4">
              <div class="w-3 h-3 bg-[#8dc63f] rounded-full typing-dot"></div>
              <div class="w-3 h-3 bg-[#8dc63f] rounded-full typing-dot"></div>
              <div class="w-3 h-3 bg-[#8dc63f] rounded-full typing-dot"></div>
           </div>
           <h3 class="text-xl font-bold text-slate-600 animate-pulse">${msg}</h3>
        </div>
      `;
    }

    function renderError(msg) {
      container.innerHTML = `
        <div class="text-center p-8 bg-red-50 rounded-xl border border-red-200">
          <p class="text-red-600 font-bold">${msg}</p>
        </div>
      `;
    }

    // --- Init ---
    restartBtn.addEventListener('click', () => {
      conversationHistory = [];
      startAIConversation();
    });
    
    // Slight delay to ensure config loads
    setTimeout(init, 500);

  })();
</script>