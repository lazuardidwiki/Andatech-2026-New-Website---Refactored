{%- comment -%}
  Andatech — ROI Calculator (overlay modal variant).

  A banner card with a CTA opens a full-screen overlay containing the same
  two-step readiness + transparent cost comparison used on the standalone
  ROI Calculator page. The modal is moved to <body> on load so it escapes
  the section wrapper's zoom transform.

  Uses visitor-entered figures only — no hidden benchmark rates.
  Classes are `at-` prefixed; styling lives in andatech-site.css and
  andatech-mcp.css.
{%- endcomment -%}

{%- comment -%}
  Split from the andatech-home monolith on 2026-09-05. This section now loads
  its own scoped ROI stylesheet + script instead of the 336 KB andatech-site.css
  and 76 KB andatech-site.js. The monolith is still loaded elsewhere on this
  page (via other homepage sections), so no page suddenly loses styles.
{%- endcomment -%}
{{ 'andatech-roi.css' | asset_url | stylesheet_tag }}
{{ 'andatech-mcp.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  andatech-roi.js is intentionally NOT loaded here. Its calculator module
  (Module 7) targets [data-at-roi], which does not exist anywhere in this
  template — it has always been a silent no-op on this section. Its modal
  module (Module 8) re-implements open/close/focus-trap for the same modal
  ID this file already wires up in the inline <script> below, so loading
  both bound two competing sets of listeners to one element. Removed as
  dead weight + a latent double-fire bug. If another section on the site
  still relies on andatech-roi.js's calculator, leave this asset alone —
  it is unrelated to this file.
{%- endcomment -%}

<style>
  /* ── Field groups inside the overlay ──────────────────── */
  .at-roi-modal .at-roi-calc__field-group { margin-top: 24px; }
  .at-roi-modal .at-roi-calc__field-group + .at-roi-calc__field-group {
    margin-top: 28px; border-top: 1px solid #E5E7EB; padding-top: 24px;
  }
  .at-roi-modal .at-roi-calc__group-label {
    font-size: 11px; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; color: var(--at-teal-deep, #2A8F8F);
    margin: 0 0 4px;
  }
  .at-roi-modal .at-roi-calc__group-hint {
    font-size: 13px; color: var(--at-body-color, #495563);
    line-height: 1.5; margin: 0 0 20px;
  }

  /* ── Negative values ─────────────────────────────────── */
  .at-roi-modal .at-mcp-readiness__result-row strong.is-negative { color: #9B1C12; }
  .at-roi-modal .at-mcp-readiness__result-row--primary.is-negative-row { background: #FEF2F2; }
  .at-roi-modal .at-mcp-readiness__result-row--primary.is-negative-row strong { color: #9B1C12; }
  .at-roi-modal .at-mcp-readiness__result-row--summary { border-top: 2px solid #DDE0E3; border-bottom: 0; }
  .at-roi-modal .at-mcp-readiness__result-row--summary strong { font-size: 17px; }
  .at-roi-modal .at-mcp-readiness__result-row--summary.is-negative-row strong { color: #9B1C12; }

  /* ── Modal-specific overrides ────────────────────────── */
  .at-roi-modal .at-mcp-readiness__stepper { margin-top: 24px; margin-bottom: 28px; }
  .at-roi-modal .at-mcp-readiness__calculator {
    gap: clamp(20px, 3vw, 40px);
  }
  .at-roi-modal .at-mcp-readiness__form { padding: clamp(20px, 2.5vw, 32px); }
  .at-roi-modal .at-mcp-readiness__score-head { padding: 20px 24px; }
  .at-roi-modal .at-mcp-readiness__result-list { padding: 10px 24px; }
  .at-roi-modal .at-mcp-readiness__result-row { min-height: 50px; font-size: 13px; }
  .at-roi-modal .at-mcp-readiness__result-row strong { font-size: 15px; }
  .at-roi-modal .at-mcp-readiness__priorities { padding: 20px 24px 24px; }
  .at-roi-modal .at-mcp-readiness__method { margin-top: 20px; }

  @media (max-width: 767px) {
    .at-roi-modal .at-mcp-readiness__calculator { grid-template-columns: 1fr; }
    .at-roi-modal .at-mcp-readiness__fields { grid-template-columns: 1fr; }
    .at-roi-modal .at-mcp-readiness__questions { grid-template-columns: 1fr; }
    .at-roi-modal .at-mcp-readiness__actions--split {
      flex-direction: column-reverse; align-items: center;
    }
  }

  /* ── Headline result (always visible, ungated) ────────── */
  .at-roi-modal .at-roi-headline {
    padding: 20px 24px; border-bottom: 1px solid #E5E7EB;
  }
  .at-roi-modal .at-roi-headline__label {
    font-size: 12px; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; color: var(--at-body-color, #495563);
    margin: 0 0 6px;
  }
  .at-roi-modal .at-roi-headline__amount {
    font-size: clamp(26px, 3vw, 34px); font-weight: 700;
    color: var(--at-teal-deep, #2A8F8F); line-height: 1.1;
  }
  .at-roi-modal .at-roi-headline__amount.is-negative { color: #9B1C12; }
  .at-roi-modal .at-roi-headline__sub {
    margin: 8px 0 0; font-size: 13px; color: var(--at-body-color, #495563);
  }

  /* ── Gated full breakdown ──────────────────────────────── */
  .at-roi-gate { position: relative; }
  .at-roi-gate[data-gate-state="locked"] .at-mcp-readiness__result-list,
  .at-roi-gate[data-gate-state="locked"] .at-mcp-readiness__priorities {
    filter: blur(6px); user-select: none; pointer-events: none;
  }
  /* Overlay: dim-tinted layer over the blurred rows, centres the card. */
  .at-roi-modal .at-roi-gate__form {
    position: absolute; inset: 0; z-index: 2; display: flex;
    align-items: center; justify-content: center;
    padding: 24px; background: rgba(15, 23, 32, .35);
  }
  .at-roi-modal .at-roi-gate[data-gate-state="unlocked"] .at-roi-gate__form { display: none; }
  /* Card: bounded white surface so the gate reads as an unlock prompt,
     not a wall of blur. */
  .at-roi-modal .at-roi-gate__card {
    width: 100%; max-width: 460px;
    display: flex; flex-direction: column; gap: 14px;
    padding: 28px;
    background: #fff; border-radius: 16px;
    box-shadow: 0 22px 44px -14px rgba(0, 0, 0, .35),
                0 6px 14px -6px rgba(0, 0, 0, .18);
  }
  .at-roi-modal .at-roi-gate__form h3 { margin: 0; font-size: 17px; font-weight: 700; }
  .at-roi-modal .at-roi-gate__form p { margin: 0; font-size: 13px; line-height: 1.5; color: var(--at-body-color, #495563); }
  /* Inner form owns its own vertical rhythm so every element sits at the
     same distance from its neighbour. */
  .at-roi-modal .at-roi-gate__form form { display: flex; flex-direction: column; gap: 12px; }
  .at-roi-modal .at-roi-gate__row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .at-roi-modal .at-roi-gate__form input {
    width: 100%; height: 44px; padding: 0 14px; border: 1px solid #D8DCE0;
    border-radius: 8px; font-size: 14px; box-sizing: border-box;
    background: #fff;
  }
  .at-roi-modal .at-roi-gate__form input:focus {
    outline: none; border-color: var(--at-teal-deep, #2A8F8F);
    box-shadow: 0 0 0 3px rgba(42, 143, 143, .15);
  }
  .at-roi-modal .at-roi-gate__form input:invalid:not(:placeholder-shown) { border-color: #9B1C12; }
  .at-roi-modal .at-roi-gate__form .at-btn { width: 100%; margin-top: 4px; }
  .at-roi-modal .at-roi-gate__error { font-size: 12px; color: #9B1C12; margin: 0; }
  .at-roi-modal .at-roi-gate__note { font-size: 12px; color: var(--at-body-color, #495563); margin: 0; }
  @media (max-width: 480px) {
    .at-roi-modal .at-roi-gate__row { grid-template-columns: 1fr; }
    .at-roi-modal .at-roi-gate__card { padding: 22px; border-radius: 14px; }
  }

  /* ── Optional outsourced-cost sub-fields ───────────────── */
  .at-roi-toggle {
    display: flex; align-items: center; gap: 8px; margin: 4px 0 0;
    font-size: 13px; color: var(--at-body-color, #495563);
  }
  .at-roi-subfields { margin-top: 14px; }
  .at-roi-subfields[hidden] { display: none; }
</style>

{%- comment -%} ── Banner: what the page shows ─────────────────────── {%- endcomment -%}
<section class="at-roi-banner">
  <div class="at-shell">
    <div class="at-roi-banner__card" data-at-rise>

      <div class="at-roi-banner__content">
        {%- assign eyebrow_tag = section.settings.eyebrow_tag | default: 'h2' -%}
        {%- assign title_tag = section.settings.title_tag | default: 'h3' -%}
        {%- if section.settings.eyebrow != blank -%}
          <{{ eyebrow_tag }} class="at-roi__eyebrow">{{ section.settings.eyebrow | escape }}</{{ eyebrow_tag }}>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <{{ title_tag }} class="at-roi__title">{{ section.settings.title }}</{{ title_tag }}>
        {%- endif -%}
        {%- if section.settings.desc != blank -%}
          <div class="at-roi__desc">{{ section.settings.desc }}</div>
        {%- endif -%}
        <div class="at-roi-banner__cta">
          <button type="button" class="at-btn at-btn--green"
                  data-at-roi-open="at-roi-modal-{{ section.id }}">
            {{ section.settings.open_label | escape }}
            <i class="at-btn__arrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="m10 5.5 6.5 6.5-6.5 6.5" stroke="currentColor"
                      stroke-width="2.2" stroke-linecap="round"
                      stroke-linejoin="round"/>
              </svg>
            </i>
          </button>
        </div>
      </div>

      {%- if section.settings.banner_image != blank -%}
        <div class="at-roi-banner__media">
          <img src="{{ section.settings.banner_image | image_url: width: 1440 }}"
               alt="{{ section.settings.banner_image.alt | escape }}"
               width="{{ section.settings.banner_image.width }}"
               height="{{ section.settings.banner_image.height }}"
               loading="lazy">
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{%- comment -%} ── Overlay: the calculator ────────────────────────────
  Moved to <body> on load so it escapes the section wrapper's zoom. {%- endcomment -%}
<div class="at-roi-modal"
     id="at-roi-modal-{{ section.id }}"
     role="dialog" aria-modal="true"
     aria-labelledby="at-roi-modal-title-{{ section.id }}"
     hidden
     data-at-roi-modal>

  <div class="at-roi-modal__panel" style="max-width: 1280px;">

    {%- comment -%} Header — stays fixed while the body scrolls. {%- endcomment -%}
    <div class="at-roi-modal__head">
      <div>
        {%- assign modal_title_tag = section.settings.modal_title_tag | default: 'h3' -%}
        <{{ modal_title_tag }} class="at-roi-modal__title"
            id="at-roi-modal-title-{{ section.id }}">
          {{ section.settings.modal_title }}
        </{{ modal_title_tag }}>
        {%- if section.settings.modal_sub != blank -%}
          <p class="at-roi-modal__sub">{{ section.settings.modal_sub | escape }}</p>
        {%- endif -%}
      </div>
      <button type="button" class="at-roi-modal__close"
              data-at-roi-close
              aria-label="{{ section.settings.close_label | escape }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
             aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor"
                stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    {%- comment -%} Scrollable body — contains the full two-step calculator. {%- endcomment -%}
    <div class="at-roi-modal__body" data-roi-calculator-modal>

      {%- comment -%} ── Stepper tabs ──────────────────── {%- endcomment -%}
      <div class="at-mcp-readiness__stepper" role="tablist"
           aria-label="Calculator steps">
        <button class="at-mcp-readiness__step-pill is-active"
                type="button" role="tab" aria-selected="true"
                data-step-tab="1">Step 1: Readiness</button>
        <button class="at-mcp-readiness__step-pill"
                type="button" role="tab" aria-selected="false"
                data-step-tab="2">Step 2: Your Numbers</button>
      </div>

      {%- comment -%} ══ PANEL 1 — Readiness ═══════════ {%- endcomment -%}
      <div class="at-mcp-readiness__step-content is-active"
           data-step-panel="1">

        <div class="at-mcp-readiness__questions">
          {%- for block in section.blocks -%}
            {%- if block.type == 'question' -%}
              <div class="at-mcp-readiness__q-card"
                   data-readiness-q
                   data-gap-label="{{ block.settings.gap_label | default: block.settings.question | escape }}"
                   {{ block.shopify_attributes }}>
                <h3>{{ block.settings.question | escape }}</h3>
                <div class="at-mcp-readiness__pills" role="group"
                     aria-label="{{ block.settings.question | escape }}">
                  <button class="at-mcp-readiness__pill" type="button"
                          data-answer="yes" data-score="2"
                          aria-pressed="false">Yes</button>
                  <button class="at-mcp-readiness__pill" type="button"
                          data-answer="no" data-score="0"
                          aria-pressed="false">No</button>
                  <button class="at-mcp-readiness__pill" type="button"
                          data-answer="unsure" data-score="1"
                          aria-pressed="false">Unsure</button>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <p class="at-mcp-readiness__error" data-validation-msg
           role="alert" hidden>
          Please answer every readiness question before continuing.
        </p>

        <div class="at-mcp-readiness__actions">
          <button class="at-btn at-btn--green" type="button" data-next-step>
            Next: Estimate ROI
            <i class="at-btn__arrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="m10 5.5 6.5 6.5-6.5 6.5" stroke="currentColor"
                      stroke-width="2.2" stroke-linecap="round"
                      stroke-linejoin="round"/>
              </svg>
            </i>
          </button>
        </div>
      </div>

      {%- comment -%} ══ PANEL 2 — Transparent cost comparison ═══ {%- endcomment -%}
      <div class="at-mcp-readiness__step-content"
           data-step-panel="2" hidden>

        <div class="at-mcp-readiness__calculator">

          {%- comment -%} ── Form ─────────────────────── {%- endcomment -%}
          <form class="at-mcp-readiness__form" data-roi-form novalidate>
            <div class="at-mcp-readiness__form-head">
              <h3>Your operating numbers</h3>
              <p>Enter your organisation's current or planned figures.
                 Use zero where a cost does not apply.</p>
            </div>

            <div class="at-roi-calc__field-group">
              <p class="at-roi-calc__group-label">Program scale</p>
              <p class="at-roi-calc__group-hint">
                Drives your testing volume and how many SoberLive FRX units
                you'd need.
              </p>
              <div class="at-mcp-readiness__fields">
                <label class="at-mcp-readiness__field">
                  <span>Employees to be tested</span>
                  <input type="number" min="0" step="1" inputmode="numeric"
                         value="{{ section.settings.default_employees }}"
                         data-roi-input="employees">
                </label>
                <label class="at-mcp-readiness__field">
                  <span>Number of sites</span>
                  <input type="number" min="0" step="1" inputmode="numeric"
                         value="{{ section.settings.default_sites }}"
                         data-roi-input="sites">
                </label>
                <label class="at-mcp-readiness__field">
                  <span>Tests per employee, per year</span>
                  <input type="number" min="0" step="1" inputmode="numeric"
                         value="{{ section.settings.default_tests_per_employee }}"
                         data-roi-input="tests-per-employee">
                </label>
              </div>
              <p class="at-roi-calc__group-hint" style="margin: 10px 0 0;">
                Estimated tests per year: <strong data-roi-out="total-tests">0</strong>
              </p>
            </div>

            <div class="at-roi-calc__field-group">
              <p class="at-roi-calc__group-label">Current manual testing</p>
              <p class="at-roi-calc__group-hint">
                The staff time your current supervised breath-testing process
                takes — administering the test and logging the result.
              </p>
              <div class="at-mcp-readiness__fields">
                <label class="at-mcp-readiness__field">
                  <span>Minutes to complete one test</span>
                  <input type="number" min="0" step="1" inputmode="decimal"
                         value="{{ section.settings.default_manual_minutes }}"
                         data-roi-input="manual-minutes">
                </label>
                <label class="at-mcp-readiness__field">
                  <span>Fully-loaded hourly cost of staff testing</span>
                  <span class="at-mcp-readiness__money">
                    <span aria-hidden="true">$</span>
                    <input type="number" min="0" step="1" inputmode="decimal"
                           value="{{ section.settings.default_hourly_rate }}"
                           data-roi-input="hourly-rate">
                  </span>
                </label>
              </div>
              <label class="at-roi-toggle">
                <input type="checkbox" data-roi-toggle="outsourced">
                <span>We also send some testing to an outsourced provider</span>
              </label>
              <div class="at-mcp-readiness__fields at-roi-subfields"
                   data-roi-subfields="outsourced" hidden>
                <label class="at-mcp-readiness__field">
                  <span>Share of testing that's outsourced</span>
                  <span class="at-mcp-readiness__percent">
                    <input type="number" min="0" max="100" step="1"
                           inputmode="numeric"
                           value="{{ section.settings.default_outsourced_share }}"
                           data-roi-input="outsourced-share">
                    <span aria-hidden="true">%</span>
                  </span>
                </label>
                <label class="at-mcp-readiness__field">
                  <span>Average outsourced cost per test</span>
                  <span class="at-mcp-readiness__money">
                    <span aria-hidden="true">$</span>
                    <input type="number" min="0" step="1" inputmode="decimal"
                           value="{{ section.settings.default_test_cost }}"
                           data-roi-input="test-cost">
                  </span>
                </label>
                <label class="at-mcp-readiness__field">
                  <span>Annual callout, travel and related costs</span>
                  <span class="at-mcp-readiness__money">
                    <span aria-hidden="true">$</span>
                    <input type="number" min="0" step="1" inputmode="decimal"
                           value="{{ section.settings.default_other_cost }}"
                           data-roi-input="other-cost">
                  </span>
                </label>
              </div>
            </div>

            <div class="at-roi-calc__field-group">
              <p class="at-roi-calc__group-label">Proposed: SoberLive FRX</p>
              <p class="at-roi-calc__group-hint">
                Unattended wall-mounted units with facial recognition —
                testing runs without a collector present.
              </p>
              <div class="at-mcp-readiness__fields">
                <label class="at-mcp-readiness__field">
                  <span>Cost per unit (one-off, incl. install)</span>
                  <span class="at-mcp-readiness__money">
                    <span aria-hidden="true">$</span>
                    <input type="number" min="0" step="1" inputmode="decimal"
                           value="{{ section.settings.default_unit_cost }}"
                           data-roi-input="unit-cost">
                  </span>
                </label>
                <label class="at-mcp-readiness__field">
                  <span>Annual licence, calibration &amp; servicing per unit</span>
                  <span class="at-mcp-readiness__money">
                    <span aria-hidden="true">$</span>
                    <input type="number" min="0" step="1" inputmode="decimal"
                           value="{{ section.settings.default_unit_annual_cost }}"
                           data-roi-input="unit-annual-cost">
                  </span>
                </label>
              </div>

              <details class="at-mcp-readiness__method" style="margin-top: 14px;">
                <summary>Advanced assumptions</summary>
                <div class="at-mcp-readiness__fields" style="margin-top: 14px;">
                  <label class="at-mcp-readiness__field">
                    <span>Units required</span>
                    <input type="number" min="0" step="1" inputmode="numeric"
                           data-roi-input="units" data-roi-auto="sites"
                           placeholder="Auto: 1 per site">
                  </label>
                  <label class="at-mcp-readiness__field">
                    <span>Tests flagged for manual review</span>
                    <span class="at-mcp-readiness__percent">
                      <input type="number" min="0" max="100" step="1"
                             inputmode="numeric"
                             value="{{ section.settings.default_flagged_pct }}"
                             data-roi-input="flagged-pct">
                      <span aria-hidden="true">%</span>
                    </span>
                  </label>
                  <label class="at-mcp-readiness__field">
                    <span>Review minutes per flagged test</span>
                    <input type="number" min="0" step="1" inputmode="decimal"
                           value="{{ section.settings.default_review_minutes }}"
                           data-roi-input="review-minutes">
                  </label>
                </div>
                <p class="at-roi-calc__group-hint" style="margin-top: 10px;">
                  Units default to one per site — override if a site needs
                  more than one, or fewer employees share a unit. FRX runs
                  unattended, but a small share of tests (failed or
                  inconclusive) still need a quick human review.
                </p>
              </details>
            </div>
          </form>

          {%- comment -%} ── Results ──────────────────── {%- endcomment -%}
          <div class="at-mcp-readiness__results" aria-live="polite"
               aria-atomic="false">
            <div class="at-mcp-readiness__score-head">
              <div>
                <p>Your readiness score</p>
                <strong data-readiness-score>0%</strong>
              </div>
              <span data-readiness-label>Complete Step 1</span>
            </div>

            {%- comment -%} Headline — ungated, always visible once numbers are entered. {%- endcomment -%}
            <div class="at-roi-headline">
              <p class="at-roi-headline__label">Indicative annual savings with SoberLive FRX</p>
              <div class="at-roi-headline__amount" data-roi-out="headline">$0</div>
              <p class="at-roi-headline__sub" data-roi-out="headline-sub">
                Enter your numbers to see an estimate.
              </p>
            </div>

            {%- comment -%} Gated — full line-by-line breakdown behind a lead-capture form. {%- endcomment -%}
            <div class="at-roi-gate" data-roi-gate data-gate-state="locked">
              <div class="at-roi-gate__form" data-roi-gate-form>
                <div class="at-roi-gate__card">
                <h3>{{ section.settings.gate_title | default: 'Get your full breakdown' }}</h3>
                <p>{{ section.settings.gate_sub | default: "See exactly where the savings come from, plus your ROI and payback period. We'll also send a copy to your inbox." }}</p>
                <form data-roi-lead-form novalidate>
                  <div class="at-roi-gate__row">
                    <input type="text" name="firstname" placeholder="First name" required data-roi-lead="firstname">
                    <input type="text" name="lastname" placeholder="Last name" data-roi-lead="lastname">
                  </div>
                  <div class="at-roi-gate__row">
                    <input type="email" name="email" placeholder="Work email" required data-roi-lead="email">
                    <input type="tel" name="phone" placeholder="Phone (optional)" data-roi-lead="phone">
                  </div>
                  <input type="text" name="company" placeholder="Company (optional)" data-roi-lead="company">
                  <p class="at-roi-gate__error" data-roi-lead-error hidden>
                    Please enter your first name and a valid work email.
                  </p>
                  <button class="at-btn at-btn--green at-btn--sm" type="submit">
                    {{ section.settings.gate_cta_label | default: 'Show my full breakdown' }}
                  </button>
                  <p class="at-roi-gate__note">
                    {{ section.settings.gate_note | default: "We'll only use these details to follow up about your results." }}
                  </p>
                </form>
                </div>
              </div>

              <div class="at-mcp-readiness__result-list">
                <div class="at-mcp-readiness__result-row">
                  <span>Current annual testing cost</span>
                  <strong data-roi-out="current-cost">$0</strong>
                </div>
                <div class="at-mcp-readiness__result-row">
                  <span>&nbsp;&nbsp;— of which manual staff time</span>
                  <strong data-roi-out="manual-labor">$0</strong>
                </div>
                <div class="at-mcp-readiness__result-row">
                  <span>&nbsp;&nbsp;— of which outsourced provider</span>
                  <strong data-roi-out="outsourced">$0</strong>
                </div>
                <div class="at-mcp-readiness__result-row">
                  <span>SoberLive FRX units required</span>
                  <strong data-roi-out="units-used">0</strong>
                </div>
                <div class="at-mcp-readiness__result-row">
                  <span>One-off setup cost</span>
                  <strong data-roi-out="setup-cost">$0</strong>
                </div>
                <div class="at-mcp-readiness__result-row">
                  <span>Ongoing annual program cost</span>
                  <strong data-roi-out="ongoing-cost">$0</strong>
                </div>
                <div class="at-mcp-readiness__result-row at-mcp-readiness__result-row--primary">
                  <span>Indicative year-one net difference</span>
                  <strong data-roi-out="year-one-net">$0</strong>
                </div>
                <div class="at-mcp-readiness__result-row">
                  <span>Indicative ongoing annual difference</span>
                  <strong data-roi-out="ongoing-net">$0</strong>
                </div>
                <div class="at-mcp-readiness__result-row">
                  <span>Indicative year-one ROI</span>
                  <strong data-roi-out="roi">&mdash;</strong>
                </div>
                <div class="at-mcp-readiness__result-row">
                  <span>Indicative payback period</span>
                  <strong data-roi-out="payback">&mdash;</strong>
                </div>
                <div class="at-mcp-readiness__result-row at-mcp-readiness__result-row--summary">
                  <span>Projected 3-year cumulative value</span>
                  <strong data-roi-out="three-year">$0</strong>
                </div>
              </div>
              <div class="at-mcp-readiness__priorities">
                <h3>Capability priorities</h3>
                <p data-priority-summary>
                  Complete the readiness questions to see suggested priorities.
                </p>
                <ul data-priority-list></ul>
              </div>
            </div>
          </div>
        </div>

        {%- comment -%} ── Calculation method ──────── {%- endcomment -%}
        <details class="at-mcp-readiness__method">
          <summary>
            How the estimate is calculated
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 aria-hidden="true">
              <path d="m5 9 7 7 7-7" stroke="currentColor" stroke-width="1.8"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div>
            <p><strong>Annual tests</strong> = employees &times; tests
               per employee, per year.</p>
            <p><strong>Manual staff time cost</strong> = tests done
               manually &times; minutes per test &divide; 60 &times;
               hourly staff cost.</p>
            <p><strong>Outsourced cost</strong> (only if that option is
               ticked) = outsourced tests &times; cost per test + annual
               callout and related costs.</p>
            <p><strong>Current annual testing cost</strong> = manual
               staff time cost + outsourced cost.</p>
            <p><strong>Units required</strong> defaults to one SoberLive
               FRX unit per site, and can be overridden.</p>
            <p><strong>One-off setup cost</strong> = units &times; cost
               per unit.</p>
            <p><strong>Ongoing annual program cost</strong> = (units
               &times; annual licence/servicing per unit) + review cost.
               <strong>Review cost</strong> = annual tests &times; the
               flagged-for-review share &times; review minutes &divide;
               60 &times; hourly staff cost — the residual human time
               FRX still needs for flagged results.</p>
            <p><strong>Year-one net difference</strong> = current annual
               testing cost &minus; (setup cost + ongoing annual program
               cost).</p>
            <p><strong>Ongoing annual difference</strong> = current annual
               testing cost &minus; ongoing annual program cost.</p>
            <p><strong>Year-one ROI</strong> = year-one net difference
               &divide; (setup cost + ongoing annual program cost)
               &times; 100.</p>
            <p><strong>Payback period</strong> = setup cost &divide;
               (ongoing annual difference &divide; 12). Shown only when
               the ongoing annual difference is positive.</p>
            <p><strong>3-year cumulative value</strong> = (current annual
               testing cost &times; 3) &minus; setup cost &minus;
               (ongoing annual program cost &times; 3).</p>
            <p>The estimator does not assign a financial value to safety,
               compliance, incident avoidance or productivity.</p>
          </div>
        </details>

        {%- if section.settings.disclaimer != blank -%}
          <div class="at-mcp-readiness__fine-print">
            {{ section.settings.disclaimer }}
          </div>
        {%- endif -%}

        <div class="at-mcp-readiness__actions at-mcp-readiness__actions--split">
          <button class="at-btn at-btn--outline-dark" type="button"
                  data-back-step>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 aria-hidden="true">
              <path d="m14 5.5-6.5 6.5 6.5 6.5" stroke="currentColor"
                    stroke-width="2.2" stroke-linecap="round"
                    stroke-linejoin="round"/>
            </svg>
            Back to Readiness
          </button>
          {%- if section.settings.results_cta_label != blank -%}
            <a class="at-btn at-btn--green"
               href="{{ section.settings.results_cta_url | default: '#contact' }}">
              {{ section.settings.results_cta_label | escape }}
              <i class="at-btn__arrow" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="m10 5.5 6.5 6.5-6.5 6.5" stroke="currentColor"
                        stroke-width="2.2" stroke-linecap="round"
                        stroke-linejoin="round"/>
                </svg>
              </i>
            </a>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</div>

{%- comment -%} ═══════════════════════════════════════════════════
  JavaScript — modal open/close + the same readiness & ROI logic.
═══════════════════════════════════════════════════ {%- endcomment -%}
<script>
(function () {
  /* ── Modal open / close ────────────────────────────────── */
  var modal = document.getElementById('at-roi-modal-{{ section.id }}');
  if (!modal) return;

  /* Move to <body> so it escapes the section wrapper's zoom transform.
     A fixed child of a zoomed ancestor has its inset scaled, leaving a
     strip along two edges. */
  document.body.appendChild(modal);

  var opener = document.querySelector(
    '[data-at-roi-open="at-roi-modal-{{ section.id }}"]'
  );
  var closers = [].slice.call(modal.querySelectorAll('[data-at-roi-close]'));
  var previousFocus = null;

  function open() {
    previousFocus = document.activeElement;
    modal.hidden = false;
    requestAnimationFrame(function () {
      modal.classList.add('at-is-on');
    });
    document.documentElement.style.overflow = 'hidden';
    var first = modal.querySelector('[data-at-roi-close]');
    if (first) first.focus();
  }

  function close() {
    modal.classList.remove('at-is-on');
    document.documentElement.style.overflow = '';
    var dur = 300;
    setTimeout(function () { modal.hidden = true; }, dur);
    if (previousFocus) previousFocus.focus();
  }

  if (opener) opener.addEventListener('click', open);
  closers.forEach(function (btn) { btn.addEventListener('click', close); });

  modal.addEventListener('click', function (e) {
    if (e.target === modal) close();
  });

  modal.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { e.stopPropagation(); close(); }
  });

  /* ── Calculator logic (scoped to the modal body) ───────── */
  var root = modal.querySelector('[data-roi-calculator-modal]');
  if (!root) return;

  var tabs       = [].slice.call(root.querySelectorAll('[data-step-tab]'));
  var panels     = [].slice.call(root.querySelectorAll('[data-step-panel]'));
  var questions  = [].slice.call(root.querySelectorAll('[data-readiness-q]'));
  var validation = root.querySelector('[data-validation-msg]');
  var nextBtn    = root.querySelector('[data-next-step]');
  var backBtn    = root.querySelector('[data-back-step]');

  var currency = new Intl.NumberFormat('en-AU', {
    style: 'currency', currency: 'AUD', maximumFractionDigits: 0
  });

  function numeric(name) {
    var el = root.querySelector('[data-roi-input="' + name + '"]');
    var v = el ? Number(el.value) : 0;
    return Number.isFinite(v) && v > 0 ? v : 0;
  }

  function checked(name) {
    var el = root.querySelector('[data-roi-toggle="' + name + '"]');
    return !!(el && el.checked);
  }

  function setOutput(name, text, negative) {
    var el = root.querySelector('[data-roi-out="' + name + '"]');
    if (!el) return;
    el.textContent = text;
    el.classList.toggle('is-negative', !!negative);
    var row = el.closest('.at-mcp-readiness__result-row');
    if (row) row.classList.toggle('is-negative-row', !!negative);
  }

  /* ── Readiness ─────────────────────────────────────────── */
  function readinessResult() {
    var total = 0, answered = 0, gaps = [];
    questions.forEach(function (q) {
      var active = q.querySelector('.at-mcp-readiness__pill.is-active');
      if (!active) return;
      answered++;
      total += Number(active.dataset.score || 0);
      if (active.dataset.answer !== 'yes') gaps.push(q.dataset.gapLabel);
    });
    var max = questions.length * 2;
    return {
      answered: answered,
      percentage: max > 0 ? Math.round((total / max) * 100) : 0,
      gaps: gaps
    };
  }

  function scoreLabel(pct) {
    if (pct >= 85) return 'Strong foundations';
    if (pct >= 65) return 'Good base, with gaps';
    if (pct >= 40) return 'Several priorities to address';
    return 'Foundations need attention';
  }

  function updateReadiness() {
    var r = readinessResult();
    var scoreEl = root.querySelector('[data-readiness-score]');
    var labelEl = root.querySelector('[data-readiness-label]');
    if (scoreEl) scoreEl.textContent = r.percentage + '%';
    if (labelEl) {
      labelEl.textContent = r.answered === questions.length
        ? scoreLabel(r.percentage) : 'Complete Step 1';
    }
    var summary = root.querySelector('[data-priority-summary]');
    var list    = root.querySelector('[data-priority-list]');
    if (summary) {
      if (r.answered < questions.length)
        summary.textContent = 'Complete the readiness questions to see suggested priorities.';
      else if (r.gaps.length === 0)
        summary.textContent = 'No immediate gaps were identified. Validate through a formal program review.';
      else
        summary.textContent = r.gaps.length + (r.gaps.length === 1 ? ' readiness priority identified.' : ' readiness priorities identified.');
    }
    if (list) {
      list.innerHTML = '';
      r.gaps.forEach(function (gap) {
        var li = document.createElement('li');
        li.textContent = gap;
        list.appendChild(li);
      });
      var sites = numeric('sites');
      var unitsField = root.querySelector('[data-roi-input="units"]');
      var units = (unitsField && Number(unitsField.value) > 0) ? Number(unitsField.value) : sites;
      if (sites && r.answered === questions.length) {
        var li = document.createElement('li');
        li.textContent = 'Plan install and coverage for ' + units + (units === 1 ? ' SoberLive FRX unit' : ' SoberLive FRX units') + ' across ' + sites + (sites === 1 ? ' site.' : ' sites.');
        list.appendChild(li);
      }
    }
  }

  /* ── ROI calculation ───────────────────────────────────── *
   * Compares the current manual, supervised breath-testing process
   * (staff time + any outsourced provider fees) against an unattended
   * SoberLive FRX wall-mounted, facial-recognition program. Employees
   * and sites now drive the model directly: employees size the annual
   * test volume, sites size the number of FRX units required. */
  function compute() {
    var employees        = numeric('employees');
    var sites             = numeric('sites');
    var testsPerEmployee  = numeric('tests-per-employee');
    var manualMinutes     = numeric('manual-minutes');
    var hourlyRate        = numeric('hourly-rate');

    var usesOutsourced    = checked('outsourced');
    var outsourcedShare   = usesOutsourced ? Math.min(100, numeric('outsourced-share')) / 100 : 0;
    var testCost          = numeric('test-cost');
    var otherCost         = usesOutsourced ? numeric('other-cost') : 0;

    var unitsInput        = numeric('units');
    var units             = unitsInput > 0 ? unitsInput : sites;
    var unitCost          = numeric('unit-cost');
    var unitAnnualCost    = numeric('unit-annual-cost');
    var flaggedPct        = Math.min(100, numeric('flagged-pct')) / 100;
    var reviewMinutes     = numeric('review-minutes');

    var totalTests        = employees * testsPerEmployee;
    var outsourcedTests   = totalTests * outsourcedShare;
    var manualTests       = totalTests - outsourcedTests;

    var manualLabor       = manualTests * (manualMinutes / 60) * hourlyRate;
    var outsourcedCost    = usesOutsourced ? (outsourcedTests * testCost) + otherCost : 0;
    var currentCost       = manualLabor + outsourcedCost;

    var setupCost         = units * unitCost;
    var ongoingUnitCost   = units * unitAnnualCost;
    var reviewCost        = totalTests * flaggedPct * (reviewMinutes / 60) * hourlyRate;
    var ongoingProgramCost= ongoingUnitCost + reviewCost;
    var yearOneCost       = setupCost + ongoingProgramCost;

    var ongoingNet        = currentCost - ongoingProgramCost;
    var yearOneNet        = currentCost - yearOneCost;

    var roi;
    if (yearOneCost > 0)        roi = (yearOneNet / yearOneCost) * 100;
    else if (currentCost > 0)   roi = Infinity;
    else                        roi = null;

    var payback;
    if (setupCost === 0 && ongoingNet > 0) payback = 0;
    else if (ongoingNet > 0)               payback = setupCost / (ongoingNet / 12);
    else                                   payback = null;

    var threeYearNet = (currentCost * 3) - setupCost - (ongoingProgramCost * 3);

    return {
      totalTests: totalTests, units: units,
      manualLabor: manualLabor, outsourcedCost: outsourcedCost, currentCost: currentCost,
      setupCost: setupCost, ongoingProgramCost: ongoingProgramCost, yearOneCost: yearOneCost,
      yearOneNet: yearOneNet, ongoingNet: ongoingNet, roi: roi,
      payback: payback, threeYearNet: threeYearNet
    };
  }

  function updateResults() {
    updateReadiness();
    var c = compute();

    var totalTestsEl = root.querySelector('[data-roi-out="total-tests"]');
    if (totalTestsEl) totalTestsEl.textContent = Math.round(c.totalTests).toLocaleString('en-AU');

    setOutput('current-cost',  currency.format(c.currentCost));
    setOutput('manual-labor',  currency.format(c.manualLabor));
    setOutput('outsourced',    currency.format(c.outsourcedCost));
    setOutput('units-used',    Math.round(c.units).toLocaleString('en-AU'));
    setOutput('setup-cost',    currency.format(c.setupCost));
    setOutput('ongoing-cost',  currency.format(c.ongoingProgramCost));
    setOutput('year-one-net',  currency.format(c.yearOneNet),  c.yearOneNet < 0);
    setOutput('ongoing-net',   currency.format(c.ongoingNet),  c.ongoingNet < 0);

    var roiText;
    if (c.roi === null)        roiText = '—';
    else if (!isFinite(c.roi)) roiText = '∞';
    else                       roiText = Math.round(c.roi) + '%';
    setOutput('roi', roiText, isFinite(c.roi) && c.roi < 0);

    var paybackText;
    if (c.payback === null)    paybackText = 'Not recoverable from these inputs';
    else if (c.payback === 0)  paybackText = 'Immediate';
    else if (c.payback < 1)    paybackText = 'Under 1 month';
    else if (c.payback > 120)  paybackText = '10+ years';
    else                       paybackText = c.payback.toFixed(1) + ' months';
    setOutput('payback', paybackText);

    setOutput('three-year', currency.format(c.threeYearNet), c.threeYearNet < 0);

    /* Headline — the one ungated number. */
    var headlineEl = root.querySelector('[data-roi-out="headline"]');
    var headlineSubEl = root.querySelector('[data-roi-out="headline-sub"]');
    if (headlineEl) {
      headlineEl.textContent = currency.format(c.ongoingNet);
      headlineEl.classList.toggle('is-negative', c.ongoingNet < 0);
    }
    if (headlineSubEl) {
      headlineSubEl.textContent = c.totalTests > 0
        ? 'Based on ' + Math.round(c.totalTests).toLocaleString('en-AU') + ' tests a year across ' + c.units + (c.units === 1 ? ' unit.' : ' units.')
        : 'Enter your numbers to see an estimate.';
    }
  }

  /* ── Optional outsourced-cost sub-fields ───────────────── */
  var outsourcedToggle = root.querySelector('[data-roi-toggle="outsourced"]');
  var outsourcedFields = root.querySelector('[data-roi-subfields="outsourced"]');
  if (outsourcedToggle && outsourcedFields) {
    outsourcedToggle.addEventListener('change', function () {
      outsourcedFields.hidden = !outsourcedToggle.checked;
      updateResults();
    });
  }

  /* ── Units auto-suggested from sites, until the visitor overrides it ── */
  var sitesField = root.querySelector('[data-roi-input="sites"]');
  var unitsField = root.querySelector('[data-roi-input="units"]');
  if (sitesField && unitsField) {
    sitesField.addEventListener('input', function () {
      if (!unitsField.dataset.touched) unitsField.value = sitesField.value;
    });
    unitsField.addEventListener('input', function () { unitsField.dataset.touched = '1'; });
  }

  /* ── Lead-gated full breakdown ──────────────────────────── */
  var gate     = root.querySelector('[data-roi-gate]');
  var leadForm = root.querySelector('[data-roi-lead-form]');
  if (gate && leadForm) {
    var leadError = root.querySelector('[data-roi-lead-error]');
    leadForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var first = root.querySelector('[data-roi-lead="firstname"]');
      var email = root.querySelector('[data-roi-lead="email"]');
      var validEmail = email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value);
      if (!first || !first.value.trim() || !validEmail) {
        if (leadError) leadError.hidden = false;
        return;
      }
      if (leadError) leadError.hidden = true;

      var lead = {
        firstname: first.value.trim(),
        lastname: (root.querySelector('[data-roi-lead="lastname"]') || {}).value || '',
        email: email.value.trim(),
        phone: (root.querySelector('[data-roi-lead="phone"]') || {}).value || '',
        company: (root.querySelector('[data-roi-lead="company"]') || {}).value || ''
      };

      /* Reveal the breakdown immediately so the visitor isn't blocked on
         the network call. Fire a custom event with the lead + current
         results so this can be wired into HubSpot (portal/form IDs are
         theme settings below) or any other CRM without touching this
         calculation logic again. */
      var r = compute();
      gate.setAttribute('data-gate-state', 'unlocked');
      modal.dispatchEvent(new CustomEvent('at:roi-lead', {
        detail: { lead: lead, results: r }
      }));

      {%- if section.settings.hubspot_portal_id != blank and section.settings.hubspot_form_id != blank -%}
      /* Andatech uses one HubSpot form GUID across every CTA (Vivien's call).
         ROI-specific figures are transient per-submission facts, not stable
         attributes of the contact, so we deliberately do NOT write them to
         custom contact properties (those would overwrite on a returning
         visitor's next submission and clutter the record with calc noise).
         Instead we pack the inputs + results into the standard "message"
         field. Every HubSpot form has it, sales already reads it, and the
         submission timeline preserves each historical value per submission.
         The [ROI Calculator …] header at the top gives sales / workflows a
         reliable string to filter on inside the shared form. */
      function fmtMoney(n) {
        return currency.format(Math.round(Number(n) || 0));
      }
      function fmtNum(n) {
        return Math.round(Number(n) || 0).toLocaleString('en-AU');
      }
      function fmtPct(n) {
        return (Math.round(Number(n) || 0)) + '%';
      }
      var paybackLine;
      if (r.payback == null)      paybackLine = 'Not recoverable from these inputs';
      else if (r.payback === 0)   paybackLine = 'Immediate';
      else if (r.payback < 1)     paybackLine = 'Under 1 month';
      else if (r.payback > 120)   paybackLine = '10+ years';
      else                        paybackLine = r.payback.toFixed(1) + ' months';
      var roiLine;
      if (r.roi == null)          roiLine = '—';
      else if (!isFinite(r.roi))  roiLine = '∞';
      else                        roiLine = Math.round(r.roi) + '%';

      var messageLines = [
        '[ROI Calculator submission from andatech.com.au]',
        '',
        'Their inputs:',
        '• Employees to be tested: '     + fmtNum(numeric('employees')),
        '• Number of sites: '            + fmtNum(numeric('sites')),
        '• Tests per employee/year: '    + fmtNum(numeric('tests-per-employee')),
        '• Minutes per manual test: '    + fmtNum(numeric('manual-minutes')),
        '• Hourly staff cost: '          + fmtMoney(numeric('hourly-rate')),
        '• Uses outsourced provider: '   + (checked('outsourced') ? 'Yes' : 'No')
      ];
      if (checked('outsourced')) {
        messageLines.push('  – Outsourced share: '     + fmtPct(numeric('outsourced-share')));
        messageLines.push('  – Cost per outsourced test: ' + fmtMoney(numeric('test-cost')));
        messageLines.push('  – Annual callout / travel: ' + fmtMoney(numeric('other-cost')));
      }
      messageLines.push('• FRX unit cost (one-off): '  + fmtMoney(numeric('unit-cost')));
      messageLines.push('• FRX annual licence/unit: '  + fmtMoney(numeric('unit-annual-cost')));
      messageLines.push('');
      messageLines.push('Their computed results:');
      messageLines.push('• Indicative annual savings with SoberLive FRX: ' + fmtMoney(r.ongoingNet));
      messageLines.push('• Total tests per year: '     + fmtNum(r.totalTests));
      messageLines.push('• FRX units required: '       + fmtNum(r.units));
      messageLines.push('• Current annual testing cost: ' + fmtMoney(r.currentCost));
      messageLines.push('• One-off setup cost: '       + fmtMoney(r.setupCost));
      messageLines.push('• Ongoing annual program cost: ' + fmtMoney(r.ongoingProgramCost));
      messageLines.push('• Year-one net difference: '  + fmtMoney(r.yearOneNet));
      messageLines.push('• Year-one ROI: '             + roiLine);
      messageLines.push('• Payback period: '           + paybackLine);
      messageLines.push('• Projected 3-year cumulative value: ' + fmtMoney(r.threeYearNet));

      fetch('https://api.hsforms.com/submissions/v3/integration/submit/{{ section.settings.hubspot_portal_id }}/{{ section.settings.hubspot_form_id }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fields: [
            { name: 'firstname', value: lead.firstname },
            { name: 'lastname',  value: lead.lastname },
            { name: 'email',     value: lead.email },
            { name: 'phone',     value: lead.phone },
            { name: 'company',   value: lead.company },
            { name: 'message',   value: messageLines.join('\n') }
          ]
        })
      }).catch(function () { /* Breakdown already revealed; fail silently. */ });
      {%- endif -%}
    });
  }

  /* ── Step navigation ───────────────────────────────────── */
  function showStep(step, focus) {
    tabs.forEach(function (tab) {
      var active = tab.dataset.stepTab === String(step);
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    panels.forEach(function (panel) {
      var active = panel.dataset.stepPanel === String(step);
      panel.classList.toggle('is-active', active);
      panel.hidden = !active;
      if (active && focus) {
        panel.setAttribute('tabindex', '-1');
        panel.focus({ preventScroll: true });
      }
    });
    if (step === 2) updateResults();
    /* Scroll the modal body to the top */
    var body = modal.querySelector('.at-roi-modal__body');
    if (body) body.scrollTop = 0;
  }

  function continueToStep2() {
    var firstMissing = questions.find(function (q) {
      return !q.querySelector('.at-mcp-readiness__pill.is-active');
    });
    questions.forEach(function (q) {
      q.classList.toggle('is-error', q === firstMissing);
    });
    if (firstMissing) {
      if (validation) validation.hidden = false;
      var btn = firstMissing.querySelector('button');
      if (btn) btn.focus();
      return;
    }
    if (validation) validation.hidden = true;
    showStep(2, true);
  }

  /* ── Wire up readiness pills ───────────────────────────── */
  questions.forEach(function (q) {
    var pills = [].slice.call(q.querySelectorAll('.at-mcp-readiness__pill'));
    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        pills.forEach(function (p) {
          var on = p === pill;
          p.classList.toggle('is-active', on);
          p.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        q.classList.remove('is-error');
        if (validation && questions.every(function (item) {
          return item.querySelector('.at-mcp-readiness__pill.is-active');
        })) validation.hidden = true;
        updateReadiness();
      });
    });
  });

  /* ── Wire up tabs + nav buttons ────────────────────────── */
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      if (tab.dataset.stepTab === '2') continueToStep2();
      else showStep(1, false);
    });
  });
  if (nextBtn) nextBtn.addEventListener('click', continueToStep2);
  if (backBtn) backBtn.addEventListener('click', function () { showStep(1, true); });

  /* ── Wire up form inputs for live recalculation ────────── */
  [].slice.call(root.querySelectorAll('[data-roi-input]')).forEach(
    function (input) { input.addEventListener('input', updateResults); }
  );

  updateReadiness();
  updateResults();
})();
</script>

