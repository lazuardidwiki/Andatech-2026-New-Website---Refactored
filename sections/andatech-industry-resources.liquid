{%- comment -%} Andatech — Industry resources carousel.
  Supports optional pill-shape category filters above the card track.
  Each card can be configured as Download (existing) or Link (circular arrow).
{%- endcomment -%}
{{ 'andatech-site.css' | asset_url | stylesheet_tag }}
{{ 'andatech-industry.css' | asset_url | stylesheet_tag }}

<style>
  #{{ section.settings.anchor_id | default: section.id | handleize }} .at-resource-track {
    --at-resource-edge-gutter: 24px;
    margin-inline: calc(var(--at-resource-edge-gutter) * -1);
    padding-inline: var(--at-resource-edge-gutter);
    scroll-padding-inline: var(--at-resource-edge-gutter);
  }

  #{{ section.settings.anchor_id | default: section.id | handleize }} .at-resource-card[hidden] {
    display: none;
  }

  @media (max-width: 767px) {
    #{{ section.settings.anchor_id | default: section.id | handleize }} .at-resource-track {
      --at-resource-edge-gutter: var(--at-gutter);
      margin-inline: calc(var(--at-resource-edge-gutter) * -1);
    }
  }
</style>

{%- liquid
  assign has_filters = false
  assign filter_tags = ''
  for block in section.blocks
    if block.settings.filter_tag != blank
      assign has_filters = true
      assign filter_tags = filter_tags | append: block.settings.filter_tag | append: '|||'
    endif
  endfor
-%}

{%- if has_filters -%}
<style>
  .at-resource-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .at-resource-filter {
    padding: 10px 24px; border-radius: var(--at-r-pill, 100px);
    border: 1px solid #DDE0E3; background: transparent;
    font-family: 'Titillium Web', sans-serif; font-size: 14px; font-weight: 600;
    color: var(--at-body-color, #495563); cursor: pointer; transition: all .2s ease;
  }
  .at-resource-filter.is-active,
  .at-resource-filter:hover {
    background: var(--at-navy, #1F2937); color: #fff; border-color: var(--at-navy, #1F2937);
  }
  @media (max-width: 767px) {
    .at-resource-filters {
      display: grid;
      grid-template-columns: minmax(72px, .28fr) minmax(0, 1fr);
      gap: 8px;
      overflow: visible;
      padding-bottom: 0;
    }
    .at-resource-filter {
      width: 100%;
      min-width: 0;
      padding-inline: 14px;
      white-space: normal;
    }
    .at-resource-filter:nth-child(3):last-child { grid-column: 1 / -1; }
  }
</style>
{%- endif -%}

<section class="at-industry at-industry-resources" id="{{ section.settings.anchor_id | default: section.id | handleize }}">
  <div class="at-shell">
    <div class="at-industry-resources__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="at-industry__eyebrow" data-at-rise>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="at-industry__title" data-at-rise>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.desc != blank -%}<div class="at-industry__desc" data-at-rise>{{ section.settings.desc }}</div>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}<a class="at-industry-resources__all" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label | escape }} <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 8 16 16M16 16V9.8M16 16H9.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{%- endif -%}
    </div>

    {%- if has_filters -%}
      <div class="at-resource-filters" role="group" aria-label="Filter resources" data-at-resource-filters data-at-rise>
        <button class="at-resource-filter is-active" type="button" aria-pressed="true" data-filter="all">All</button>
        {%- assign unique_tags = '' -%}
        {%- assign tag_arr = filter_tags | split: '|||' -%}
        {%- for tag in tag_arr -%}
          {%- assign tag_stripped = tag | strip -%}
          {%- if tag_stripped != blank -%}
            {%- unless unique_tags contains tag_stripped -%}
              <button class="at-resource-filter" type="button" aria-pressed="false" data-filter="{{ tag_stripped | handleize }}">{{ tag_stripped | escape }}</button>
              {%- if unique_tags != blank -%}{%- assign unique_tags = unique_tags | append: '|||' | append: tag_stripped -%}{%- else -%}{%- assign unique_tags = tag_stripped -%}{%- endif -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="at-resource-track" data-at-resource-track>
      {%- for block in section.blocks -%}
        {%- assign card_filter = block.settings.filter_tag | handleize -%}
        {%- assign card_cta_type = block.settings.cta_type | default: 'download' -%}
        <a class="at-resource-card" href="{{ block.settings.url | default: '#' }}"{% if block.settings.filter_tag != blank %} data-filter-tag="{{ card_filter }}"{% endif %}{% if card_cta_type == 'link' %} target="_blank" rel="noopener"{% endif %} data-at-rise {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or block.settings.badge != blank -%}<div class="at-resource-card__media">
            {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy">{%- endif -%}
            {%- if block.settings.badge != blank -%}<span class="at-resource-card__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
          </div>{%- endif -%}
          <div class="at-resource-card__body">
            {%- if block.settings.category != blank -%}<p>{{ block.settings.category | escape }}</p>{%- endif -%}
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.desc != blank -%}<div>{{ block.settings.desc }}</div>{%- endif -%}
            <span class="at-resource-card__meta">{{ block.settings.read_time | escape }}
              {%- if card_cta_type == 'link' -%}
                <svg class="at-resource-card__link-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- else -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M5 20h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endif -%}
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
    <div class="at-resource-controls" data-at-resource-controls>
      <div class="at-resource-controls__dots" data-at-resource-dots aria-hidden="true"></div>
      <div>
        <button type="button" aria-label="Previous resource" data-at-resource-prev>←</button>
        <button type="button" aria-label="Next resource" data-at-resource-next>→</button>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('{{ section.settings.anchor_id | default: section.id | handleize }}');
  if (!root || root.dataset.carouselReady) return;
  root.dataset.carouselReady = 'true';
  var track = root.querySelector('[data-at-resource-track]');
  var cards = Array.prototype.slice.call(track.querySelectorAll('.at-resource-card'));
  var dots = root.querySelector('[data-at-resource-dots]');
  if (!cards.length) return;
  cards.forEach(function (_, index) { var dot = document.createElement('span'); if (!index) dot.className = 'is-active'; dots.appendChild(dot); });
  var update = function () { var cardWidth = cards[0].getBoundingClientRect().width || 1; var index = Math.round(track.scrollLeft / cardWidth); Array.prototype.forEach.call(dots.children, function (dot, i) { dot.classList.toggle('is-active', i === index); }); };
  var visibleCards = function () { return cards.filter(function (card) { return !card.hidden; }); };
  root.querySelector('[data-at-resource-prev]').addEventListener('click', function () { var visible = visibleCards(); if (visible.length) track.scrollBy({ left: -visible[0].getBoundingClientRect().width - 16, behavior: 'smooth' }); });
  root.querySelector('[data-at-resource-next]').addEventListener('click', function () { var visible = visibleCards(); if (visible.length) track.scrollBy({ left: visible[0].getBoundingClientRect().width + 16, behavior: 'smooth' }); });
  track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });

  /* Category filter interaction */
  var filters = root.querySelector('[data-at-resource-filters]');
  if (filters) {
    var filterBtns = Array.prototype.slice.call(filters.querySelectorAll('.at-resource-filter'));
    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBtns.forEach(function (b) { b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false'); });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
        var tag = btn.getAttribute('data-filter');
        cards.forEach(function (card) {
          if (tag === 'all' || card.getAttribute('data-filter-tag') === tag) {
            card.hidden = false;
          } else {
            card.hidden = true;
          }
        });
        track.scrollTo({ left: 0 });
        /* Rebuild dots for visible cards */
        var visible = visibleCards();
        dots.innerHTML = '';
        visible.forEach(function (_, i) { var d = document.createElement('span'); if (!i) d.className = 'is-active'; dots.appendChild(d); });
      });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Industry Resources",
  "tag": "section",
  "class": "at-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor", "info": "Used by the industry topic navigation. Leave unchanged unless the matching navigation link is updated.", "default": "industry-resources" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Knowledge Centre" },
    { "type": "text", "id": "heading", "label": "H2 — Heading", "default": "Resources" },
    { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Use practical guides and industry insights to strengthen policies, testing procedures and supervisor readiness.</p>" },
    { "type": "text", "id": "link_label", "label": "View all label", "default": "View Knowledge Centre" },
    { "type": "url", "id": "link_url", "label": "View all link" }
  ],
  "blocks": [{ "type": "resource", "name": "Resource", "limit": 12, "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "badge", "label": "Badge" },
    { "type": "text", "id": "category", "label": "Category", "default": "Guide" },
    { "type": "text", "id": "title", "label": "Title", "default": "Mining Drug & Alcohol Policy" },
    { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Review the policy areas that support consistent testing decisions across mining operations.</p>" },
    { "type": "text", "id": "read_time", "label": "Read time", "default": "12 mins read" },
    { "type": "url", "id": "url", "label": "Link" },
    { "type": "text", "id": "filter_tag", "label": "Filter tag", "info": "Optional. Assigns this card to a pill filter category (e.g. 'Primary & Regulatory Sources'). Leave blank if no filtering is needed — existing cards without a tag still display normally." },
    { "type": "select", "id": "cta_type", "label": "CTA type", "options": [
      { "value": "download", "label": "Download" },
      { "value": "link", "label": "Link (arrow)" }
    ], "default": "download", "info": "Download shows the down-arrow icon. Link shows a diagonal arrow and opens in a new tab." }
  ] }],
  "presets": [{ "name": "Industry Resources", "blocks": [
    { "type": "resource", "settings": { "badge": "Most Popular", "title": "Mining Drug & Alcohol Policy", "desc": "<p>Review the policy areas that support consistent testing decisions across mining operations.</p>" } },
    { "type": "resource", "settings": { "title": "Contractor Testing Guide", "desc": "<p>Plan how testing expectations apply to contractors, subcontractors and labour-hire workers.</p>" } },
    { "type": "resource", "settings": { "title": "Supervisor Toolkit", "desc": "<p>Give frontline leaders practical guidance for applying the workplace procedure.</p>" } },
    { "type": "resource", "settings": { "title": "Site Risk Assessment", "desc": "<p>Identify the roles, locations and operating conditions that should inform the program.</p>" } }
  ] }]
}
{% endschema %}
