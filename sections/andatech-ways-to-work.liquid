{%- comment -%} Andatech — Ways to work with us. Generated from the Phase 1 prototype.
  Classes are `at-` prefixed; styling lives in andatech-site.css. {%- endcomment -%}

{{ 'andatech-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'andatech-homepage.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.layout == 'ownership' -%}{{ 'andatech-solutions-pages.css' | asset_url | stylesheet_tag }}{%- endif -%}

<section class="at-pricing{% if section.settings.layout == 'ownership' %} at-pricing--ownership{% endif %}">
  <div class="at-shell">
    {%- assign eyebrow_tag = section.settings.eyebrow_tag | default: 'h2' -%}
    {%- assign heading_tag = section.settings.heading_tag | default: 'h3' -%}
    {%- if section.settings.eyebrow != blank -%}<{{ eyebrow_tag }} class="at-pricing__eyebrow" data-at-rise>{{ section.settings.eyebrow | escape }}</{{ eyebrow_tag }}>{%- endif -%}
    <{{ heading_tag }} class="at-pricing__title" data-at-rise>{{ section.settings.heading | escape }}{% if section.settings.heading_bold != blank %}<br><strong>{{ section.settings.heading_bold | escape }}</strong>{% endif %}</{{ heading_tag }}>
    {%- if section.settings.desc != blank -%}<div class="at-pricing__desc" data-at-rise>{{ section.settings.desc }}</div>{%- endif -%}

    <div class="at-pricing__grid" data-at-carousel="plans-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="at-pricing__card{% if forloop.first %} at-pricing__card--featured{% endif %}" data-at-rise {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}<span class="at-pricing__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
          {%- assign title_tag = block.settings.title_tag | default: 'h4' -%}
          <{{ title_tag }} class="at-pricing__card-title">{{ block.settings.title | escape }}</{{ title_tag }}>
          {%- if block.settings.sub != blank -%}<p class="at-pricing__card-sub">{{ block.settings.sub | escape }}</p>{%- endif -%}
          <ul class="at-pricing__list">
            {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
            {%- for item in items -%}
              {%- assign line = item | strip -%}
              {%- if line != blank -%}<li><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="m8.5 12 2.4 2.4 4.6-4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ line | escape }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if block.settings.cta_label != blank -%}
            {%- if forloop.first -%}
              <a class="at-btn at-btn--green" href="{{ block.settings.cta_url | default: '#' }}">{{ block.settings.cta_label | escape }} <i class="at-btn__arrow" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="m10 5.5 6.5 6.5-6.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></i></a>
            {%- else -%}
              <a class="at-btn at-btn--outline-light" href="{{ block.settings.cta_url | default: '#' }}"{% if block.settings.cta_label contains 'Find Your Device' %} data-at-device-open{% endif %}>{{ block.settings.cta_label | escape }}</a>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="at-dots at-pricing__dots" data-at-dots="plans-{{ section.id }}"></div>

    {%- if section.settings.mobile_cta != blank -%}
      <div class="at-mobile-cta"><a class="at-btn at-btn--outline-dark at-btn--mobile-only" href="{{ section.settings.mobile_cta_url | default: '#' }}">{{ section.settings.mobile_cta | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Andatech Ways To Work", "tag": "section", "class": "at-section",
  "settings": [
    { "type": "select", "id": "layout", "label": "Card layout", "options": [{ "value": "pricing", "label": "Ways to work" }, { "value": "ownership", "label": "Two-card ownership" }], "default": "pricing" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ways to work with us" },
    { "type": "select", "id": "eyebrow_tag", "label": "Eyebrow HTML Tag", "options": [
      { "value": "p",  "label": "Paragraph (p)" },
      { "value": "h1", "label": "Heading 1 (h1)" },
      { "value": "h2", "label": "Heading 2 (h2)" },
      { "value": "h3", "label": "Heading 3 (h3)" },
      { "value": "h4", "label": "Heading 4 (h4)" },
      { "value": "h5", "label": "Heading 5 (h5)" },
      { "value": "h6", "label": "Heading 6 (h6)" }
    ], "default": "h2" },
    { "type": "text", "id": "heading", "label": "Heading (light)", "default": "Own the equipment," },
    { "type": "select", "id": "heading_tag", "label": "Heading HTML Tag", "options": [
      { "value": "p",  "label": "Paragraph (p)" },
      { "value": "h1", "label": "Heading 1 (h1)" },
      { "value": "h2", "label": "Heading 2 (h2)" },
      { "value": "h3", "label": "Heading 3 (h3)" },
      { "value": "h4", "label": "Heading 4 (h4)" },
      { "value": "h5", "label": "Heading 5 (h5)" },
      { "value": "h6", "label": "Heading 6 (h6)" }
    ], "default": "h3" },
    { "type": "text", "id": "heading_bold", "label": "Heading (bold)", "default": "or hand us the whole thing" },
    { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Same devices, same accreditation, same support. The difference is how much of it you want to run yourself.</p>" },
    { "type": "text", "id": "mobile_cta", "label": "Mobile button label", "default": "View All Programs" },
    { "type": "url", "id": "mobile_cta_url", "label": "Mobile button link" } ],
  "blocks": [ { "type": "plan", "name": "Plan", "limit": 4, "settings": [
      { "type": "paragraph", "content": "The first plan is the featured card — teal gradient, taller, green button. Reorder blocks to change which one it is." },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "select", "id": "title_tag", "label": "Title HTML Tag", "options": [
        { "value": "p",  "label": "Paragraph (p)" },
        { "value": "h1", "label": "Heading 1 (h1)" },
        { "value": "h2", "label": "Heading 2 (h2)" },
        { "value": "h3", "label": "Heading 3 (h3)" },
        { "value": "h4", "label": "Heading 4 (h4)" },
        { "value": "h5", "label": "Heading 5 (h5)" },
        { "value": "h6", "label": "Heading 6 (h6)" }
      ], "default": "h4" },
      { "type": "text", "id": "sub", "label": "Subtitle", "info": "Rendered italic." },
      { "type": "text", "id": "badge", "label": "Badge", "info": "Featured card only, e.g. Most chosen." },
      { "type": "textarea", "id": "items", "label": "Checklist", "info": "One item per line." },
      { "type": "text", "id": "cta_label", "label": "Button label" },
      { "type": "url", "id": "cta_url", "label": "Button link" } ] } ],
  "presets": [ { "name": "Andatech Ways To Work", "blocks": [
    { "type": "plan", "settings": { "title": "Fully managed", "sub": "We run the program", "badge": "Most chosen", "cta_label": "Explore Managed Programs", "items": "Devices included, no capital outlay\nCalibration scheduled and tracked\nConsumables replenished automatically\nTraining and audit documentation included\nReplacement units while yours are serviced" } },
    { "type": "plan", "settings": { "title": "One-time purchase", "sub": "You run the program", "cta_label": "Find Your Device", "items": "Buy devices outright\nCalibration booked as needed\nConsumables ordered when you need them\nTraining available on request" } },
    { "type": "plan", "settings": { "title": "Lease", "sub": "Fixed monthly, no capital", "cta_label": "Talk With Us About Leasing", "items": "Spread the cost across the term\nCalibration included\nUpgrade as your fleet changes\nAdd sites without re-procuring" } } ] } ] }
{% endschema %}
